# Guard against sourcing.
[[ "${BASH_SOURCE[0]}" == "$0" ]] || return 1

shopt -s extglob # Allow parsing of extended globbing syntax
[[ ${1:-} == trace ]] && shopt -s extdebug # Enable precise and absolute LINENO

doit() {
  if [ -z "$BASH_VERSION" ]; then
    echo "ERROR: This script requires Bash. Please run with 'wgc'." >&2
    exit 1
  fi
  if ((BASH_VERSINFO[0] < 4)) || ((BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4)); then
    echo "ERROR: Bash 4.4 or newer is required (found $BASH_VERSION)." >&2
    exit 1
  fi

  # Sanitized auto-elevation
  local safesudo
  safesudo=$(command -p -v sudo) || { echo "ERROR: sudo not found in standard paths." >&2; exit 1; }
  if [[ ! $UID == 0 ]]; then
    exec $safesudo WGC_CFGDIR="$WGC_CFGDIR" WGC_AUTH="$WGC_AUTH" BASH_ENV= ENV= CDPATH= IFS= "$0" "$@"
  fi
  # unset fails when readonly, so use exec env -i
  [[ ${BASH_ENV:-}${ENV:-}${CDPATH:-} ]] && \
    exec /usr/bin/env -u BASH_ENV -u ENV -u CDPATH "$0" "$@"

  export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

  # Shell state baseline
  set +abefhkmnptuBCEHPT
  shopt -u $(shopt | awk '/[[:space:]]on$/{print $1}')
  # What I want
  set +o posix       # Turn off Posix standard
  set -o hashall     # Remember the location of commands as they are looked up.
  set -o braceexpand # Perform brace expansion.
  set -o nounset     # Treat unset variables as an error.
  set -o pipefail    # Return value of a pipeline is the status of the last command to exit with a non-zero status.
  set -o noglob      # Disable globbing (enable it later temporarily if needed)
  set +o errexit     # Don't exit immediately if a command exits with a non-zero status. Rely to trap ERR instead.
  set -o errtrace    # Trap ERR is inherited by functions, command substitutions and subshells.
  shopt -s extglob   # Enable extended glob patterns: x(y)
  shopt -s nullglob  # Patterns which match no files expand to a null string
  shopt -s checkwinsize extquote
  export LC_ALL=C LANG=C
  local IFS=$' \t\n'

  set_markers

  trap 'at_exit' EXIT
  trap 'error TRAP-ERR' ERR
  trap 'error TRAP-INT' INT
  trap 'error TRAP-TERM' TERM

  [[ ${1:-} == trace ]] && { shift 1; trace_on; }

  readonly CMD=${1:-} VPN=${2:-}
  readonly DEV=wgc_${VPN:-}
  readonly NAMESPACE=$DEV

  set_cfgdir

  case "$CMD" in
    up|fup|bup?(d)|nup)
      start_vpn
      ;;
    down|kill)
      stop_vpn
      ;;
    state)
      show_state bridges
      ;;
    act)
      show_active_vpns
      ;;
    list)
      list_config_files
      ;;
    conf)
      show_config_file
      ;;
    parse)
      show_parsed_config_file
      ;;
    req)
      check_dependencies
      ;;
    exec)
      exec_in_namespace "${@:3}"
      ;;
    completion)
      enable_completion
      ;;
    openresolv)
      install_forced_openresolv
      ;;
    remopenresolv)
      remove_openresolv
      ;;
    null)
      :
      ;;
    f)
      assert_auth
      "${@:2}"
      ;;
    *)
      show_usage
      ;;
  esac

  exit 0
}

show_usage() {
  local a= b= c= n=
  if [[ $HAS_COLORS ]]; then
    a=${COLORS[G]}
    b=${COLORS[R]}
    c=${COLORS[y]}
    n=$'\e[0m'
  fi
  local usage
  read -r -d '' usage <<EOF || true
${a}Usage:${n}
  wgc <command> [<vpn>]
  wgc exec <vpn> <cmd> [args...]

${a}Core Commands:${n}
  ${b}up${n} <vpn>   - Start VPN in ${c}Standard mode${n}.
               Adds routes defined in AllowedIPs, applying special handling
               for 0.0.0.0/0 to prevent loops.  Effect: Automatically handles
               ${c}Split Tunnel${n} or ${c}Full Tunnel${n} based on configuration file.
               Operation is similar to 'wg-quick'. See manual for details.
  ${b}fup${n} <vpn>  - Start VPN in ${c}Full Tunnel${n} mode.
               Directs ALL traffic through the VPN tunnel.
               Useful for untrusted networks/public Wi-Fi.
               Equivalent to 'up', but forces AllowedIPs=0.0.0.0/0.
  ${b}bup${n} <vpn>  - Start VPN in ${c}Bind-Only${n} mode.
               VPN is accessible, but no traffic is routed automatically because
               neither system routing tables nor DNS settings are modified.
               Traffic enters the tunnel if and only if it is explicitly bound
               to the VPN interface or its IP address.
  ${b}bupd${n} <vpn> - Start VPN in ${c}Bind-Only mode with DNS${n}.
               Like 'bup', but enforces VPN DNS settings system-wide like 'up' does.
               Routes are added only for the nameservers to ensure reachability.
               Data traffic still requires explicit binding, but DNS resolution
               is performed via the VPN tunnel for the entire system.
  ${b}nup${n} <vpn>  - Start VPN in ${c}Namespace${n} mode.
               The VPN operates in a dedicated Network Namespace (isolated stack)
               named ${c}wgc_<vpn>${n}.
               ALL traffic in the namespace sandbox is directed through the VPN
               tunnel via default route.  The rest of the system is unaffected.
               Applications must be launched via '${c}wgc exec${n}'.
               Supports TCP ${c}port forwarding${n} (via <vpn>.conf) to expose namespace
               services to the host.
  ${b}down${n} <vpn> - Stop the VPN and revert network state (routes, DNS, namespace).
  ${b}kill${n} <vpn> - Like 'down'. Also ${c}kills${n} any process running in VPN namespace.

${a}Inspection & Utils:${n}
  ${b}state${n} <vpn> - Show detailed state of a specific VPN.
  ${b}act${n}         - List only active VPN interfaces.
  ${b}list${n}        - List all available config files.
  ${b}conf${n} <vpn>  - Display the content of <vpn>.conf.
  ${b}parse${n} <vpn> - Check syntax and show parsed parameters for <vpn>.conf.
  ${b}req${n}         - Verify that required dependencies are installed.

${a}Execution:${n}
  ${b}exec${n} <vpn> - Run a command inside the VPN Network Namespace.
               Only valid if VPN was started with 'nup'.
               Example, run 'curl ipinfo.io' in 'office' VPN namespace:
                 ${c}wgc exec office curl ipinfo.io${n}

${a}Configuration:${n}
  <vpn> must match a file in \$WGC_CFGDIR (Default: /etc/wireguard).
  Example: 'office' matches '/etc/wireguard/office.conf'.
  Export ${c}WGC_CFGDIR${n} to override the default configuration directory.

${a}Bash Completion:${n}
  To enable bash completion: ${c}wgc completion${n}
EOF
printf "\n%s\n\n" "$usage"
}

has_auth() {
  [[ $(sha512sum <<< "${WGC_AUTH:-}") == 3bb5692159057f407e9dca8f255e8eef* ]]
}

assert_auth() {
  has_auth || error "Bad password in WGC_AUTH." fatal
}

trace_on() {
  assert_auth
  local IFS=$' \t\n' # This function could be called in a context where IFS is unexpected
  declare -g TRACE_FD= TRACE_FILE=$(mktemp /dev/shm/wgc_trace_XX"XX"XX)
  declare -gi __tr_last=0 __tr_now=0 __tr_delta=0
  PS4='#+$((__tr_now=${EPOCHREALTIME/./},__tr_delta=__tr_now-__tr_last,__tr_last=__tr_now,__tr_delta))'
  PS4+=':${LINENO}:${FUNCNAME[0]}\n\011$BASH_COMMAND\n\011'
  shopt -s promptvars
  exec {TRACE_FD}>$TRACE_FILE
  BASH_XTRACEFD=$TRACE_FD
  __tr_last=${EPOCHREALTIME/./}
  echo -e '#!/bin/bash\n# vim: ft=sh wrap breakindent' >&${TRACE_FD}
  set -x
}

trace_off() {
  set +x
  [[ -v TRACE_FD ]] || return 0
  local IFS=$' \t\n' # This function could be called in a context where IFS is unexpected
  exec {TRACE_FD}>&-
  unset BASH_XTRACEFD
  local dump=/tmp/${TRACE_FILE##*/}
  cp $TRACE_FILE $dump && rm -f $TRACE_FILE
  [[ ${SUDO_UID:-} ]] && chown ${SUDO_UID}:${SUDO_GID:-$SUDO_UID} $dump
  TRACE_FD= TRACE_FILE=
  echo "TRACE: view $dump"
}

at_exit() {
  local exit_code=$? last_cmd=$BASH_COMMAND IFS=$' \t\n'
  cleanup_stack_unwind
  release_all_locks
  trace_off
  (( exit_code > 0 )) && [[ ! ${ERROR_HANDLED:-} ]] && error CRASH exit_code="$exit_code" command="$last_cmd"
  exit $exit_code
}

cleanup_stack_unwind() {
  [[ -v CLEANUP_STACK ]] || return 0
  local k=
  for (( k=${#CLEANUP_STACK[@]}-1; k>=0; k-- )); do
    local clean_func=${CLEANUP_STACK[$k]}
    if declare -F "$clean_func" >/dev/null; then
      echo "  [$k] Calling: $clean_func" >&2
      "$clean_func" || echo "      (Warning: '$clean_func' failed, continuing...)" >&2
    else
      echo "  [$k] Error: Function '$clean_func' not defined" >&2
    fi
  done
}

acquire_lock() {
  declare -gA LOCKS
  local id=$1 msg=$2
  local lock_file="/var/run/wgc.${id}.lock" fd

  exec {fd}>"$lock_file" #> Cannot create lock file: $lock_file
  if ! flock -n $fd; then
    exec {fd}>&-
    error "Another wgc instance is $msg. Try again in a moment." fatal blameparent
  fi
  LOCKS[$id]=$fd
  return 0
}

release_all_locks() {
  [[ -v LOCKS ]] || return 0
  local id fd
  for id in "${!LOCKS[@]}"; do
    fd=${LOCKS[$id]}
    flock -u $fd 2>/dev/null || true
    exec {fd}>&- || true
  done
  unset LOCKS
}

# The lack of a ternary operator in Bash prompted me to create an improved version.
# Implements an inline switch/case logic, inspired by Oracle SQL's DECODE function.
# Unlike a standard map, comparison keys are treated as Bash glob/extglob patterns.
#
# Usage:
#   $(decode <input> <pattern1> <result1> <pattern2> <result2> ... [<default>])
#
# Matches <input> against a series of patterns, printing the result of the first match.
# If no matches are found, prints the last argument (if any).
# Always returns 0 (success) as exit code.
decode() {
  local val=$1; shift
  while (( $# >= 2 )); do
    # $1 is a glob/extglob pattern
    [[ $val == $1 ]] && { printf '%s\n' "$2"; return 0; }
    shift 2
  done
  # If a single arg remains, it's the default result
  (( $# > 0 )) && printf '%s\n' "$1"
  return 0
}

# Minimalist argument parser helper.
# Maps arguments of the form 'name=value' to readonly local variables prefixed with 'p_'.
#
# Usage Protocol:
# 1. Consume and shift out all initial fixed positional arguments.
# 2. Define default values for optional parameters as local variables with 'p_' prefix.
# 3. Execute: eval "$(get_params "$@")" to parse and overwrite defaults.
#
# Argument Syntax:
# - name=value  -> Sets p_name to "value".
# - name        -> Sets p_name to "name" (Flag mode, equivalent to name=name).
# - 2=value     -> Sets p_2 to "value"
#
# Constraints & Responsibilities:
# 1. Caller: Must ensure passed argument keys are valid Bash identifiers (alphanumeric/underscore)
#    to avoid explicit errors.
# 2. Function Implementation: Must NOT use local variables starting with 'p_' for internal logic,
#    as this namespace is reserved for the generated parameters.
#
# Example:
#   func() {
#     arg1=$1; shift 1               # Consume and remove fixed positional arguments if any
#     local p_timeout=10 p_verbose=  # Define defaults (mutable)
#     eval "$(get_params "$@")"      # Parse arguments, override defaults and lock variables (readonly)
#     echo "Timeout: $p_timeout"
#     [[ $p_verbose ]] && echo "First argument was: $arg1"
#   }
#   func 123 timeout=30 verbose
#
get_params() {
  (( $# )) || return 0
  local arg key buf= IFS=$' \t\n'
  local -i n=1
  for arg; do
    key=${arg%%=*}
    [[ $key == +([a-zA-Z0-9_]) ]] || { echo "error \"Invalid identifier ${key@Q} in get_params\" fatal"; exit; }
    buf+=" p_$key=\${$n#*=}"
    ((n++))
  done
  echo "${buf:+local -r}$buf"
}

split_string() {
  local -n _output_arr=$1
  local _input=$2 _delim=${3-,}
  local IFS=$_delim
  _output_arr=( $_input )
}

split_string_strict() {
  local -n _output_arr=$1
  local _input=$2 _delim=${3-,}
  _output_arr=()
  [[ $_input ]] || return 0
  mapfile -d "$_delim" -t _output_arr <<< "$_input"
  _output_arr[-1]=${_output_arr[-1]%$'\n'}
}

set_markers() {
  declare -g W=$'\u2717' X=$'\u274C' Y=$'\u2713' HAS_COLORS=
  declare -gA COLORS
  # Detect if terminal supports colors
  if [[ -t 1 ]] && (($(tput colors 2>/dev/null || echo 0) >= 8)); then
    Y=$'\e[1;32m'$Y$'\e[m' # green CHECK MARK
    X=$'\e[1;31m'$X$'\e[m' # red CROSS MARK
    W=$'\e[1;31m'$W$'\e[m' # red BALLOT X
    HAS_COLORS=1
  fi
  # colors
  # 0:Black(Ash), 1:Red, 2:Green, 3:Yellow, 4:Blue, 5:Magenta, 6:Cyan, 7:White
  local chars=argybmcw i k
  for ((i=0; i<8; i++)); do
    k=${chars:i:1}
    COLORS[$k]=$'\e[0;3'$i'm'    # Lowercase: Normal
    COLORS[${k^}]=$'\e[1;3'$i'm' # Uppercase: Bold/Bright
  done
  COLORS[/]=$'\e[m'
  readonly W X Y HAS_COLORS COLORS
}

# prc - Print with color - A wrapper around printf
# Usage: prc [FORMAT] [ARGS...]
#
# If +x is one of +[ARGYBMCWargybmcw/], color is applied as follows:
#   Bright color: A:gray R:red G:green Y:yellow B:blue M:magenta C:cyan W:white
#   Normal color: a      r     g       y        b      m         c      w
#   Reset color: /
# COLORS array maps letters to ANSI color codes.
#
# FORMAT: printf-style format string (default: %s) plus +x syntax.
#
# In short, it works exactly as printf, with these exceptions:
# - In addition to %x format characters it recognizes +x format codes.
# - If x in +x is not a color code, it results in x (e.g. ++ == +).
# - If FORMAT is empty, format %s is assumed.
# - If there is only arg $1, it is printed literally (no orphaned format specifiers).
#
# Examples:
#   prc "+R%s+/\n" "Error: 234"    # prints "Error: 234" in Bright Red + newline
#   prc "+RError: %d+/\n" 234      # equivalent
#   prc +R%s+/ "Error: 234"        # prints "Error: 234" in Bright Red
#   prc +R%s%d+/ "Error: " 0xEA    # equivalent
#   prc "+R%s +Y%d+/" "Error:" 234 # prints a red "Error: " followed by a yellow 234
#   prc +g%s+/ Success             # prints "Success" in Normal Green
#   prc "+gSuccess+/"              # prints "+gSuccess+/" without ANSI color codes
#   prc "%dSuccess"                # prints "%dSuccess"
#   prc "%d files\n" 42            # prints "42 files" with no color + newline
#
prc() {
  local fmt=$1 l r k

  if (( $# > 1 )); then
    fmt=$fmt+ # fmt is indeed a format, append sentinel character
    while : ; do
      k=${fmt%%+*}   # k = anything before +
      r=${fmt#"$k+"} # r = anything after +
      l+=$k
      [[ $r ]] || break
      k=${COLORS[${r:0:1}]:-}
      if [[ $k ]]; then
        # char after + is a color code and $k is the corresponding ANSI code
        l+=${HAS_COLORS:+$k}
      else
        # +x where x is not a color code means x (++ is about the only real-world case)
        l+=${r:0:1}
      fi
      fmt=${r:1} # consider remaining fmt
    done
    l=${l:-%s}
    shift # adjust "$@"
  else
    # fmt is a message -> set default format
    l=%s
  fi

  printf "$l" "$@"
}

set_cfgdir() {
  declare -g CFGDIR=${WGC_CFGDIR:-/etc/wireguard}
  readonly CFGDIR
  # Validate directory
  [[ $CFGDIR == /* ]] #> WGC_CFGDIR must be an absolute path: $CFGDIR
  [[ ! -L "$CFGDIR" ]] #> Symlink not allowed '$CFGDIR'. Check WGC_CFGDIR.
  [[ -d "$CFGDIR" ]] #> Directory '$CFGDIR' not found. Check WGC_CFGDIR.
  local status=$(stat -c '%U%A' "$CFGDIR" 2>/dev/null)
  [[ $status ]] #> Could not read status of directory '$CFGDIR'. Access to metadata denied or restricted.
  [[ $status == rootd* ]] #> Security: $CFGDIR must be a root-owned directory.
  [[ ${status:9:1} != w && ${status:12:1} != w ]]
    #> Security: '$CFGDIR' is writable by non-root users (perms: ${status:4}). Revoke 'w' bits.
  ls "$CFGDIR" &>/dev/null
    #> Cannot access configuration directory: $CFGDIR %%
    #> Possible causes: SELinux, AppArmor, or mount restrictions. %%
    #> Debug: sudo ls -ldZ '$CFGDIR' && sudo getenforce
  [[ -f "$CFGDIR/wgc_enable" ]] #> Security: Approval file 'wgc_enable' missing in $CFGDIR. Root must create it.
  [[ ${status:11:1} == r ]]
    #w Add 'r' bit for others to '$CFGDIR' (chmod o+r, current perms: ${status:4}) to enable full command completion.
  return 0
}

start_vpn() {
  assert_no_namespace; validate_vpn_name
  acquire_lock vpn_$VPN "operating on VPN $VPN"
  is_connected && \
    error "$VPN is already connected${IN_NAMESPACE:+ in namespace $NAMESPACE}
           To reconnect, first stop it: wgc down $VPN" fatal

  [[ $CMD == nup ]] || check_openresolv

  # get parameters and forwarding bridges from config file named $VPN
  parse_config_file $VPN $(decode $CMD nup bridges)

  [[ ${PARAM_VAL[Interface:MTU]:-} ]] || compute_mtu

  push_cleanup clean_vpn

  # Create WireGuard interface
  ip link add dev $DEV type wireguard #! Failed to create WireGuard interface '$DEV'

  # Override AllowedIPs for Full Tunnel (fup), Bind-Only (bup/bupd) and Namespace (nup) modes.
  # Instructs WireGuard to allow all traffic in and out of the tunnel.
  if [[ $CMD == @(fup|bup?(d)|nup) ]]; then
    PARAM_VAL[Peer:AllowedIPs]="0.0.0.0/0" # add " ::/0" if IPv6 supported
  fi

  # Configure WireGuard
  # Notice: this was tested against possible attack vectors, do not modify the general approach!
  wadd() {
    [[ -v PARAM_VAL[$1] ]] || return 0
    if [[ ${3:-} ]]; then
      wgcmd+=" $2 <(printf %s \"\$$3\")"
    else
      wgcmd+=" $2 ${PARAM_VAL[$1]@Q}"
    fi
  }
  local wgcmd="wg set ${DEV@Q}"
  wadd Interface:ListenPort     listen-port
  wadd Interface:FwMark         fwmark
  wadd Interface:PrivateKey     private-key PrivateKey
  wadd Peer:PublicKey           peer
  wadd Peer:PresharedKey        preshared-key PresharedKey
  wadd Peer:Endpoint            endpoint
  wadd Peer:PersistentKeepalive persistent-keepalive
  wadd Peer:AllowedIPs          allowed-ips
  local PrivateKey=${PARAM_VAL[Interface:PrivateKey]} PresharedKey=${PARAM_VAL[Peer:PresharedKey]:-}
  eval "$wgcmd" #> Failed to configure WireGuard interface '$DEV' using command:%%$wgcmd

  # Protect endpoint reachability against:
  # - override routes 0/1 and 128/1 possibly added in configure_vpn_plain()
  # - bad routes added in configure_vpn_plain() due to AllowedIPs
  # - bad routes added outside wgc after VPN start
  set_endpoint_host_route

  if [[ $CMD == nup ]]; then
    configure_vpn_in_namespace
  else
    configure_vpn_plain
  fi

  pop_cleanup clean_vpn

  show_state
}

is_connected() {
  declare -g HAS_NAMESPACE= IN_NAMESPACE=
  has_namespace && HAS_NAMESPACE=$NAMESPACE
  ip -br link show $DEV &>/dev/null && return 0
  [[ $HAS_NAMESPACE ]] || return 1
  ip netns exec $NAMESPACE ip -br link show $DEV &>/dev/null || return 1
  IN_NAMESPACE=$NAMESPACE
  return 0
}

has_namespace() {
  [[ -f /run/netns/$NAMESPACE || -f /var/run/netns/$NAMESPACE ]]
}

configure_vpn_plain() {
  # Configure interface $DEV
  ip link set $DEV mtu ${PARAM_VAL[Interface:MTU]} #! Failed to configure MTU '${PARAM_VAL[Interface:MTU]}' for interface '$DEV'

  local addr a=()
  split_string a "${PARAM_VAL[Interface:Address]}"
  for addr in "${a[@]}"; do
    ip addr add "$addr" dev $DEV #! Failed to add address '$addr' to interface '$DEV'
  done
  ip link set $DEV up #! Failed to bring up interface '$DEV'

  # Always add default route valid only for VPN source addresses (source policy routing)
  set_source_routing

  if [[ $CMD == @(up|fup) ]]; then
    local k set_override=
    split_string a "${PARAM_VAL[Peer:AllowedIPs]}"
    for k in "${a[@]}"; do
      [[ $k == "0.0.0.0/0" ]] && { set_override=1; continue; }
      ip route add "$k" dev $DEV #! Cannot add route to $k
    done
    [[ $set_override ]] && set_override_default_route
  fi

  if [[ $CMD == @(up|fup|bupd) && -v PARAM_VAL[Interface:DNS] ]]; then
    # We have have at least one valid nameserver ip. Configure DNS.
    local k q=
    split_string a "${PARAM_VAL[Interface:DNS]}"
    for k in "${a[@]}"; do
      q+="nameserver $k"$'\n'
      [[ $CMD == bupd ]] && ip route add "$k" dev $DEV #W Cannot add route to nameserver $k
    done
    if resolvconf -a $DEV -m 0 -x <<< "$q"; then
      check_dns_reachability "${PARAM_VAL[Interface:DNS]}"
    else
      warn "DNS configuration failed.
            Ensure 'openresolv' is properly installed and configured."
    fi
  fi
}

check_dns_reachability() {
  local dns_list=$1 # strict csv
  local nsip route_info current_dev dns_warnings= a=()
  split_string a "$dns_list"
  for nsip in "${a[@]}"; do
    if route_info=$(ip route get "$nsip" 2>/dev/null); then
      if [[ $route_info != *"dev $DEV"* ]]; then
        if [[ $route_info =~ dev\ ([^[:space:]]+) ]]; then
          current_dev="${BASH_REMATCH[1]}"
        else
          current_dev="unknown"
        fi
        dns_warnings+=$'\n'"- LEAK: $nsip is routed via '$current_dev' instead of VPN tunnel."
      fi
    else
      dns_warnings+=$'\n'"- UNREACHABLE: No route found for $nsip."
    fi
  done
  [[ ! $dns_warnings ]] #w DNS routing issues detected:$dns_warnings
  return 0
}

set_override_default_route() {
  ip route add 0/1 dev $DEV #! Cannot set default route override 0.0.0.0/1
  ip route add 128/1 dev $DEV #! Cannot set default route override 128.0.0.0/1
}

set_endpoint_host_route() {
  local ep=${PARAM_VAL[Peer:Endpoint]%%:*} route
  local route_args=() IFS=' '
  route=$(ip -j route get "$ep") #! Cannot find route to Endpoint $ep
  [[ $route =~ \"gateway\":\"([^\"]+)\" ]] && route_args+=(via "${BASH_REMATCH[1]}")
  [[ $route =~ \"dev\":\"([^\"]+)\" ]] #> Cannot determine output device for Endpoint $ep
  route_args+=(dev "${BASH_REMATCH[1]}")
  ip route add "$ep" "${route_args[@]}" #! Cannot set host route to Endpoint $ep
}

del_endpoint_host_route() {
  local nscmd=
  [[ $IN_NAMESPACE ]] && nscmd="ip netns exec $NAMESPACE"
  local ep=() IFS=$' \t\n'
  ep=( $($nscmd wg show $DEV endpoints 2>/dev/null) ) && [[ ${ep[1]:-} ]] && {
    ip route del ${ep[1]%%:*} &>/dev/null || true
  } || true
}

set_source_routing() {
  local -i t
  for ((t=51820; t<52000; t++)); do
    [[ $(ip route show table $t 2>/dev/null || true) ]] || break
  done
  ((t > 51999)) && error "Could not find an empty routing table in the range 51820..51999" fatal
  ip route add default dev $DEV table $t #! Could not add default route via $DEV in table $t
  local addr a=()
  split_string a "${PARAM_VAL[Interface:Address]}"
  for addr in "${a[@]}"; do
    ip rule add from ${addr%/*} table $t #! Could not add source routing rule for ip address ${addr%/*}
  done
}

del_source_routing() {
  local t json regex
  find_source_routing_table t || return 0
  json=$(ip -j -br addr show "$DEV") || return 0
  regex='"local":"(([0-9]{1,3}\.){3}[0-9]{1,3})"'
  while [[ $json =~ $regex ]]; do
    ip rule del from "${BASH_REMATCH[1]}" table $t &>/dev/null || true
    json="${json#*"${BASH_REMATCH[0]}"}"
  done
}

find_source_routing_table() {
  local -n _out=$1
  local _t _json _regex='"dst":"default","table":"(51[89][0-9]{2})"'
  _json=$(ip -j route show dev $DEV table all) || return 1
  [[ $_json =~ $_regex ]] && _t=${BASH_REMATCH[1]} || return 1
  (( 51820 <= _t && _t <= 51999 )) || return 1
  _out=$_t
}

compute_mtu() {
  local m= ep=${PARAM_VAL[Peer:Endpoint]%%:*}
  local r=$(ip route get "$ep" 2>/dev/null || ip route show default 2>/dev/null || true)
  [[ $r =~ mtu\ ([0-9]+) ]] && m=${BASH_REMATCH[1]}
  [[ ! $m && $r =~ dev\ ([^ ]+) ]] && m=$(<"/sys/class/net/${BASH_REMATCH[1]}/mtu") 2>&-
  PARAM_VAL[Interface:MTU]=$(( ${m:-1500} - 60 )) # -80 if IPv6
}

configure_vpn_in_namespace() {

  local nscmd="ip netns exec $NAMESPACE"
  # Create and configure namespace
  ip netns add $NAMESPACE #! Failed to create namespace '$NAMESPACE'
  ip link set $DEV netns $NAMESPACE #! Failed to move interface '$DEV' to namespace '$NAMESPACE'
  $nscmd ip link set lo up #! Failed to bring up loopback interface in namespace '$NAMESPACE'
  # Configure interface $DEV
  $nscmd ip link set $DEV mtu ${PARAM_VAL[Interface:MTU]}
    #! Failed to configure MTU '${PARAM_VAL[Interface:MTU]}' for interface '$DEV'
  local addr a=()
  split_string a "${PARAM_VAL[Interface:Address]}"
  for addr in "${a[@]}"; do
    $nscmd ip addr add "$addr" dev $DEV #! Failed to configure address '$addr' for interface '$DEV'
  done
  $nscmd ip link set $DEV up #! Failed to bring up interface '$DEV'

  # Add default route
  $nscmd ip route add default dev $DEV #! Could not add default route via $DEV in namespace $NAMESPACE
  # Configure DNS
  local dir=/etc/netns/$NAMESPACE
  local res=$dir/resolv.conf
  if mkdir -p $dir; then
    local k
    split_string a "${PARAM_VAL[Interface:DNS]}"
    for k in "${a[@]}"; do
      echo "nameserver $k"
    done > $res
  else
    warn "Cannot create directory $dir"
  fi
  # Check if we have at least one DNS server
  if [[ ! -s $res ]]; then
    warn "No valid DNS servers configured"
  fi

  # Start proxyd/socat bridges
  [[ -v PARAM_VAL[WGC:Bridges] ]] && start_bridges || true
}

start_bridges() {
  local PROXYD_BIN
  for PROXYD_BIN in /lib/systemd/systemd-socket-proxyd /usr/lib/systemd/systemd-socket-proxyd ""; do
    [[ -x $PROXYD_BIN ]] && break
  done
  [[ $PROXYD_BIN ]] || warn "systemd-socket-proxyd not found, falling back to socat"

  if [[ ! $PROXYD_BIN ]] && ! command -v socat >/dev/null; then

    warn "socat not found: cannot start bridges defined in [WGC-Bridges]"

  else

    echo "Starting Port Forwarding Bridges:"
    prc "+W%-20s %s+/\n" "Bridge" "ExtPort -> IntPort"
    prc "+A%-20s %s+/\n" "------" "------------------"

    local netns_path
    for netns_path in /run/netns/$NAMESPACE /var/run/netns/$NAMESPACE ""; do
      [[  -e $netns_path ]] && break
    done
    [[ -e $netns_path ]] || error "Cannot locate netns file for '$NAMESPACE'" fatal

    local b b_name b_ext b_int b_sock b_unit_int b_unit_ext a=()
    split_string a "${PARAM_VAL[WGC:Bridges]}"
    for b in "${a[@]}"; do
      IFS=: read -r b_name b_ext b_int <<< "$b"

      b_sock=/run/wgc.$VPN.$b_name.sock
      b_unit_int=wgc.$VPN.$b_name.int
      b_unit_ext=wgc.$VPN.$b_name.ext

      prc "+y%-20s +G%-7s +A%-2s +c%s+/\n" "$b_name" "$b_ext" "->" "$b_int"

      if [[ $PROXYD_BIN ]]; then # use systemd-socket-proxyd
        # 1. Start Internal Connector
        start_transient_service "$b_unit_int" \
          --description="WGC Connector (proxyd) '$b_name' to port $b_int" \
          --socket-property=ListenStream="$b_sock" \
          --property=NetworkNamespacePath=$netns_path \
          $PROXYD_BIN 127.0.0.1:$b_int
        # 2. Start External Listener
        start_transient_service "$b_unit_ext" \
          --description="WGC Listener (proxyd) '$b_name' $b_ext -> $b_int" \
          --socket-property=ListenStream=0.0.0.0:$b_ext \
          --property=After=$b_unit_int.service \
          --property=BindsTo=$b_unit_int.service \
          $PROXYD_BIN "$b_sock"
      else # use socat
        # 1. Start Internal Connector
        start_transient_service "$b_unit_int" \
          --description="WGC Connector (socat) '$b_name' to port $b_int" \
          ip netns exec $NAMESPACE \
          socat UNIX-LISTEN:"$b_sock",fork,reuseaddr,unlink-early,mode=600,max-children=50 TCP:127.0.0.1:$b_int,tcp-nodelay
        # 2. Start External Listener
        start_transient_service "$b_unit_ext" \
          --description="WGC Listener (socat) '$b_name' $b_ext -> $b_int" \
          --property=After=$b_unit_int.service \
          --property=BindsTo=$b_unit_int.service \
          socat TCP-LISTEN:$b_ext,fork,reuseaddr,tcp-nodelay UNIX-CONNECT:"$b_sock"
      fi

      # 3. Health check
      local unit_to_check="$b_unit_ext.service"
      [[ $PROXYD_BIN ]] && unit_to_check="${b_unit_ext}.socket"
      wait_for_unit_active "$unit_to_check"

    done
    echo
  fi
}

wait_for_unit_active() {
  local unit_to_check=$1 s=starting deadline=$((SECONDS+3)) # wait 2 to 3 seconds
  while true; do
    if { timeout --signal=KILL 0.5 systemctl is-active --quiet "$unit_to_check"; } 2>&-; then
      s=active; break
    fi
    (( $? == 137 )) && { s=hung; break; }
    ((SECONDS >= deadline)) && break
    sleep 0.1
  done
  case $s in
    starting)
      local status=$(systemctl is-active "$unit_to_check" 2>/dev/null)
      warn "Bridge '$b_name' failed to start (status: ${status:-unknown}).
            Check logs: journalctl -u $unit_to_check"
      ;;
    hung)
      warn "systemctl command hung while checking '$unit_to_check'.
            Check logs: journalctl -u $unit_to_check"
      ;;
  esac
  return 0
}

wait_for_unit_active_simple() {
  local unit_to_check=$1 retries=20 # 2 seconds total, no guarantee
  while ((retries-- > 0)); do
    systemctl is-active --quiet "$unit_to_check" && break
    sleep 0.1
  done
  if ((retries < 0)); then
    local status=$(systemctl is-active "$unit_to_check" 2>/dev/null)
    warn "Bridge '$b_name' failed to start (status: ${status:-unknown}).
          Check logs: journalctl -u $unit_to_check"
  fi
  return 0
}

start_transient_service() {
  local unit_name=$1
  shift # Shift off the first argument (unit name); the rest remains in "$@"

  command -v systemd-run >/dev/null || error "Systemd is required but not found (systemd-run)." fatal

  # Start the service
  # "$@" contains both the extra properties and the final command
  systemd-run --quiet --unit="$unit_name" \
    --description="WGC Service $unit_name" \
    --service-type=simple \
    --property=Restart=always \
    --property=RestartSec=1 \
    --property=StartLimitBurst=3 \
    --property=StartLimitIntervalSec=10 \
    --setenv=WGC_BRIDGE=1 \
    --property=SuccessExitStatus=143 \
    "$@" || warn "Command systemd-run failed for unit '$unit_name'."
}

stop_vpn() {
  assert_no_namespace; validate_vpn_name
  acquire_lock vpn_$VPN "operating on VPN $VPN"
  local stopping=
  if is_connected; then
    stopping=1
    echo "Stopping $VPN ..."
  else
    warn "VPN $VPN is already stopped. Cleaning..."
  fi

  if [[ $HAS_NAMESPACE ]]; then
    local pids=$(get_ns_pids)
    if [[ $pids ]]; then
      if [[ $CMD == kill ]]; then
        kill_processes "$pids"
      else
        error "Processes running in namespace $NAMESPACE:
               $(ps -fp $pids)
               Force stop (killing processes) with: wgc down $VPN force" fatal
      fi
    fi
  fi

  clean_vpn

  if is_connected; then
    warn "VPN $VPN is still active"
  else
    [[ $stopping ]] && echo "$Y VPN $VPN now stopped" || true
  fi
}

get_ns_pids() {
  local pid pids=
  local -a e
  # filter out forwarding bridges by looking for WGC_BRIDGE in process environment
  for pid in $(ip netns pids $NAMESPACE 2>/dev/null); do
    e=()
    mapfile -d '' e < /proc/$pid/environ 2>/dev/null || continue
    [[ ${e[*]} == *WGC_BRIDGE=* ]] && continue
    pids+="$pid "
  done
  echo $pids
}

kill_processes() {
  local pids=$1
  echo -e "Terminating processes:\n$(ps -fp $pids)"
  kill $pids &>/dev/null || true
  # paint increasing bar for timeout
  local h= d= timeout=10 # seconds
  eval printf -v d "$'\u2591'%.0s" {1..$((timeout*2))} # timeout*2 LIGHT SHADEs in d
  echo -ne "\033[?25l" # hide cursor
  while [[ "$pids" && "$d" ]]; do
    sleep 0.5
    pids=$(get_ns_pids)
    d=${d%$'\u2591'} # remove one LIGHT SHADE
    echo -ne "\r$h$d" # paint the bar over itself
    h+=$'\u2588' # append a FULL BLOCK
  done
  echo -ne "\r\033[K\033[?25h" # delete bar and restore cursor
  if [[ -z "$d" ]]; then # timeout
    echo "Forcibly terminating processes (SIGKILL)"
    kill -9 $pids &>/dev/null || true
    sleep 0.1
    # check again
    pids=$(get_ns_pids)
    [[ $pids ]] && warn "Processes still running: $pids" || true
  fi
}

clean_vpn() {

  # Stop bridges
  if command -v systemctl >/dev/null; then

    systemctl stop "wgc.${VPN}.*.socket" 2>/dev/null || true
    systemctl stop "wgc.${VPN}.*.service" 2>/dev/null || true
    systemctl reset-failed "wgc.${VPN}.*" 2>/dev/null || true

    find /run -maxdepth 1 -name "wgc.${VPN}.*.sock" -delete 2>/dev/null

  fi

  # DNS restore: remove configuration associated with $DEV
  # If openresolv is missing or fails, proceed anyway
  resolvconf -d $DEV &>/dev/null || true
  rm -rf /etc/netns/$NAMESPACE &>/dev/null || true

  if is_connected; then # Set HAS_NAMESPACE IN_NAMESPACE
    # Remove route protecting Wireguard endpoint
    del_endpoint_host_route
    if [[ $IN_NAMESPACE ]]; then
      # Remove interface and related things
      ip netns exec $NAMESPACE ip link del $DEV || true
    else
      # Remove source routing rule
      del_source_routing
      # Remove interface and related things
      ip link del $DEV || true
    fi
  fi

  if [[ $HAS_NAMESPACE ]]; then
    # Remove namespace
    local pids=$(ip netns pids $NAMESPACE)
    kill -9 $pids &>/dev/null || true
    ip netns del $NAMESPACE || true
  fi
}

show_state() {
  assert_no_namespace; validate_vpn_name
  local p_bridges=
  eval "$(get_params "$@")"

  if is_connected; then
    echo "$Y $VPN VPN is CONNECTED${IN_NAMESPACE:+ in namespace $NAMESPACE}"
    NSCMD=${IN_NAMESPACE:+ip netns exec $NAMESPACE}
    echo
    $NSCMD wg show $DEV
    echo
    echo "Interface details:"
    $NSCMD ip -c addr show $DEV
    echo
    if [[ $IN_NAMESPACE ]]; then
      echo "Routes:"
      $NSCMD ip -c route show
      echo
      echo "DNS:"
      grep -E --color '([0-9]{1,3}\.){3}[0-9]{1,3}' \
        /etc/netns/$NAMESPACE/resolv.conf 2>/dev/null || echo "  (none)"
      if [[ $p_bridges ]]; then
        echo
        echo "Forwarding Bridges:"
        show_bridges
      fi
      echo
      echo "Processes running in namespace $NAMESPACE:"
      local pids=$(get_ns_pids)
      [[ $pids ]] && ps -fp $pids || echo "  (none)"
      echo
      echo "To run commands in the VPN namespace $NAMESPACE:"
      echo "  wgc exec $VPN <command>"
      echo "  Example: wgc exec $VPN curl ipinfo.io"
    else
      echo "Routes:"
      ip -c route show table all | grep -F --color $DEV || echo "  (none)"
      echo
      local t json regex
      if find_source_routing_table t; then
        if json=$(ip -j -br addr show $DEV 2>/dev/null); then
          regex='"local":"(([0-9]{1,3}\.){3}[0-9]{1,3})"'
          echo "Rules:"
          while [[ $json =~ $regex ]]; do
            ip rule list from "${BASH_REMATCH[1]}" table $t
            json="${json#*"${BASH_REMATCH[0]}"}"
          done | grep -E --color '[0-9.]+' || echo "  (none)"
          [[ ${BASH_REMATCH[1]} ]] || warn "Could not find $DEV ip address"
        else
          warn "Could not find $DEV ip address"
        fi
      else
        warn "Could not find table used for source routing"
      fi
      echo
      echo "DNS:"
      resolvconf -l $DEV || true
    fi
  else
    warn "VPN $VPN is DISCONNECTED"
  fi
}

show_bridges() {
  # Format: UNIT LOAD ACTIVE SUB DESCRIPTION
  local output=$(systemctl list-units --all --full --type=service,socket --no-legend --plain "wgc.${VPN}.*")

  if [[ $output ]]; then
    echo
    prc "+W  %-18s %-19s %-8s %s+/\n" Bridge "ExtPort -> IntPort" Type Status
    prc "+A  %-18s %-19s %-8s %s+/\n" ------ "------------------" ---- ------

    # Load all info in hash maps for instant lookup
    local -A u_active u_desc
    local u load active sub desc
    while read -r u load active sub desc; do
      u_active[$u]=$active
      u_desc[$u]=$desc
    done <<< "$output"

    # Iterate an print
    for u in "${!u_active[@]}"; do
      # Only one line per each external Listener
      [[ $u != *.ext.* ]] && continue

      desc="${u_desc[$u]}"; active="${u_active[$u]}"

      # Parse unit description.
      # Example: WGC Listener (proxyd) 'Privoxy' 8081 -> 8080
      #                        tool     name     p_ext   p_int
      local regex="\(([^)]+)\) '([^']+)' ([0-9]+) -> ([0-9]+)"
      if [[ $desc =~ $regex ]]; then
        tool=${BASH_REMATCH[1]}
        name=${BASH_REMATCH[2]}
        p_ext=${BASH_REMATCH[3]}
        p_int=${BASH_REMATCH[4]}
        # We are interested only in sockets (proxyd) or socat services
        if [[ $u == *.socket ]] || [[ $tool == "socat" ]]; then
          local status_str=$active
          case "$active" in
            active)               status_str="$Y $status_str" ;;
            failed)               status_str="$X $status_str" ;;
            activating|reloading) status_str=$'\u25cf'" $status_str" ;;
            *)                    status_str="- $status_str" ;;
          esac

          local int_unit="wgc.${VPN}.${name}.int.socket" # proxyd
          [[ $tool == socat ]] && int_unit="wgc.${VPN}.${name}.int.service"
          local int_status="${u_active[$int_unit]:-missing}"
          [[ $int_status != active ]] && status_str+=" / Int: $X $int_status"

          prc "+y  %-18s+/ +G%-7s +A%-2s +c%-8s+/ %-8s %s\n" "$name" "$p_ext" "->" "$p_int" "$tool" "$status_str"
        fi
      fi
    done | sort # hash map order is undefined
  else
    echo "  (none)"
  fi
}

show_active_vpns() {
  local s= ns= dev= addr= found=
  echo
  echo "Active VPNs in default namespace:"
  for dev in $(wg show interfaces); do
    [[ $dev == wgc_* ]] || continue
    read -r _ s addr < <(ip -br -c address show $dev :) || true
    found=1
    echo $dev $s $addr
  done
  [[ $found ]] || echo "  (none)"
  found=
  echo
  echo "Active VPNs in other namespaces:"
  while read -r ns _; do
    [[ $ns == wgc_* ]] || continue
    dev=$ns
    ip netns exec $ns wg show $dev &>/dev/null || continue
    read -r _ s addr < <(ip netns exec $ns ip -br -c address show $dev 2>/dev/null || true)
    found=1
    echo $dev $s $addr
  done < <(ip netns list 2>/dev/null || true)
  [[ $found ]] || echo "  (none)"
  echo
}

list_config_files() {
  local f= g= Endpoint Address AllowedIPs
  echo -e "Looking in $CFGDIR\n"
  prc "+W%-12s %-4s %-18s %-29s %s+/\n" Name Br. Address Endpoint AllowedIPs
  prc "+A%-12s %-4s %-18s %-29s %s+/\n" ---- --- ------- -------- ----------
  mapfile -d '' < <(set +o noglob; printf '%s\0' "$CFGDIR"/*.conf 2>/dev/null)
  for f in "${MAPFILE[@]}"; do
    [[ -e "$f" ]] || continue
    g=${f##*/}; g=${g%.*}
    [[ $g =~ wg[0-9]+ ]] && continue # exclude wg0, wg1, wg2 ...
    parse_config_file "$g" bridges relax || continue
    Endpoint=${PARAM_VAL[Peer:Endpoint]}
    Address=${PARAM_VAL[Interface:Address]%%,*}
    AllowedIPs=${PARAM_VAL[Peer:AllowedIPs]}
    (( ${#Endpoint} > 29 )) && Endpoint="${Endpoint:0:27}.."
    local b=(); [[ -v PARAM_VAL[WGC/Bridges] ]] && split_string b "${PARAM_VAL[WGC:Bridges]}"
    prc "+c%-12s +y%-4s +m%-18s +r%-29s +g%s+/\n" "$g" ${#b[@]} "$Address" "$Endpoint" "$AllowedIPs"
  done
}

show_config_file() {
  validate_vpn_name
  local -r config_file="$CFGDIR/$VPN.conf"
  [[ -f $config_file ]] || error "File not found: $config_file" fatal
  [[ -L $config_file ]] && error "Security: Symlinks are not allowed: $config_file" fatal
  [[ -r $config_file ]] || error "Cannot read file: $config_file" fatal
  local text x
  IFS= read -r -d '' text < "$config_file" || true
  x=${text#*PrivateKey*$'\n'};   text=${text%PrivateKey*"$x"};   text+=$'PrivateKey = <HIDDEN>\n'$x
  x=${text#*PresharedKey*$'\n'}; text=${text%PresharedKey*"$x"}; text+=$'PresharedKey = <HIDDEN>\n'$x
  printf %s "$text"
}

show_parsed_config_file() {
  validate_vpn_name
  parse_config_file $VPN bridges report
  show_config
}

show_config() {
  echo
  prc "+W%-20s%s+/\n" Key  Value
  prc "+A%-20s%s+/\n"     ---- -----
  local last_section= section key v val missing pub
  for p in "${PARAMS[@]}"; do
    IFS=: read -r section key <<< "$p"
    [[ $section != "$last_section" ]] && prc "+g%s+/\n" "[$section]"
    last_section=$section
    v=; val="(missing)"; missing=1
    [[ -v PARAM_VAL[$p] ]] && { v=${PARAM_VAL[$p]}; val=$v; missing=; }
    [[ ${PARAM_ATTR[$p]:-} == ??s* && ! $missing ]] && val="<HIDDEN>"
    prc "+c%-20s+/${missing:++Y}%s+/" $key "$val"
    if [[ $p == *:P*Key && ! $missing ]]; then
      if pub=$(get_public_key "$v"); then
        [[ $p == "Interface:PrivateKey" ]] && prc "\n+A└── %-15s+/ %s" "PUBLIC" "$pub"
      else
        prc " $W +R%s+/" invalid
      fi
    fi
    [[ $missing && ${PARAM_ATTR[$p]:-} == ?r* ]] && prc " $W +R%s+/" required
    printf "\n"
  done
  if [[ -v PARAM_VAL[WGC/Bridges] ]]; then
    echo
    prc "+W%-20s%s+/\n" "Forwarding Bridge" "ExtPort -> IntPort"
    prc "+A%-20s%s+/\n"  -----------------   ------------------
    local b b_name b_ext b_int a=()
    split_string a "${PARAM_VAL[WGC:Bridges]}"
    for b in "${a[@]}"; do
      IFS=: read -r b_name b_ext b_int <<< "$b"
      prc "+y%-19s+/ %s +A%s+/ %s\n" "$b_name" "$b_ext" "->" "$b_int"
    done
  fi
  echo
}

init_config_schema() {
  declare -gA PARAM_VAL=() PARAM_LNO=()

  [[ -v PARAMS ]] && return 0

  declare -ga PARAMS
  declare -gA PARAM_ATTR SECTIONS

  local -a param_defs=( # mrs: Multivalued Required Secret
    Interface:{Address:mr-,DNS:m--,MTU:---,ListenPort:---,FwMark:---,PrivateKey:-rs}
    Peer:{PublicKey:-r-,PresharedKey:--s,Endpoint:-r-,AllowedIPs:mr-,PersistentKeepalive:---}
    WGC:Bridges:m--
  )

  local def section key attr
  for def in "${param_defs[@]}"; do
    IFS=: read -r section key attr <<< "$def"
    PARAMS+=( $section:$key )
    PARAM_ATTR[$section:$key]=$attr
    SECTIONS[$section]=1
  done

  readonly PARAMS PARAM_ATTR SECTIONS
}

parse_config_file() {
  local -r config_file="$CFGDIR/$1.conf"; shift 1
  local p_relax= p_report= p_bridges=
  eval "$(get_params "$@")"

  local fatal=fatal; [[ $p_relax ]] && fatal=
  [[ -f "$config_file" ]] || { error "File not found: $config_file" $fatal blameparent; return 1; }
  [[ -L $config_file ]] && { error "Security: Symlinks are not allowed: $config_file" $fatal blameparent; return 1; }
  [[ -r "$config_file" ]] || { error "Cannot read file: $config_file" $fatal blameparent; return 1; }

  local line n=0 section= key value
  local -A SEEN_SECTIONS=()
  local ISSUES=() HAS_FATAL_ISSUE=
  init_config_schema
  while read -r line || [[ $line ]]; do # also read last line if \n is missing
      ((++n))
      line=${line%%#*} # Remove comments
      [[ $line =~ [^[:space:]] ]] || continue # Skip empty lines
      if [[ $line =~ ^[[:space:]]*\[([A-Za-z0-9_-]+)\][[:space:]]*$ ]]; then
        # This line is a section.
        section=${BASH_REMATCH[1]} # Track section
        if ! [[ -v SECTIONS[$section] ]]; then
          add_issue "$n" "Unknown section [$section]"
          section=BADSECTION
          continue
        fi
        # Section is valid.
        # If section was seen before, mark it as bad...
        if [[ -v SEEN_SECTIONS[$section] ]]; then
          add_issue "$n" "Ignored duplicate section [$section]"
          section=BADSECTION
          continue
        fi
        # Otherwise, register it as seen.
        SEEN_SECTIONS[$section]=1
        continue
      fi
      # This line is not a section.
      # Skip lines in bad sections (even before all sections)
      case "$section" in
        BADSECTION) continue ;;
        "") add_issue "$n" "Ignored data before sections"
            section=BADSECTION; continue ;;
      esac
      # Parse key=value with flexible spacing
      if [[ $line =~ ^[[:space:]]*([[:alnum:]]+)[[:space:]]*=[[:space:]]*([^[:space:],](.*[^[:space:],])?)[[:space:]]*$ ]]; then
        key=${BASH_REMATCH[1]}   # trimmed, alphanumeric
        value=${BASH_REMATCH[2]} # trimmed, no leading or trailing commas
      else # Not a key=value line
        add_issue "$n" "Malformed line in section [$section]"
        continue
      fi
      # Get values according to section/key
      process_config_line
  done < "$config_file"
  validate_parameters
  if [[ ! $p_relax ]]; then
    local IFS=''
    if [[ $HAS_FATAL_ISSUE ]]; then
      fatal=fatal; [[ $p_report ]] && fatal=
      error "Found fatal issues in $config_file:${ISSUES[*]}" $fatal blameparent
    else
      (( ${#ISSUES[*]} > 0 )) && warn "Issues in $config_file:${ISSUES[*]}"
    fi
  fi
  return 0
}

add_issue() {
  local n=$1 msg=$2
  local first_n=${n%%,*}
  # Prefix the message with the line number (e.g., "10: Message")
  # Join with newline if multiple issues exist for the same line index
  ISSUES[first_n]+=$'\n'"$n: $msg."
  [[ $msg == FATAL:* ]] && HAS_FATAL_ISSUE=1
  return 0
}

process_config_line() {
  [[ $section == WGC && -z $p_bridges ]] && return 0
  local p=$section:$key comma=${PARAM_LNO[$section:$key]:+,}
  [[ -v PARAM_ATTR[$p] ]] || { add_issue "$n" "Found unknown key '$key' in section [$section]"; return 0; }
  PARAM_VAL[$p]+=$comma$value
  PARAM_LNO[$p]+=$comma$n
  return 0
}

validate_parameters() {
  local p v n section key func_name
  for p in "${!PARAM_VAL[@]}"; do
    IFS=: read -r section key <<< "$p"
    v=${PARAM_VAL[$p]}; n=${PARAM_LNO[$p]}
    # If it isn't a multivalued key, check for duplicate
    [[ ${PARAM_ATTR[$p]:-} == m* ]] || check_dup || continue
    func_name="validate_${section}_$key"
    declare -F "$func_name" >/dev/null || error "FATAL: Internal error - Missing function '$func_name'" fatal
    "$func_name"
  done
  local -a missing_params=()
  for p in "${!PARAM_ATTR[@]}"; do
    # If parameter was not parsed and is required, then it is missing
    [[ ! -v PARAM_VAL[$p] && ${PARAM_ATTR[$p]:-} == ?r* ]] && missing_params+=( "$p" )
  done
  local IFS=,
  (( ${#missing_params[@]} > 0 )) && add_issue 0 "FATAL: Missing required keys (section:key): ${missing_params[*]}"
  return 0
}

check_dup() {
  [[ $n == *,* ]] || return 0
  add_issue "$n" "FATAL: Duplicated key '$key' in section [$section]"
  return 1
}

validate_Interface_Address() {
  collect_all_ipv4_cidr ,
  [[ -v PARAM_VAL[Interface/Address] ]] && check_ipaddr_overlap "${PARAM_VAL[Interface:Address]}" || true
}

validate_Interface_DNS() {
  collect_all_ipv4 ,
}

validate_Interface_MTU() {
  # min 576 for IPv4, min 1280 for IPv6
  [[ $v =~ ^([1-9][0-9]{2,4})$ ]] && (( v >= 576 && v <= 65535 )) && return 0
  add_issue "$n" "FATAL: Invalid $key value '$v' (must be 576-65535)"
}

validate_Interface_PrivateKey() {
  is_valid_key "$v" && return 0
  add_issue "$n" "FATAL: Invalid $key value"
}

validate_Interface_ListenPort() {
  is_valid_port "$v" || { add_issue "$n" "FATAL: Invalid $key value '$v' (must be 1-65535)"; return 0; }
  local info
  check_udp_port_usage "$v" info || add_issue "$n" "FATAL: UDP port '$v' is already used${info:+ by $info}"
  return 0
}

validate_Interface_FwMark() {
  [[ $v == off || $v =~ ^(0x[[:xdigit:]]{1,8}|0|[1-9][0-9]{0,9})$ && $v -le 0xFFFFFFFF ]] && return 0
  add_issue "$n" "FATAL: Invalid $key value '$v' (must be 0-4294967295 0x0-0xFFFFFFFF)"
}

validate_Peer_AllowedIPs() {
  collect_all_ipv4_cidr ,
}

validate_Peer_Endpoint() {
  [[ ! $v =~ ^([-A-Za-z0-9.]+):([0-9]{1,5})$ ]] && { add_issue "$n" "FATAL: Invalid $key value '$v'"; return 0; }
  local host=${BASH_REMATCH[1]}; local port=${BASH_REMATCH[2]}
  is_valid_port "$port" || add_issue "$n" "FATAL: Invalid $key port '$port'"
  if ! is_valid_ipv4 "$host"; then
    local ip
    read -r ip _ < <(getent ahostsv4 "$host" || true) || true
    is_valid_ipv4 "$ip" && host=$ip || add_issue "$n" "FATAL: Could not resolve $key host '$host'"
  fi
  PARAM_VAL[$p]="$host:$port"
  return 0
}

validate_Peer_PersistentKeepalive() {
  [[ $v =~ ^([1-9][0-9]{0,4}|0)$ ]] && (( v <= 65535 )) && return 0
  add_issue "$n" "FATAL: Invalid $key value '$v', must be 0-65535"
}

validate_Peer_PresharedKey() {
  validate_Interface_PrivateKey
}

validate_Peer_PublicKey()  {
  is_valid_key "$v" && return 0
  add_issue "$n" "FATAL: Invalid $key value '$v'"
}

validate_WGC_Bridges() {
  local bridge name ext int c=0 bridges=() IFS=$'\x20'
  local -A seen_names=() seen_ext_ports=()

  for bridge in ${v//,/ }; do
    ((++c))
    [[ $bridge =~ ^([a-zA-Z][a-zA-Z0-9_-]*):([0-9]+):([0-9]+)$ ]] || \
      { add_issue "$n" "FATAL: Invalid bridge '$bridge'. Format must be <name>:<number>:<number>"; continue; }
    name=${BASH_REMATCH[1]}; ext=${BASH_REMATCH[2]}; int=${BASH_REMATCH[3]}
    [[ -v seen_names[$name] ]] && { add_issue "$n" "FATAL: Duplicate bridge name '$name' in Bridges list"; continue; }
    seen_names[$name]=1
    local pok=1
    is_valid_port "$ext" || { add_issue "$n" "FATAL: Bridge '$name' has invalid external port '$ext', must be 1-65535"; pok=; }
    is_valid_port "$int" || { add_issue "$n" "FATAL: Bridge '$name' has invalid internal port '$int', must be 1-65535"; pok=; }
    [[ $pok ]] || continue
    [[ -v seen_ext_ports[$ext] ]] && \
      { add_issue "$n" "FATAL: Bridge '$name' ext. port $ext conflicting with bridge '${seen_ext_ports[$ext]}'"; continue; }
    seen_ext_ports[$ext]=$name
    local info; check_tcp4_port_usage "$ext" info || \
      add_issue "$n" "FATAL: Bridge '$name' ext. port $ext is already in use${info:+ by $info}"
    bridges+=( "$name:$ext:$int" )
  done
  (( c==0 || c > ${#bridges[*]} )) && return 0
  local IFS=,; PARAM_VAL[WGC:Bridges]="${bridges[*]}"
  PARAM_VAL[WGC/Bridges]=1 # Means WGC:Bridges is valid
  return 0
}

collect_all_ipv4() {
  local sep=$1
  local -A seen=()
  local -a out=()
  local ip f=0 d=0 b=0 IFS=$'\x20'
  for ip in ${v//,/ }; do
    if is_valid_ipv4 "$ip"; then
      [[ -v seen[$ip] ]] && { ((++d)); continue; }
      ((++f)); out+=("$ip"); seen[$ip]=1; continue
    fi
    ((++b))
  done
  ((f>0 && d==0 && b==0 )) && { IFS=$sep; PARAM_VAL[$p]=${out[*]}; return 0; }
  ((f==0)) && add_issue "$n" "FATAL: Could not find any IPv4 address in $key"
  ((d>0))  && add_issue "$n" "FATAL: Found $d duplicate IPv4 addresses in $key"
  ((b>0))  && add_issue "$n" "FATAL: Found $b invalid IPv4 addresses in $key"
  return 0
}

collect_all_ipv4_cidr() {
  local sep=$1
  local -A seen=()
  local -a out=()
  local ip pure_ip f=0 d=0 b=0 IFS=$'\x20'
  for ip in ${v//,/ }; do
    if is_valid_ipv4_cidr "$ip"; then
      pure_ip=${ip%/*}; [[ -v seen[$pure_ip] ]] && { ((++d)); continue; }
      ((++f)); out+=("$ip"); seen[$pure_ip]=1; continue
    fi
    ((++b))
  done
  if ((f>0 && d==0 && b==0 )); then
    IFS=$sep; PARAM_VAL[$p]=${out[*]}
    PARAM_VAL[$section/$key]=1 # means parameter p=$section:$key is valid
    return 0
  fi
  ((f==0)) && add_issue "$n" "FATAL: Could not find any CIDR IPv4 address in $key"
  ((d>0))  && add_issue "$n" "FATAL: Found $d duplicate/overlapping CIDR IPv4 addresses in $key"
  ((b>0))  && add_issue "$n" "FATAL: Found $b invalid CIDR IPv4 addresses in $key"
  return 0
}

is_valid_ipv4() {
  # Define a single octet
  # 25[0-5]     -> 250-255
  # 2[0-4][0-9] -> 200-249
  # 1[0-9][0-9] -> 100-199
  # [1-9]?[0-9] -> 0-99
  local oct="(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])"
  local regex="^$oct\.$oct\.$oct\.$oct$"
  [[ ${1:-} =~ $regex ]]
}

is_valid_ipv4_cidr() {
  # [1-2]?[0-9] -> 0-29
  # 3[012]      -> 30-32
  local oct="(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])"
  local regex="^$oct\.$oct\.$oct\.$oct(/([1-2]?[0-9]|3[012]))?$"
  [[ ${1:-} =~ $regex ]]
}

check_ipaddr_overlap() {
  local a=() addr
  split_string a "$1"
  local route_info
  for addr in "${a[@]%/*}"; do
    route_info=$(ip route get "$addr" 2>/dev/null) || continue
    [[ $route_info == *" via "* ]] && continue
    [[ $route_info =~ dev\ ([^[:space:]]+) ]] || continue
    local iface=${BASH_REMATCH[1]}
    if [[ $iface == lo ]]; then
      IFS=$' \t\n' read -r iface _ < <(ip -br addr show to "$addr" 2>/dev/null)
      add_issue "$n" "FATAL: IP address '$addr' is already assigned${iface:+ to interface '$iface'}"
      continue
    fi
    add_issue "$n" "IP address '$addr' overlaps with interface '$iface'"
  done
  return 0
}

is_valid_port() {
  local p=$1
  [[ $p =~ ^(0|[1-9][0-9]*)$ ]] && ((p >= 1 && p <= 65535))
}

check_udp_port_usage() {
  local -n _process_info=$2
  local _ss_out=$(ss -lunHp "sport = :$1")
  _process_info=
  if [[ $_ss_out ]]; then
    [[ ${_ss_out%%$'\n'*} =~ users:\(\(.*\)\) ]] && _process_info=${BASH_REMATCH[0]}
    return 1
  fi
  return 0
}

check_tcp4_port_usage() {
  local -n _process_info=$2
  local _ss_out=$(ss -4ltnHp "sport = :$1")
  _process_info=
  if [[ $_ss_out ]]; then
    [[ ${_ss_out%%$'\n'*} =~ users:\(\(.*\)\) ]] && _process_info=${BASH_REMATCH[0]}
    return 1
  fi
  return 0
}

is_valid_key() {
  [[ $1 =~ ^[a-zA-Z0-9+/]{43}=$ ]] && wg pubkey <<< "$1" &>/dev/null
}

get_public_key() {
  [[ $1 =~ ^[a-zA-Z0-9+/]{43}=$ ]] && wg pubkey <<< "$1" 2>/dev/null
}

check_dependencies() {
  local missing=()
  for cmd in tput ip wg grep resolvconf mkdir rm ps sleep find curl sed setpriv socat timeout; do
    command -v $cmd >/dev/null || missing+=($cmd)
  done
  if (( ${#missing[@]} > 0 )); then
    local IFS=,
    error "Missing required commands: ${missing[*]}
           Install with:
           apt install wireguard-tools iproute2 grep sed coreutils \\
           procps findutils openresolv util-linux ncurses-bin" fatal blameparent
  fi
  echo "$Y All required commands are available."
}

exec_in_namespace() {
  assert_no_namespace; validate_vpn_name
  acquire_lock vpn_$VPN "operating on VPN $VPN"
  [[ $# -eq 0 ]] && { error "No command specified"; show_usage; exit 1; }
  is_connected || error "VPN $VPN is not connected. Start it first with: wgc nup $VPN" fatal
  [[ $IN_NAMESPACE ]] || error "VPN $VPN is not in its own namespace. Just use plain command: $*" fatal

  if [[ $(</proc/$PPID/comm) == sudo ]]; then
    # wgc auto-elevated or executed with sudo.
    # sudo inherits and sanitizes the original environment (depending on the active security policy) before executing wgc.

    command -v setpriv >/dev/null || error "Missing command 'setpriv'" fatal
    [[ ${SUDO_UID:-} ]] || error "Unable to determine invoking user (SUDO_UID missing)" fatal
    [[ ${SUDO_GID:-} ]] || error "Unable to determine invoking group (SUDO_GID missing)" fatal

    # Retrieve the Grandparent PID (field 4 of parent's stat).
    # This identifies the correct source for the unsanitized environment:
    # 1. Modern sudo (PTY mode): It targets the main sudo process (which holds the original env).
    # 2. Legacy sudo: It targets the invoking shell directly.
    # In both cases, reading this PID's environ bypasses the sanitization applied by the direct parent.
    local grandpa_pid var_eq_val var
    read -r _ _ _ grandpa_pid _ < /proc/$PPID/stat # get sudo pid
    # Build the environment for the final command
    local -a FINAL_ENV
    while read -r -d '' var_eq_val; do
      var=${var_eq_val%%=*}
      [[ $var == @(PWD|_) ]] && continue
      FINAL_ENV+=("$var_eq_val")
    done < /proc/$grandpa_pid/environ

    # Append the actual current PWD.
    # wgc inherited the correct working directory from sudo (whether preserved or changed via sudo -i),
    # so $PWD holds the authoritative value.
    FINAL_ENV+=("PWD=$PWD")

    # Final command
    local PAYLOAD=(setpriv --reuid $SUDO_UID --regid $SUDO_GID --init-groups env -i "${FINAL_ENV[@]}" "$@")
  else
    [[ ${PKEXEC_UID:-} || ${DOAS_USER:-} ]] && \
      error "Elevation detected but not supported (pkexec/doas).
             Please use 'sudo wgc ...'" fatal
    # wgc direct execution by root: no user/env switch needed
    local PAYLOAD=("$@")
  fi

  # Execution with Anti-Leak protection (NSCD)
  # If we are in a VPN namespace with custom DNS and the host's nscd socket exists,
  # we must hide it to prevent glibc from using it and ignoring our DNS configuration.
  local nscd_fix
  if nscd_fix=$(get_nscd_fix_cmd); then
    # Use an ephemeral mount namespace (unshare -m) to hide the socket.
    # 'mount -t tmpfs' is safer than bind mounting on existing directories.
    # Pass PAYLOAD as positional arguments to bash to avoid quoting issues.
    exec ip netns exec $NAMESPACE \
      unshare -m \
      /bin/bash -c "$nscd_fix"' && exec "$@"' -- "${PAYLOAD[@]}"
  else
    # No leak risk or nscd not present
    exec ip netns exec $NAMESPACE "${PAYLOAD[@]}"
  fi
}

get_nscd_fix_cmd() {
  [[ -f /etc/netns/$NAMESPACE/resolv.conf ]] || return 1

  local cmd= found=

  if [[ -S /var/run/nscd/socket ]]; then
    cmd+="mount -t tmpfs -o size=1M,mode=755 none /var/run/nscd && "
    found=1
  fi
  if [[ -S /run/nscd/socket ]]; then
    cmd+="mount -t tmpfs -o size=1M,mode=755 none /run/nscd && "
    found=1
  fi

  if command -v systemctl &>/dev/null && systemctl is-active -q nscd 2>/dev/null; then
    warn "nscd service is active: applying isolation (socket mask + nsswitch override).
          DNS leaks still possible if host nscd restarts during VPN usage."
    found=1
  fi

  [[ $found ]] || return 1

  cmd="mount --make-rprivate / 2>/dev/null && $cmd"

  local nss_content=
  if [[ -r /etc/nsswitch.conf ]]; then
    nss_content=$(sed -E 's/[[:space:]]*\b(nscd|sss)\b//g' /etc/nsswitch.conf)
  fi
  if [[ -z $nss_content ]]; then
    nss_content=$'passwd: files\ngroup: files\nhosts: files dns\nnetworks: files'
  fi
  nss_content=$'# Generated by wgc (nscd/sss removed to prevent DNS leaks)\n'$nss_content
  cmd+="printf '%s' ${nss_content@Q} > /run/nsswitch.wgc && "
  cmd+="mount --bind /run/nsswitch.wgc /etc/nsswitch.conf && "

  echo "${cmd% && }"
  return 0
}

enable_completion() {
  acquire_lock completion "enabling completion"
  local completion_dir=
  for completion_dir in /etc/bash_completion.d /usr/share/bash-completion/completions ""; do
    [[ -d "$completion_dir" ]] && break
  done
  [[ $completion_dir ]] || error "Cannot find bash completion directory" fatal
  local completion_file="$completion_dir/wgc"

  cat > "$completion_file" << 'EOF'
_wgc_completion() {
  local cur= prev= commands= IFS=$' \t\n'
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"

  # Main commands
  commands="conf parse up fup bup bupd nup down kill state act list exec req"

  # Complete the first arg with main commands
  if [[ $COMP_CWORD -eq 1 ]]; then
    compopt +o default
    COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
    return 0
  fi

  # Complete the second arg depending on command
  if [[ $COMP_CWORD -eq 2 ]]; then
    if [[ "$cur" == [\<\>\|\&\;]* ]]; then
      compopt -o default
      COMPREPLY=()
      return 0
    fi
    compopt +o default # disable default (no files if no match)
    case "$prev" in
      up|fup|bup|bupd|nup|conf|parse)
        # VPN config file list
        local cfgdir_path=${WGC_CFGDIR:-/etc/wireguard}
        mapfile -t COMPREPLY < <(compgen -G "$cfgdir_path/${cur}*.conf")
        COMPREPLY=( "${COMPREPLY[@]##*/}" ); COMPREPLY=( "${COMPREPLY[@]%.*}" )
        local k
        for k in "${!COMPREPLY[@]}"; do
          [[ ${COMPREPLY[k]} == wg[0-9]* ]] && unset "COMPREPLY[k]" # remove wg0, wg1, wg2 ...
        done
        compopt -o filenames
        ;;
      down|kill|state)
        # Active VPNs in default namespace
        local -a ifaces
        ifaces=($(wg show interfaces 2>/dev/null)) || ifaces=(sudo $(wg show interfaces 2>/dev/null)) || return 1
        local i v
        for i in "${ifaces[@]}"; do
          [[ $i == wgc_* ]] || continue
          v+="${i#*wgc_} "
        done
        # Active VPNs (namespaces)
        local n
        while read -r n _; do
          [[ $n == wgc_* ]] || continue
          v+="${n#*wgc_} "
        done < <(/usr/sbin/ip netns list 2>/dev/null)
        COMPREPLY=( $(compgen -W "$v" -- "$cur") )
        ;;
      exec)
        # Active VPNs (namespaces)
        local n v
        while read -r n _; do
          [[ $n == wgc_* ]] || continue
          v+="${n#*wgc_} "
        done < <(/usr/sbin/ip netns list 2>/dev/null)
        COMPREPLY=( $(compgen -W "$v" -- "$cur") )
        ;;
    esac
    return 0
  fi

  # For exec, after VPN name do complete with system commmands
  if [[ $COMP_CWORD -gt 2 ]]; then
    case "${COMP_WORDS[1]}" in
      exec)
        if [[ $COMP_CWORD -eq 3 ]]; then
          compopt +o default
          if [[ ${#cur} -lt 1 ]]; then # minimum 1 char for system commmands completion
            COMPREPLY=()
            return 0
          fi
        fi
        if declare -F _command_offset &>/dev/null; then
          # Use advanced completion if available
          _command_offset 3
        else
          # Fallback to basic completion
          if [[ $COMP_CWORD -eq 3 ]]; then
            COMPREPLY=( $(compgen -c -- "$cur") )
          else
            compopt -o default
            COMPREPLY=()
          fi
        fi
        return 0
        ;;
    esac
  fi
}

complete -o bashdefault -o default -F _wgc_completion wgc
EOF

  chmod 644 "$completion_file"

  [[ $(stat -c %A "$CFGDIR") == *r?? ]] || \
    warn "Completion for non-root users is unable to read file names in configuration directory.
          Execute: chmod o+r '$CFGDIR' # directory only!" fatal

  cat << EOF
$Y Bash completion installed to $completion_file

To activate completion in current shell:
  source $completion_file

Completion will be automatically available in new shell sessions.
EOF
}

has_openresolv() {
  [[ $(resolvconf -h 2>/dev/null) =~ -x[[:blank:]][[:blank:].A-Za-z]*[[:blank:]]exclusive ]]
}

install_forced_openresolv() {
  acquire_lock openresolv "installing/removing openresolv"
  has_openresolv && error "Openresolv is already installed ('resolvconf' supports exclusive mode -x)." fatal

  [[ -L /usr/sbin/resolvconf ]] ||
    error "Systemd-resolved symlink wrapper for 'resolvconf' NOT detected. Standard installation is possible.
           Please install 'openresolv' using: sudo apt-get install openresolv" fatal

  echo "Forcing openresolv installation..."

  dpkg-divert --list | grep "/usr/sbin/resolvconf" > /dev/null || {
    echo "Diversion of resolvconf binary..."
    dpkg-divert --divert /usr/sbin/resolvconf.systemd --rename --add /usr/sbin/resolvconf
  }

  local TEMP_DIR=$(mktemp -d)
  mkdir -p "$TEMP_DIR"
  cd "$TEMP_DIR" || return 1

  apt-get download openresolv 2>/dev/null
  local DEB_FILE=$(find . -name "openresolv*.deb" | head -n 1)
  if [[ $DEB_FILE ]]; then
    echo "Download via APT successful."
  else
    echo "APT download failed (package 'openresolv' likely missing)."
    echo "Attempting download via Debian Unstable Packages index..."
    local IDX_URL="https://ftp.debian.org/debian/dists/stable/main/binary-all/Packages.gz"
    local REL_PATH=$(curl -s "$IDX_URL" | \
          zgrep -m 1 "^Filename: .*openresolv_.*_all.deb" | cut -d $'\x20' -f 2)
    if [[ -z $REL_PATH ]]; then
      echo "Error: Could not find openresolv in Debian index."
      echo "Tried searching: $IDX_URL"
      echo "This may indicate the package has been removed or renamed."
      cd .. && rm -rf "$TEMP_DIR"
      return 1
    fi
    local FULL_URL="https://ftp.debian.org/debian/$REL_PATH"
    DEB_FILE=$(basename "$REL_PATH")
    echo "Detected version: $DEB_FILE"
    wget -O "$DEB_FILE" "$FULL_URL" || {
      echo "Download failed: $FULL_URL"
      cd .. && rm -rf "$TEMP_DIR"
      return 1
    }
  fi

  echo "Creating file manifest..."
  mkdir -p /etc/wwggcc

  dpkg-deb --fsys-tarfile "$DEB_FILE" | tar -tf - | grep -v '/$' | sed 's|^./|/|' > /etc/wwggcc/openresolv.files

  echo "Extracting directly to system..."
  dpkg-deb --fsys-tarfile "$DEB_FILE" | tar --keep-directory-symlink --no-overwrite-dir -xC /

  cd ..
  rm -rf "$TEMP_DIR"

  echo "Detecting DNS backend..."
  if [[ -d /run/systemd/resolve ]]; then
    echo "Systemd-resolved detected. Appending configuration."
    if ! grep -q "name_servers=\"127.0.0.53\"" /etc/resolvconf.conf; then
      {
        echo ""
        echo "# Added by wgc installer for systemd-resolved compatibility"
        echo "name_servers=\"127.0.0.53\""
        echo "resolv_conf_options=\"trust-ad\""
      } >> /etc/resolvconf.conf
    else
      echo "Configuration already present. Skipping."
    fi
  else
    echo "Systemd-resolved NOT detected. Leaving standard configuration."
  fi

  echo "Regenerating resolvconf..."
  /sbin/resolvconf -u

  if command -v mandb >/dev/null; then
    echo "Updating the manual page index caches..."
    mandb -pq
  fi

  echo "Openresolv forced successfully."
  echo "Manifest saved to /etc/wwggcc/openresolv.files"
  echo "To remove openresolv: wgc remopenresolv"
}

check_openresolv() {
  if ! has_openresolv; then
    local tailmsg='Please run: apt-get install openresolv'
    [[ -d /run/systemd/resolve ]] && tailmsg="This system has systemd-resolved.
      To bypass debian package conflict with openresolv run 'wgc openresolv' instead of 'apt-get install openresolv'.
      To remove openresolv installed by wgc run 'wgc remopenresolv'."
    error "Your version of 'resolvconf' does not support exclusive mode (-x).
           $tailmsg" fatal blameparent
  fi
}

remove_openresolv() {
  acquire_lock openresolv "installing/removing openresolv"
  local MANIFEST=/etc/wwggcc/openresolv.files

  echo "Removing openresolv..."

  dpkg-divert --list | grep "/usr/sbin/resolvconf" > /dev/null ||
    error "No package diversion found. Assuming standard APT management.
           To uninstall 'openresolv', please use: sudo apt remove openresolv" fatal

  echo "Removing diversion of resolvconf binary..."
  rm -f /usr/sbin/resolvconf
  dpkg-divert --rename --remove /usr/sbin/resolvconf

  if [[ -f "$MANIFEST" ]]; then
    echo "Deleting installed files..."
    cat "$MANIFEST" | tr '\n' '\0' | xargs -0 rm -f
    rm -f "$MANIFEST"
  else
    echo "Warning: Manifest $MANIFEST not found. Trying generic cleanup..."
    rm -f /usr/sbin/resolvconf
    rm -rf /usr/lib/resolvconf
    rm -f /etc/resolvconf.conf
  fi

  rmdir /usr/lib/resolvconf 2>/dev/null || true

  echo "Restoring systemd-resolved symlink /etc/resolv.conf..."
  if [[ -f /etc/resolv.conf ]] && [[ ! -L /etc/resolv.conf ]]; then
    rm -f /etc/resolv.conf
    ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf
  fi

  echo "Restoring systemd-resolved resolvconf symlink wrapper..."
  rm -f /usr/sbin/resolvconf
  ln -sf /usr/bin/resolvectl /usr/sbin/resolvconf

  if command -v mandb >/dev/null; then
    echo "Updating the manual page index caches..."
    mandb -pq
  fi

  echo "Done. System returned to APT management."
}

