show_bridges() {
  # Format: UNIT LOAD ACTIVE SUB DESCRIPTION
  local output=$(systemctl list-units --all --full --type=service,socket --no-legend --plain "wgc.${VPN}.*")

  if [[ $output ]]; then
    echo
    prc "+W  %-18s %-19s %-8s %s+/\n" Bridge "ExtPort -> IntPort" Type Status
    prc "+A  %-18s %-19s %-8s %s+/\n" ------ "------------------" ---- ------

    # Load all info in hash maps for instant lookup
    local -A u_active u_desc
    local u load active sub desc
    while read -r u load active sub desc; do
      u_active[$u]=$active
      u_desc[$u]=$desc
    done <<< "$output"

    # Iterate an print
    for u in "${!u_active[@]}"; do
      # Only one line per each external Listener
      [[ $u != *.ext.* ]] && continue

      desc="${u_desc[$u]}"; active="${u_active[$u]}"

      # Parse unit description.
      # Example: WGC Listener (proxyd) 'Privoxy' 8081 -> 8080
      #                        tool     name     p_ext   p_int
      local regex="\(([^)]+)\) '([^']+)' ([0-9]+) -> ([0-9]+)"
      if [[ $desc =~ $regex ]]; then
        tool=${BASH_REMATCH[1]}
        name=${BASH_REMATCH[2]}
        p_ext=${BASH_REMATCH[3]}
        p_int=${BASH_REMATCH[4]}
        # We are interested only in sockets (proxyd) or socat services
        if [[ $u == *.socket ]] || [[ $tool == "socat" ]]; then
          local status_str=$active
          case "$active" in
            active)               status_str="$Y $status_str" ;;
            failed)               status_str="$X $status_str" ;;
            activating|reloading) status_str=$'\u25cf'" $status_str" ;;
            *)                    status_str="- $status_str" ;;
          esac

          local int_unit="wgc.${VPN}.${name}.int.socket" # proxyd
          [[ $tool == socat ]] && int_unit="wgc.${VPN}.${name}.int.service"
          local int_status="${u_active[$int_unit]:-missing}"
          [[ $int_status != active ]] && status_str+=" / Int: $X $int_status"

          prc "+y  %-18s+/ +G%-7s +A%-2s +c%-8s+/ %-8s %s\n" "$name" "$p_ext" "->" "$p_int" "$tool" "$status_str"
        fi
      fi
    done | sort # hash map order is undefined
  else
    echo "  (none)"
  fi
}

