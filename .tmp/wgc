show_config() {
  echo
  prc "+W%-20s%s+/\n" Key  Value
  prc "+A%-20s%s+/\n"     ---- -----
  local pub val
  for k in Address DNS MTU ListenPort FwMark PrivateKey PublicKey PresharedKey Endpoint AllowedIPs PersistentKeepalive; do
    val=${!k:-(missing)}
    [[ $k == PrivateKey && ${!k} ]] && val="<HIDDEN>"
    prc "+c%-20s+Y${!k:++/}%s+/" $k "$val"
    if [[ $k ==  P*Key && ${!k} ]]; then
      if pub=$(get_public_key "${!k}"); then
        [[ $k == PrivateKey ]] && prc "\n+A└── %-15s+/ %s" "PUBLIC" "$pub"
      else
        prc " $W +R%s+/ " invalid
      fi
    fi
    [[ $k == @(Address|PrivateKey|PublicKey|Endpoint|AllowedIPs) && ! ${!k} ]] && prc " $W +R%s+/ " required
    printf "\n"
