parse_config_file() {
  local -r config_file="$CFGDIR/$1.conf"; shift 1
  local p_relax= p_report= p_bridges=
  eval "$(get_params "$@")"

  local fatal=fatal; [[ $p_relax ]] && fatal=
  [[ -f "$config_file" ]] || { error "Config file not found: $config_file" $fatal blameparent; return 1; }
  [[ -r "$config_file" ]] || { error "Can't read file: $config_file" $fatal blameparent; return 1; }

  local line= n=0 s=0 section= key= value= ISSUES= section_valid=
  Address= PrivateKey= PublicKey= Endpoint= AllowedIPs= DNS= MTU= ListenPort= FwMark= PersistentKeepalive= PresharedKey=
  WGC_BRIDGES=()
  local -A SEEN_SECTIONS=() USED_BRPORTS=() USED_BRNAMES=()
  fatal=
  while read -r line || [[ $line ]]; do # also read last line if \n is missing
      ((++n))
      line=${line%%#*} # Remove comments
      [[ ! $line =~ [^[:space:]] ]] && continue # Skip empty lines
      if [[ $line =~ ^[[:space:]]*(\[[A-Za-z0-9_-]+\])[[:space:]]*$ ]]; then
        # This line is a section.
        section=${BASH_REMATCH[1]} # Track section
        s=$n # remember section line number
        if process_config_line checksection; then
          # Section is valid.
          # If section was seen before, mark it as bad...
          if [[ -v SEEN_SECTIONS[$section] ]]; then
            ISSUES+=$'\n'"Ignored duplicate section $section at line $s"
            section=BADSECTION
            continue
          fi
          # Otherwise, register it as seen.
          SEEN_SECTIONS[$section]=1
          continue
        else # Section is unknown.
          ISSUES+=$'\n'"Unknown section '$section' at line $s"
          section=BADSECTION
          continue
        fi
      fi
      # This line is not a section.
      # Skip lines in bad sections (even before all sections)
      case "$section" in
        BADSECTION) continue ;;
        "") ISSUES+=$'\n'"Ignored data before sections at line $n"
            section=BADSECTION ;;
      esac
      # Parse key=value with flexible spacing
      if [[ $line =~ ^[[:space:]]*([A-Za-z0-9]+)[[:space:]]*=[[:space:]]*(.*[^[:space:]]) ]]; then
        key=${BASH_REMATCH[1]}   # key without spaces
        value=${BASH_REMATCH[2]} # value trimmed
      else # Not a key=value line
        ISSUES+=$'\n'"Malformed line $n: ${line:0:50}$( ((${#line} > 50)) && echo ... || true )"
        continue
      fi
      # Get values according to section/key
      process_config_line || fatal=fatal
  done < "$config_file"
  validate_parameters || fatal=fatal
  if [[ ! $p_relax ]]; then
    for n in Address PrivateKey PublicKey Endpoint AllowedIPs; do
      [[ ${!n} ]] || { fatal=fatal; ISSUES+=$'\n'"Missing required key '$n'"; }
    done
    if [[ $ISSUES ]]; then
      [[ $p_report ]] && fatal=
      error "Issues in $config_file:$ISSUES" $fatal blameparent
    fi
  fi
}

process_config_line() {
  [[ ${1:-} == checksection ]] && key=_checksection_
  case "$section" in
    "[Interface]")
      case "$key" in
        _checksection_) return 0 ;;
        Address) extract_ipv4 "$value" Address ;;
        DNS) extract_all_ipv4 "$value" ' ' DNS ;;
        MTU) MTU=$value ;;
        PrivateKey) PrivateKey=$value ;;
        ListenPort)
          ListenPort=$value
          [[ is_valid_port $ListenPort ]] && return 0
          ISSUES+=$'\n'"Invalid ListenPort value at line $n (must be 1-65535): $ListenPort"
          return 1
          ;;
        FwMark) FwMark=$value ;;
        *) ISSUES+=$'\n'"Unknown key '$key' in section '$section' at line $n"; return 0 ;;
      esac
      ;;
    "[Peer]")
      case "$key" in
        _checksection_) return 0 ;;
        AllowedIPs) extract_all_ipv4 "cidr$value" ' ' AllowedIPs ;;
        Endpoint) validate_resolve_endpoint || return 1 ;;
        PersistentKeepalive) PersistentKeepalive=$value ;;
        PresharedKey) PresharedKey=$value ;;
        PublicKey) PublicKey=$value ;;
        *) ISSUES+=$'\n'"Unknown key '$key' in section '$section' at line $n"; return 0 ;;
      esac
      ;;
    "[WGC-Bridges]")
      [[ $key == _checksection_ ]] && return 0
      [[ $p_bridges ]] || return 0
      # Sintax: <bridgename> = <externalport>-<internalport>
      # Example: qBittorrent = 8765-8765
      if [[ ! $key =~ ^[a-zA-Z0-9_-]+$ ]]; then
        ISSUES+=$'\n'"Invalid bridge name '$key' at line $n (chars allowed: A-Z, a-z, 0-9, _, -)"
        return 0
      fi
      if [[ -v USED_BRNAMES[$key] ]]; then
        ISSUES+=$'\n'"Duplicate bridge name '$key' at lines $n and ${USED_BRNAMES[$key]}"
        return 0
      fi
      if [[ $value =~ ^([0-9]+)[[:space:]]*-[[:space:]]*([0-9]+)$ ]]; then
        local ext_port="${BASH_REMATCH[1]}"
        local int_port="${BASH_REMATCH[2]}"
        if ! is_valid_port $ext_port || ! is_valid_port $int_port; then
          ISSUES+=$'\n'"Invalid port at line $n (must be 1-65535): $value"
          return 0
        fi
        if [[ -v USED_BRPORTS[$ext_port] ]]; then
          ISSUES+=$'\n'"Duplicate external port $ext_port for bridge '$key' at line $n (already used by '${USED_BRPORTS[$ext_port]}')"
          return 0
        fi
        USED_BRNAMES[$key]=$n
        USED_BRPORTS[$ext_port]=$key
        WGC_BRIDGES+=("$key:$ext_port:$int_port")
      else
        ISSUES+=$'\n'"Invalid bridge format '$value' at line $n. Use: external-internal (e.g., 4321-1234)"
        return 0
      fi
      ;;
    *) return 1 ;;
  esac
  return 0
}

