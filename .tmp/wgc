# Guard against sourcing.
[[ "${BASH_SOURCE[0]}" == "$0" ]] || return 1

doit() {
  if [ -z "$BASH_VERSION" ]; then
    echo "ERROR: This script requires Bash. Please run with 'wgc'." >&2
    exit 1
  fi
  if ((BASH_VERSINFO[0] < 4)) || ((BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4)); then
    echo "ERROR: Bash 4.4 or newer is required (found $BASH_VERSION)." >&2
    exit 1
  fi

  # Sanitized auto-elevation
  local safesudo
  safesudo=$(command -p -v sudo) || { echo "ERROR: sudo not found in standard paths." >&2; exit 1; }
  if [[ ! $UID == 0 ]]; then
    exec $safesudo WGC_CFGDIR="$WGC_CFGDIR" BASH_ENV= ENV= CDPATH= IFS= "$0" "$@"
  fi
  # unset fails when readonly, so use exec env -i
  [[ ${BASH_ENV:-}${ENV:-}${CDPATH:-} ]] && \
    exec /usr/bin/env -u BASH_ENV -u ENV -u CDPATH "$0" "$@"

  export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

  set +vx
  [[ ${1:-} == trace ]] && { set -vx; shift; }

  # Shell state baseline
  set +abefhkmnptuBCEHPT
  shopt -u $(shopt | awk '/[[:space:]]on$/{print $1}')
  # What I want
  set +o posix       # Turn off Posix standard
  set -o hashall     # Remember the location of commands as they are looked up.
  set -o braceexpand # Perform brace expansion.
  set -o nounset     # Treat unset variables as an error.
  set -o pipefail    # Return value of a pipeline is the status of the last command to exit with a non-zero status.
  set -o errexit   # Exit immediately if a command exits with a non-zero status.
  set -o errtrace  # Trap ERR is inherited by functions.
  trap 'error TRAP-ERR fatal' ERR
  trap 'error TRAP-INT fatal' INT
  trap 'error TRAP-TERM fatal' TERM
  shopt -s extglob   # Enable extended glob patterns: x(y)
  shopt -s nullglob  # Patterns which match no files expand to a null string
  shopt -s checkwinsize extquote
  export LC_ALL=C LANG=C
  local IFS=$' \t\n'

  (( $# == 0 )) && { show_usage; exit; }

  local -r CMD=${1:-} VPN=${2:-}
  local DEV=wgc_${VPN:-}
  local NAMESPACE=$DEV

  local W X Y HAS_COLORS; local -A COLORS; set_markers; readonly W X Y HAS_COLORS COLORS
  local CFGDIR; set_cfgdir; readonly CFGDIR
  local HAS_NAMESPACE IN_NAMESPACE
  local Address PrivateKey PublicKey Endpoint AllowedIPs DNS MTU ListenPort PersistentKeepalive PresharedKey FwMark
  local -a WGC_BRIDGES

  case "$CMD" in
    u|up|f|fu|fup|bup|bupd|n|nu|nup|d|do|dow|down|s|st|sta|stat|state|e|ex|exe|exec)
      validate_vpn_name
      local ns=$(ip netns identify) || true
      [[ $ns ]] && error "Usage of wgc is not supported inside a network namespace ($ns)" fatal
      ;;
    c|co|con|conf|p|pa|par|pars|parse)
      validate_vpn_name
      ;;
  esac

  case "$CMD" in
    u|up|f|fu|fup|bup?(d)|nup)
      start_vpn
      ;;
    d|do|dow|down)
      stop_vpn ${3:-} # can be "force"
      ;;
    s|st|sta|stat|state)
      show_state bridges
      ;;
    a|ac|act|acti|activ|active)
      show_active_vpns
      ;;
    l|li|lis|list)
      list_config_files
      ;;
    c|co|con|conf)
      show_config_file
      ;;
    p|pa|par|pars|parse)
      show_parsed_config_file
      ;;
    r|re|req)
      check_dependencies
      ;;
    e|ex|exe|exec)
      shift 2
      exec_in_namespace "$@"
      ;;
    completion)
      enable_completion
      ;;
    openresolv)
      install_forced_openresolv
      ;;
    remopenresolv)
      remove_openresolv
      ;;
    null)
      :
      ;;
    f)
      "${@:2}"
      ;;
    ft)
      PS4='+${LINENO}:${FUNCNAME[0]}: '
      shopt -s promptvars
      set -vx; "${@:2}"
      ;;
    *)
      show_usage
      ;;
  esac
}

show_usage() {
  cat <<EOF
Usage:
  wgc <command> [<vpn>]
  wgc exec <vpn> <command>

Core Commands:
  up <vpn>   - Start VPN in Standard mode.
               Adds routes defined in AllowedIPs, applying special handling
               for 0.0.0.0/0 to prevent loops.  Effect: Automatically handles
               Split Tunnel or Full Tunnel based on configuration file.
  fup <vpn>  - Start VPN in Full Tunnel mode (Redirect All Traffic).
               Ignores AllowedIPs routing logic and directs ALL traffic through
               the VPN tunnel. Useful for untrusted networks/public Wi-Fi.
  bup <vpn>  - Start VPN in Bind-Only mode.
               VPN is accessible, but no traffic is routed automatically because
               neither system routing tables nor DNS settings are modified.
               Traffic enters the tunnel if and only if it is explicitly bound
               to the VPN interface or its IP address.
  bupd <vpn> - Start VPN in Bind-Only mode with DNS.
               Just like bup, but enforces VPN DNS settings system-wide.
               Routes are added only for the nameservers to ensure reachability.
               Data traffic still requires explicit binding, but DNS resolution
               is performed via the VPN tunnel for the entire system.
  nup <vpn>  - Start VPN in a dedicated Network Namespace (isolated stack)
               named wgc_<vpn>.
               ALL traffic is directed through VPN tunnel via default route.
               Applications must be launched via 'wgc exec'.
  down <vpn> - Stop the VPN and clean up routes.

Inspection & Utils:
  state <vpn> - Show detailed state of a specific VPN.
  active      - List only active VPN interfaces.
  list        - List all available config files.
  conf <vpn>  - Display the content of <vpn>.conf.
  parse <vpn> - Check syntax and show parsed parameters for <vpn>.conf.
  req         - Verify that required dependencies are installed.

Execution:
  exec <vpn> - Run a command inside the VPN Network Namespace.
               (Only valid if VPN was started with 'nup')
               Example, run 'curl ipinfo.io' in 'office' VPN namespace:
                 wgc exec office curl ipinfo.io

Configuration:
  <vpn> must match a file in \$WGC_CFGDIR (Default: /etc/wireguard).
  Example: 'office' matches '/etc/wireguard/office.conf'.
  Export WGC_CFGDIR to override the default configuration directory.

Bash Completion:
  To enable bash completion: wgc completion
  Redo completion if WGC_CFGDIR is changed.
EOF
}

# Minimalist argument parser helper.
# Maps arguments of the form 'name=value' to readonly local variables prefixed with 'p_'.
#
# Usage Protocol:
# 1. Consume and shift out all initial fixed positional arguments.
# 2. Define default values for optional parameters as local variables with 'p_' prefix.
# 3. Execute: eval "$(get_params "$@")" to parse and overwrite defaults.
#
# Argument Syntax:
# - name=value  -> Sets p_name to "value".
# - name        -> Sets p_name to "name" (Flag mode, equivalent to name=name).
#
# Constraints & Responsibilities:
# 1. Caller: Must ensure passed argument keys are valid Bash identifiers (alphanumeric/underscore)
#    to avoid syntax errors during assignment.
# 2. Function Implementation: Must NOT use local variables starting with 'p_' for internal logic,
#    as this namespace is reserved for the generated parameters.
#
# Example:
#   func() {
#     shift 1                        # Remove fixed arguments if any
#     local p_timeout=10 p_verbose=  # Define defaults (mutable)
#     eval "$(get_params "$@")"      # Parse arguments, override defaults and lock variables (readonly)
#     echo "Timeout: $p_timeout"
#     [[ $p_verbose ]] && echo "Verbose active"
#   }
#   func arg1 timeout=30 verbose
#
get_params() {
  local arg key buf=
  local -i n=1
  for arg; do
    key=${arg%%=*}
    buf+=" p_$key=\${$n#*=}"
    ((n++))
  done
  echo "${buf:+local -r}$buf"
}

set_markers() {
  Y=$'\u2713'
  X=$'\u274C'
  W=$'\u2717'
  # Detect if terminal supports colors
  HAS_COLORS=
  if [[ -t 1 ]] && (($(tput colors 2>/dev/null || echo 0) >= 8)); then
    Y=$'\e[1;32m'$Y$'\e[m' # green CHECK MARK
    X=$'\e[1;31m'$X$'\e[m' # red CROSS MARK
    W=$'\e[1;31m'$W$'\e[m' # red BALLOT X
    HAS_COLORS=1
  fi
  # colors
  # 0:Black(Ash), 1:Red, 2:Green, 3:Yellow, 4:Blue, 5:Magenta, 6:Cyan, 7:White
  local chars=argybmcw i k
  for ((i=0; i<8; i++)); do
    k=${chars:i:1}
    COLORS[$k]=$'\e[0;3'$i'm'    # Lowercase: Normal
    COLORS[${k^}]=$'\e[1;3'$i'm' # Uppercase: Bold/Bright
  done
  COLORS[/]=$'\e[m'
}

# prc - Print with color - A wrapper around printf
# Usage: prc [FORMAT] [ARGS...]
#
# If +x is one of +[ARGYBMCWargybmcw/], color is applied as follows:
#   Bright color: A:gray R:red G:green Y:yellow B:blue M:magenta C:cyan W:white
#   Normal color: a      r     g       y        b      m         c      w
#   Reset color: /
# COLORS array maps letters to ANSI color codes.
#
# FORMAT: printf-style format string (default: %s) plus +x syntax.
#
# In short, it works exactly as printf, with these exceptions:
# - In addition to %x format characters it recognizes +x format codes.
# - If x in +x is not a color code, it results in x (e.g. ++ == +).
# - If FORMAT is empty, format %s is assumed.
# - If there is only arg $1, it is printed literally (no orphaned format specifiers).
#
# Examples:
#   prc "+R%s+/\n" "Error: 234"    # prints "Error: 234" in Bright Red + newline
#   prc "+RError: %d+/\n" 234      # equivalent
#   prc +R%s+/ "Error: 234"        # prints "Error: 234" in Bright Red
#   prc +R%s%d+/ "Error: " 0xEA    # equivalent
#   prc "+R%s +Y%d+/" "Error:" 234 # prints a red "Error: " followed by a yellow 234
#   prc +g%s+/ Success             # prints "Success" in Normal Green
#   prc "+gSuccess+/"              # prints "+gSuccess+/" without ANSI color codes
#   prc "%dSuccess"                # prints "%dSuccess"
#   prc "%d files\n" 42            # prints "42 files" with no color + newline
#
prc() {
  local fmt=$1 l r k

  if (( $# > 1 )); then
    fmt=$fmt+ # fmt is indeed a format, append sentinel character
    while : ; do
      k=${fmt%%+*}   # k = anything before +
      r=${fmt#"$k+"} # r = anything after +
      l+=$k
      [[ $r ]] || break
      k=${COLORS[${r:0:1}]:-}
      if [[ $k ]]; then
        # char after + is a color code and $k is the corresponding ANSI code
        l+=${HAS_COLORS:+$k}
      else
        # +x where x is not a color code means x (++ is about the only real-world case)
        l+=${r:0:1}
      fi
      fmt=${r:1} # consider remaining fmt
    done
    l=${l:-%s}
    shift # adjust "$@"
  else
    # fmt is a message -> set default format
    l=%s
  fi

  printf "$l" "$@"
}

set_cfgdir() {
  CFGDIR=${WGC_CFGDIR:-/etc/wireguard}
  # Validate directory
  [[ ! -d "$CFGDIR" ]] && \
    error "Configuration directory not found: $CFGDIR
          Set WGC_CFGDIR to point to dir containing Wireguard *.conf files." fatal
  if ! ls "$CFGDIR" &>/dev/null; then
    error "Cannot access configuration directory: $CFGDIR
           Possible causes: SELinux, AppArmor, or mount restrictions.
           Debug: sudo ls -ldZ '$CFGDIR' && sudo getenforce" fatal
  fi
  return 0
}

start_vpn() {
  is_connected && \
    error "$VPN is already connected${IN_NAMESPACE:+ in namespace $NAMESPACE}
           To reconnect, first stop it: wgc down $VPN" fatal

  [[ $CMD == nup ]] || check_openresolv

  # get parameters and forwarding bridges from config file named $VPN
  parse_config_file $VPN ${p_nup:+bridges}

  # TODO: call compute_mtu

  push_cleanup clean_vpn

  # Create WireGuard interface
  ip link add dev $DEV type wireguard || error "Failed to create WireGuard interface '$DEV'" fatal

  # Override AllowedIPs for Full Tunnel (fup), Bind-Only (bup/bupd) and Namespace (nup) modes.
  # Instructs WireGuard to allow all traffic in and out of the tunnel.
  if [[ $CMD == @(fup|bup?(d)|nup) ]]; then
    AllowedIPs="0.0.0.0/0" # add " ::/0" if IPv6 supported
  fi

  # Configure WireGuard
  # Notice: this was tested against possible attack vectors, do not modify the general approach!
  local wgcmd='wg set $DEV'
  [[ $ListenPort ]] && wgcmd+=' listen-port "$ListenPort"'
  [[ $FwMark ]] && wgcmd+=' fwmark "$FwMark"'
  wgcmd+=' private-key <(printf %s "$PrivateKey")'
  wgcmd+=' peer "$PublicKey"'
  wgcmd+=' allowed-ips "${AllowedIPs// /,}"'
  wgcmd+=' endpoint "$Endpoint"'
  [[ $PresharedKey ]] && wgcmd+=' preshared-key <(printf %s "$PresharedKey")'
  [[ $PersistentKeepalive ]] && wgcmd+=' persistent-keepalive "$PersistentKeepalive"'
  eval "$wgcmd" || {
    eval $'read -r -d "" wgcmd <<EOF\n'"${wgcmd/\$PrivateKey/<HIDDEN>}"$'\nEOF' || true
    error "Failed to configure WireGuard interface '$DEV' using command:
           $wgcmd" fatal
  }

  # Protect endpoint reachability against:
  # - override routes 0/1 and 128/1 possibly added in configure_vpn_plain()
  # - bad routes added in configure_vpn_plain() due to AllowedIPs
  # - bad routes added outside wgc after VPN start
  set_endpoint_host_route

  if [[ $CMD == nup ]]; then
    configure_vpn_in_namespace
  else
    configure_vpn_plain
  fi

  pop_cleanup clean_vpn

  show_state
}

configure_vpn_plain() {
  # Configure interface $DEV
  ip addr add "$Address" dev $DEV || error "Failed to configure address '$Address' for interface '$DEV'" fatal
  [[ $MTU ]] && {
    ip link set $DEV mtu $MTU || error "Failed to configure MTU '$MTU' for interface '$DEV'" fatal
  }
  ip link set $DEV up || error "Failed to bring up interface '$DEV' with address '$Address'" fatal

  # Always add default route valid only for source $Address (source policy routing)
  set_source_routing

  if [[ $CMD == fup ]]; then
    set_override_default_route
  elsif [[ $CMD == up ]]; then
    local set_override=
    for k in $AllowedIPs; do
      [[ $k == "0.0.0.0/0" ]] && { set_override=1; continue; }
      ip route add "$k" dev $DEV || error "Cannot add route to $k" fatal
    done
    [[ $set_override ]] && set_override_default_route
  fi

  if [[ $CMD == @(up|fup|bupd) && $DNS ]]; then
    # Configure DNS
    local k= q=
    for k in $DNS; do
      if is_valid_ipv4 "$k"; then
        q+="nameserver $k"$'\n'
        [[ $CMD == bupd ]] && ip route add "$k" dev "$DEV" 2>/dev/null || true
      else
        warn "Skipping invalid DNS server '$k'"
      fi
    done
    if [[ $q ]]; then
      echo "$q" | resolvconf -a $DEV -m 0 -x || \
        warn "DNS configuration failed.
              Ensure 'openresolv' is properly installed and configured."
    else
      warn "Could not find any valid ip address in DNS parameter"
    fi
  fi
}

set_override_default_route() {
  ip route add 0/1 dev $DEV || error "Cannot set default route override 0.0.0.0/1" fatal blameparent
  ip route add 128/1 dev $DEV || error "Cannot set default route override 128.0.0.0/1" fatal blameparent
}

set_endpoint_host_route() {
  local ep=${Endpoint%%:*} route
  local -a route_args
  is_valid_ipv4 "$ep" || read -r ep _ < <(getent ahostsv4 "$ep") || \
    error "Cannot resolve Endpoint name '$ep'" fatal blameparent
  route=$(ip -j route get "$ep" 2>/dev/null) || error "Cannot find route to Endpoint $ep" fatal blameparent
  [[ $route =~ \"gateway\":\"([^\"]+)\" ]] && route_args+=(via "${BASH_REMATCH[1]}")
  [[ $route =~ \"dev\":\"([^\"]+)\" ]] || error "Cannot determine output device for Endpoint $ep" fatal blameparent
  route_args+=(dev "${BASH_REMATCH[1]}")
  ip route add "$ep" "${route_args[@]}" || error "Cannot set host route to Endpoint $ep" fatal blameparent
}

del_endpoint_host_route() {
  local nscmd=
  [[ $IN_NAMESPACE ]] && nscmd="ip netns exec $NAMESPACE"
  local -a ep=()
  ep=($($nscmd wg show $DEV endpoints)) && {
    [[ ${ep[1]:-} ]] && {
      ep=${ep[1]%%:*}
      ip route del $ep &>/dev/null || true
    }
  } || true
}

set_source_routing() {
  local -i t
  for ((t=51820; t<65536; t++))
    [[ $(ip route show table $t 2>/dev/null) ]] || break
  done
  ((t > 65535)) && error "Cannot find an empty routing table in the range 51820..65535" fatal
  ip route add default dev $DEV table $t
  ip rule add from ${Address%/*} table $t
}

del_source_routing() {
  [[ $(ip -br addr show $DEV 2>/dev/null) =~ ([0-9]{1,3}\.){3}[0-9]{1,3} ]] && \
    ip rule del from ${BASH_REMATCH[0]} &>/dev/null || true
}

compute_mtu() {
  [[ ${PARAMETER_VAL[MTU]:-} ]] && return
  local m endpoint=${PARAMETER_VAL[Endpoint]}
  local r=$(ip route get "${endpoint%%:*}" 2>&- || ip route show default 2>&-)
  [[ $r =~ mtu\ ([0-9]+) ]] && m=${BASH_REMATCH[1]}
  [[ ! $m && $r =~ dev\ ([^ ]+) ]] && m=$(<"/sys/class/net/${BASH_REMATCH[1]}/mtu") 2>&-
  PARAMETER_VAL[MTU]=$(( ${m:-1500} - 80 ))
}

configure_vpn_in_namespace() {

  # Create and configure namespace
  ip netns add $NAMESPACE || error "Failed to create namespace '$NAMESPACE'" fatal
  ip link set $DEV netns $NAMESPACE || error "Failed to move interface '$DEV' to namespace '$NAMESPACE'" fatal
  ip netns exec $NAMESPACE ip link set lo up || error "Failed to bring up loopback interface in namespace '$NAMESPACE'" fatal
  # Configure interface $DEV
  ip netns exec $NAMESPACE ip addr add "$Address" dev $DEV || error "Failed to configure address '$Address' for interface '$DEV'" fatal
  [[ $MTU ]] && \
    ip netns exec $NAMESPACE ip link set $DEV mtu $MTU || error "Failed to configure MTU '$MTU' for interface '$DEV'" fatal
  ip netns exec $NAMESPACE ip link set $DEV up || error "Failed to bring up interface '$DEV' with address '$Address'" fatal

  # Add default route
  ip netns exec $NAMESPACE ip route add default dev $DEV
  # Configure DNS
  if mkdir -p /etc/netns/$NAMESPACE; then
    local k
    for k in $DNS; do
      if is_valid_ipv4 "$k"; then
        echo "nameserver $k"
      else
        warn "Skipping invalid DNS server '$k'"
      fi
    done > /etc/netns/$NAMESPACE/resolv.conf
  else
    warn "Cannot create directory /etc/netns/$NAMESPACE"
  fi
  # Check if we have at least one DNS server
  if [[ ! -s /etc/netns/$NAMESPACE/resolv.conf ]]; then
    warn "No valid DNS servers configured"
  fi

  # Start socat bridges
  if (( ${#WGC_BRIDGES[@]} > 0 )); then
    local bridge_data b_name b_ext b_int b_sock b_unit_int b_unit_ext

    local PROXYD_BIN
    for PROXYD_BIN in /lib/systemd/systemd-socket-proxyd /usr/lib/systemd/systemd-socket-proxyd ""; do
      [[ -x $PROXYD_BIN ]] && break
    done
    [[ $PROXYD_BIN ]] || warn "systemd-socket-proxyd not found, falling back to socat"

    if [[ ! $PROXYD_BIN ]] && ! command -v socat >/dev/null; then

      warn "socat not found: cannot start defined bridges in [WGC-Bridges]"

    else

      echo "Starting Port Forwarding Bridges:"
      prc "+W%-20s %s+/\n" "Bridge" "ExtPort -> IntPort"
      prc "+A%-20s %s+/\n" "------" "------------------"

      local netns_path
      for netns_path in /run/netns/$NAMESPACE /var/run/netns/$NAMESPACE ""; do
        [[  -e $netns_path ]] && break
      done
      [[ -e $netns_path ]] || error "Cannot locate netns file for '$NAMESPACE'" fatal

      for bridge_data in "${WGC_BRIDGES[@]}"; do
        IFS=: read -r b_name b_ext b_int <<<"$bridge_data"
        b_sock=/run/wgc.$VPN.$b_name.sock
        b_unit_int=wgc.$VPN.$b_name.int
        b_unit_ext=wgc.$VPN.$b_name.ext

        # Is external port available for listen?
        if [[ $(ss -lntH "sport = :$b_ext") ]] ; then
          warn "Cannot start bridge '$b_name': External port $b_ext is already in use on host."
          continue
        fi

        prc "+y%-20s +G%-7s +A%-2s +c%s+/\n" "$b_name" "$b_ext" "->" "$b_int"

        if [[ $PROXYD_BIN ]]; then # use systemd-socket-proxyd
          # 1. Start Internal Connector
          start_transient_service "$b_unit_int" \
            --description="WGC Connector (proxyd) '$b_name' to port $b_int" \
            --socket-property=ListenStream="$b_sock" \
            --property=NetworkNamespacePath=$netns_path \
            $PROXYD_BIN 127.0.0.1:$b_int
          # 2. Start External Listener
          start_transient_service "$b_unit_ext" \
            --description="WGC Listener (proxyd) '$b_name' $b_ext -> $b_int" \
            --socket-property=ListenStream=$b_ext \
            --property=After=$b_unit_int.service \
            --property=BindsTo=$b_unit_int.service \
            $PROXYD_BIN "$b_sock"
        else # use socat
          # 1. Start Internal Connector
          start_transient_service "$b_unit_int" \
            --description="WGC Connector (socat) '$b_name' to port $b_int" \
            ip netns exec $NAMESPACE \
            socat UNIX-LISTEN:"$b_sock",fork,reuseaddr,unlink-early,mode=600,max-children=50 TCP:127.0.0.1:$b_int,tcp-nodelay
          # 2. Start External Listener
          start_transient_service "$b_unit_ext" \
            --description="WGC Listener (socat) '$b_name' $b_ext -> $b_int" \
            --property=After=$b_unit_int.service \
            --property=BindsTo=$b_unit_int.service \
            socat TCP-LISTEN:$b_ext,fork,reuseaddr,tcp-nodelay UNIX-CONNECT:"$b_sock"
        fi

        # 3. Health check
        local unit_to_check="$b_unit_ext.service"
        [[ $PROXYD_BIN ]] && unit_to_check="${b_unit_ext}.socket"
        local retries=20 # 2 seconds total
        while ((retries-- > 0)); do
          sleep 0.1
          systemctl is-active --quiet "$unit_to_check" && break
        done
        if ((retries < 0)); then
          local status=$(systemctl is-active "$unit_to_check" 2>/dev/null)
          warn "Bridge '$b_name' failed to start (status: ${status:-unknown}).
                Check logs: journalctl -u $unit_to_check"
        fi

      done
      echo
    fi
  fi
}

start_transient_service() {
  local unit_name=$1
  shift # Shift off the first argument (unit name); the rest remains in "$@"

  command -v systemd-run >/dev/null || error "Systemd is required but not found (systemd-run)." fatal

  # Start the service
  # "$@" contains both the extra properties and the final command
  systemd-run --quiet --unit="$unit_name" \
    --description="WGC Service $unit_name" \
    --service-type=simple \
    --property=Restart=always \
    --property=RestartSec=1 \
    --property=StartLimitBurst=3 \
    --property=StartLimitIntervalSec=10 \
    --setenv=WGC_BRIDGE=1 \
    --property=SuccessExitStatus=143 \
    "$@" || warn "Command systemd-run failed for unit '$unit_name'."
}

stop_vpn() {
  local p_force=
  eval "$(get_params "$@")"

  local stopping=
  if is_connected; then
    stopping=1
    echo "Stopping $VPN ..."
  else
    warn "VPN $VPN is already stopped. Cleaning..."
  fi

  if [[ $HAS_NAMESPACE ]]; then
    local pids=$(get_ns_pids)
    if [[ $pids ]]; then
      if [[ $p_force ]]; then
        kill_processes "$pids"
      else
        error "Processes running in namespace $NAMESPACE:
               $(ps -fp $pids)
               Force stop (killing processes) with: wgc down $VPN force" fatal
      fi
    fi
  fi

  clean_vpn

  if is_connected; then
    warn "VPN $VPN is still active"
  else
    [[ $stopping ]] && echo "$Y VPN $VPN now stopped" || true
  fi
}

get_ns_pids() {
  local pid pids=
  local -a e
  # filter out forwarding bridges by looking for WGC_BRIDGE in process environment
  for pid in $(ip netns pids $NAMESPACE 2>/dev/null); do
    mapfile -d '' e < /proc/$pid/environ 2>/dev/null || continue
    [[ ${e[*]} == *WGC_BRIDGE=* ]] && continue
    pids+="$pid "
  done
  echo $pids
}

kill_processes() {
  local pids=$1
  echo -e "Terminating processes:\n$(ps -fp $pids)"
  kill $pids &>/dev/null || true
  # paint increasing bar for timeout
  local h= d= timeout=10 # seconds
  eval printf -v d "$'\u2591'%.0s" {1..$((timeout*2))} # timeout*2 LIGHT SHADEs in d
  echo -ne "\033[?25l" # hide cursor
  while [[ "$pids" && "$d" ]]; do
    sleep 0.5
    pids=$(ip netns pids $NAMESPACE 2>/dev/null)
    d=${d%$'\u2591'} # remove one LIGHT SHADE
    echo -ne "\r$h$d" # paint the bar over itself
    h+=$'\u2588' # append a FULL BLOCK
  done
  echo -ne "\r\033[K\033[?25h" # delete bar and restore cursor
  if [[ -z "$d" ]]; then # timeout
    echo "Forcibly terminating processes (SIGKILL)"
    kill -9 $pids &>/dev/null || true
    sleep 0.1
    # check again
    pids=$(ip netns pids $NAMESPACE 2>/dev/null)
    [[ $pids ]] && warn "Processes still running: $pids" || true
  fi
}

clean_vpn() {

  # Stop bridges
  if command -v systemctl >/dev/null; then

    local sockets_to_stop=$(systemctl list-units --all --type=socket --no-legend --plain "wgc.${VPN}.*" | cut -d ' ' -f 1)
    if [[ $sockets_to_stop ]]; then
      systemctl stop $sockets_to_stop 2>/dev/null || true
    fi

    local services_to_stop=$(systemctl list-units --all --type=service --no-legend --plain "wgc.${VPN}.*" | cut -d ' ' -f 1)
    if [[ $services_to_stop ]]; then
      systemctl stop $services_to_stop 2>/dev/null || true
    fi

    local all_units="$sockets_to_stop $services_to_stop"
    if [[ $all_units ]]; then
      systemctl reset-failed $all_units 2>/dev/null || true
    fi

    rm -f /run/wgc.${VPN}.*.sock 2>/dev/null || true

  fi

  # DNS restore: remove configuration associated with $DEV
  # If openresolv is missing or fails, proceed anyway
  resolvconf -d $DEV &>/dev/null || true
  rm -rf /etc/netns/$NAMESPACE &>/dev/null || true

  if is_connected; then # Set HAS_NAMESPACE IN_NAMESPACE
    # Remove route protecting Wireguard endpoint
    del_endpoint_host_route
    if [[ $IN_NAMESPACE ]]; then
      # Remove interface and related things
      ip netns exec $NAMESPACE ip link del $DEV &>/dev/null || true
    else
      # Remove source routing rule
      del_source_routing
      # Remove interface and related things
      ip link del $DEV &>/dev/null || true
    fi
  fi

  if [[ $HAS_NAMESPACE ]]; then
    # Remove namespace
    # Note: Processes that were in the deleted namespace lose network connectivity
    # but continue running.
    ip netns del $NAMESPACE &>/dev/null || true
  fi
}

