# Add cleanup function to stack top
push_cleanup() {
  declare -ga CLEANUP_STACK
  local func_name="$1"
  CLEANUP_STACK+=($func_name)
}

# Remove cleanup function from stack top
pop_cleanup() {
  local func_name=$1 # must declare function to pop, to avoid forgetting pops
  local last_idx=$((${#CLEANUP_STACK[@]} - 1))
  [[ "$func_name" ]] || error "BUG: pop_cleanup called without function name" fatal blameparent
  [[ $last_idx -lt 0 ]] && error "BUG: Cannot pop '$func_name' from empty stack!" fatal blameparent
  local last_pushed="${CLEANUP_STACK[$last_idx]}"
  # function to pop must match last pushed function
  if [[ "$func_name" != "$last_pushed" ]]; then
    error "BUG: expected pop of '$last_pushed', but got '$func_name'" fatal blameparent
  fi
  unset "CLEANUP_STACK[$last_idx]" # pop
}

# Error handler. Supports:
# - Error messages with line numbers
# - blameparent: Reports caller's line number instead
# - Flexible error reporting (soft vs fatal)
# - fatal: Triggers cleanup stack unwinding and exits
# - Graceful cleanup even when cleanup functions fail
# - Multi-line message (using %% or actual newlines)
# - On trap ERR: special comment tags (#!|#\?|#W|#>|#:|#w) as error messages
# - Context passed as named args (command, exit_code) when arg1 is CRASH
error() {
  local p_exit_code=$? msg=$1 IFS=$' \t\n'; shift
  local p_fatal= p_blameparent=
  local p_command=$BASH_COMMAND p_line=${BASH_LINENO[0]} p_source=${BASH_SOURCE[1]}
  eval "$(get_params "$@")"
  local line=$p_line; [[ $p_blameparent ]] && line=${BASH_LINENO[1]}

  local exit_target=$((p_exit_code>0 ? p_exit_code : 1))
  local original_traps=$(trap -p)
  trap - ERR INT TERM

  declare -g ERROR_HANDLED=1

  local technical_msg= exp_cmd=$(safer_expand "$p_command")

  case "$msg" in
    CRASH)
      technical_msg=$'  \u2193'" The script CRASHED with this command and exit code $p_exit_code%%$p_command%%$exp_cmd"
      indent_multiline technical_msg
      echo "$technical_msg" >&2
      exit $exit_target
      ;;
    TRAP-ERR)
      local custom_msg= final_msg= tag= warning=
      technical_msg=$'\u2193'" This command failed with exit code $p_exit_code%%$p_command%%$exp_cmd"

      local -a chunk
      mapfile -t -n 4 -s "$((line-1))" chunk < "$p_source" # Read line of failure and next 3 lines

      local regex1='^.*[[:space:]](#!|#\?|#W|#>|#:|#w)[[:space:]]*(.*)$' # Same line
      local  regex2='^[[:space:]]*(#!|#\?|#W|#>|#:|#w)[[:space:]]*(.*)$' # Next line
      local continuation_idx=0

      if [[ ${chunk[0]} =~ $regex1 ]]; then
         continuation_idx=1
      elif [[ ${chunk[1]} =~ $regex2 ]]; then
         continuation_idx=2
      fi

      if (( continuation_idx )); then
         tag=${BASH_REMATCH[1]}
         custom_msg=${BASH_REMATCH[2]}
         local i l
         for ((i=continuation_idx; i<${#chunk[@]}; i++)); do
           l=${chunk[$i]}
           [[ $l == *([[:space:]])"$tag"* ]] || break
           custom_msg+="${l#*([[:space:]])"$tag"*([[:space:]])}"
         done
      fi

      if [[ $custom_msg ]]; then
        custom_msg=$(safe_expand "$custom_msg")
      fi

      case "$tag" in
        '#!') # Prepend + Fatal
          final_msg=$custom_msg%%$technical_msg
          p_fatal=1
          ;;
        '#?') # Prepend + Non-Fatal
          final_msg=$custom_msg%%$technical_msg
          p_fatal=
          ;;
        '#W') # Prepend + Warning
          final_msg=$custom_msg%%$technical_msg
          p_fatal=
          warning=1
          ;;
        '#>') # Replace + Fatal
          final_msg=$custom_msg
          p_fatal=1
          ;;
        '#:') # Replace + Non-Fatal
          final_msg=$custom_msg
          p_fatal=
          ;;
        '#w') # Replace + Warning
          final_msg=$custom_msg
          p_fatal=
          warning=1
          ;;
        *)    # Default (no tag found)
          final_msg=$technical_msg
          p_fatal=1
          ;;
      esac

      if [[ $warning ]]; then
        warn "$final_msg"
      else
        indent_multiline final_msg
        echo "${X:-}ERROR @$line: $final_msg" >&2
        [[ $tag ]] || show_traceback >&2
      fi
      ;;
    TRAP-INT)
      echo "${W} Interrupted by user (SIGINT) @$line while executing '$p_command'" >&2
      p_fatal=1
      exit_target=130
      ;;
    TRAP-TERM)
      echo "${W} Terminated by signal (SIGTERM) @$line while executing '$p_command'" >&2
      p_fatal=1
      exit_target=143
      ;;
    "")
      ;;
    *)
      indent_multiline msg
      echo "${X}ERROR +$line: $msg" >&2
      ;;
  esac

  if [[ $p_fatal ]]; then
    echo "Aborted." >&2
    exit $exit_target
  fi

  unset ERROR_HANDLED

  [[ $original_traps ]] && eval "$original_traps"
  return 0 # allow to use error() as soft error handler without adding ||true to avoid trap ERR and recursion
}

# Expand $var, $(command) and `command`. Safe for ";'" and so on.
# Usage: expanded_cmd=$(safe_expand "$raw_cmd")
safe_expand() {
  local raw=$1 expanded IFS=$' \t\n'
  local -; set +o nounset
  eval $'read -r -d "" expanded <<Q29sZXR0aQ ||true\n'"$raw "$'\nQ29sZXR0aQ'
  printf %s "$expanded"
}

# Expand only $var, not $(command) nor `command`. Safe for ";'" and so on.
# Returns empty string if not authenticated.
# Usage: expanded_cmd=$(safer_expand "$raw_cmd")
safer_expand() {
  has_auth || return 0
  local raw=$1 expanded IFS=$' \t\n'
  raw=${raw//\`/\\\`}; raw=${raw//\$\(/\\\$\(}
  local -; set +o nounset
  eval $'read -r -d "" expanded <<Q29sZXR0aQ ||true\n'"$raw "$'\nQ29sZXR0aQ'
  printf %s "$expanded"
}

show_traceback() {
  echo "  Traceback:"
  local i= len=
  for (( i=2, len=${#FUNCNAME[@]}; i<len; i++ )); do
    echo "    [$((len-i))] ${FUNCNAME[$i]}:${BASH_LINENO[$((i-1))]}"
  done
}

warn() {
  local msg=$1
  indent_multiline msg
  echo "$W Warning: $msg" >&2
}

indent_multiline() { # 771 μs
  local -n _ref=$1
  local -a lines
  local i

  mapfile -t lines <<< "${_ref//%%/$'\n'}"

  for ((i=1; i < ${#lines[@]}; i++)); do
    lines[i]="  ${lines[i]#${lines[i]%%[![:space:]]*}}"
  done

  local IFS=$'\n'; _ref="${lines[*]}"
}

_profiler() {
  local trace_funcs fn mu=$'\u03bc'

  # Get all other functions
  trace_funcs=$(compgen -A function | grep -v "^_profiler$")

  for fn in $trace_funcs; do
    # In-memory rename each function $fn to orig_$fn
    eval "$(declare -f "$fn" | sed "1s/^$fn[[:space:]]*()/orig_$fn ()/")"

    # Wrap orig_$fn with a cronometer function $fn
    eval "$fn() {
      local indent start_time end_time duration ret=
      printf -v indent '%*s' \"\${#FUNCNAME[@]}\"
      printf '%s\n' \"\${indent}+ \${EPOCHREALTIME} \${LINENO} \${FUNCNAME[0]}() START\" >&2
      start_time=\${EPOCHREALTIME}

      # profiler overhead is about 10 μs on WSL2 running in Windows 10 running on Intel(R) Core(TM) i7-7700K CPU @ 4.20GHz
      orig_$fn \"\$@\"; ret=\$?

      end_time=\${EPOCHREALTIME}; duration=\$(( \${end_time/./} - \${start_time/./} ))
      printf '%s\n' \"\${indent}- \${end_time} \${LINENO} \${FUNCNAME[0]}() END (Ret: \$ret) [Duration: \${duration} ${mu}s]\" >&2
      return \$ret
    }"
  done
}

