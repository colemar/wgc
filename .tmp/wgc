# Guard against sourcing.
[[ "${BASH_SOURCE[0]}" == "$0" ]] || return 1

doit() {
  # Set safe/trusted PATH
  local ORIG_PATH=$PATH
  export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

  if [ -z "$BASH_VERSION" ]; then
    echo "ERROR: This script requires Bash. Please run with 'wgc'." >&2
    exit 1
  fi
  if ((BASH_VERSINFO[0] < 4)) || ((BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4)); then
    echo "ERROR: Bash 4.4 or newer is required (found $BASH_VERSION)." >&2
    exit 1
  fi

  # Sanitized auto-elevation
  if [[ ! $UID == 0 ]]; then
    PATH=$ORIG_PATH # restore original PATH because exec_in_namespace() recovers it
    exec sudo WGC_CFGDIR="$WGC_CFGDIR" BASH_ENV= ENV= CDPATH= IFS= "$0" "$@"
  fi
  # unset fails when readonly, so use exec env -i
  [[ ${BASH_ENV:-}${ENV:-}${CDPATH:-} ]] && \
    exec /usr/bin/env -u BASH_ENV -u ENV -u CDPATH "$0" "$@"

  set +vx
  [[ ${1:-} == trace ]] && { set -vx; shift; }

  # Shell state baseline
  set +abefhkmnptuBCEHPT
  shopt -u $(shopt | awk '/[[:space:]]on$/{print $1}')
  # What I want
  set +o posix       # Turn off Posix standard
  set -o hashall     # Remember the location of commands as they are looked up.
  set -o braceexpand # Perform brace expansion.
  set -o nounset     # Treat unset variables as an error.
  set -o pipefail    # Return value of a pipeline is the status of the last command to exit with a non-zero status.
  set -o errexit   # Exit immediately if a command exits with a non-zero status.
  set -o errtrace  # Trap ERR is inherited by functions.
  trap 'error TRAP fatal' ERR
  shopt -s extglob   # Enable extended glob patterns: x(y)
  shopt -s nullglob  # Patterns which match no files expand to a null string
  shopt -s checkwinsize extquote
  export LC_ALL=C LANG=C
  local IFS=$' \t\n'

  (( $# == 0 )) && { show_usage; exit; }

  local -r CMD=${1:-} VPN=${2:-}
  local DEV=wgc_${VPN:-}
  local NAMESPACE=$DEV

  local W X Y HAS_COLORS; local -A COLORS; set_markers; readonly W X Y HAS_COLORS COLORS
  local CFGDIR; set_cfgdir; readonly CFGDIR
  local IS_CONNECTED HAS_NAMESPACE IN_NAMESPACE IS_WGC
  local Address PrivateKey PublicKey Endpoint AllowedIPs DNS MTU ListenPort PersistentKeepalive PresharedKey
  local -a WGC_BRIDGES

  case "$CMD" in
    up|upd|n|nu|nup|d|do|dow|down|s|st|sta|stat|state|e|ex|exe|exec)
      validate_vpn_name
      local ns=$(ip netns identify) || true
      [[ $ns ]] && error "Usage of wgc is not supported inside a network namespace ($ns)" fatal
      ;;
    c|co|con|conf|p|pa|par|pars|parse)
      validate_vpn_name
      ;;
  esac

  case "$CMD" in
    c|co|con|conf)
      show_config_file
      ;;
    p|pa|par|pars|parse)
      show_parsed_config_file
      ;;
    up)
      start_vpn
      ;;
    upd)
      start_vpn override_default_route
      ;;
    n|nu|nup)
      start_vpn use_namespace
      ;;
    d|do|dow|down)
      stop_vpn ${3:-} # can be "force"
      ;;
    s|st|sta|stat|state)
      show_state bridges
      ;;
    e|ex|exe|exec)
      shift 2
      exec_in_namespace "$@"
      ;;
    a|ac|act|acti|activ|active)
      show_active_vpns
      ;;
    l|li|lis|list)
      list_config_files
      ;;
    r|re|req)
      check_dependencies
      ;;
    completion)
      enable_completion
      ;;
    openresolv)
      install_forced_openresolv
      ;;
    remopenresolv)
      remove_openresolv
      ;;
    null)
      :
      ;;
    f)
      "${@:2}"
      ;;
    ft)
      PS4='+${LINENO}:${FUNCNAME[0]}: '
      shopt -s promptvars
      set -vx; "${@:2}"
      ;;
    *)
      show_usage
      ;;
  esac
}

show_usage() {
  cat <<EOF
Usage:
  wgc <command> [<vpn>]
  wgc exec <vpn> <command>

Core Commands:
  up <vpn>    - Start VPN in Split Tunnel mode.
                (Uses AllowedIPs, but ignores 0.0.0.0/0 to keep default gateway)
  upd <vpn>   - Start VPN in Full Tunnel mode overriding default gateway.
                (Forces all traffic through VPN via override routes 0/1, 128/1)
  nup <vpn>   - Start VPN in a dedicated Network Namespace (isolated stack).
  down <vpn>  - Stop the VPN and clean up routes.

Inspection & Utils:
  state <vpn> - Show detailed state of a specific VPN.
  active      - List only active VPN interfaces.
  list        - List all available config files.
  conf <vpn>  - Display the content of <vpn>.conf.
  parse <vpn> - Check syntax and show parsed parameters for <vpn>.conf.
  req         - Verify that required dependencies are installed.

Execution:
  exec <vpn>  - Run a command inside the VPN Network Namespace.
                (Only valid if VPN was started with 'nup')
                Example, run 'curl ipinfo.io' in 'office' VPN namespace:
                  wgc exec office curl ipinfo.io

Configuration:
  <vpn> must match a file in \$WGC_CFGDIR (Default: /etc/wireguard).
  Example: 'office' matches '/etc/wireguard/office.conf'.
  Export WGC_CFGDIR to override the default configuration directory.

Bash Completion:
  To enable bash completion: wgc completion
  Redo completion if WGC_CFGDIR is changed.
EOF
}

# Minimalist argument parser helper.
# Maps arguments of the form 'name=value' to readonly local variables prefixed with 'p_'.
#
# Usage Protocol:
# 1. Consume and shift out all initial fixed positional arguments.
# 2. Define default values for optional parameters as local variables with 'p_' prefix.
# 3. Execute: eval "$(get_params "$@")" to parse and overwrite defaults.
#
# Argument Syntax:
# - name=value  -> Sets p_name to "value".
# - name        -> Sets p_name to "name" (Flag mode, equivalent to name=name).
#
# Constraints & Responsibilities:
# 1. Caller: Must ensure passed argument keys are valid Bash identifiers (alphanumeric/underscore)
#    to avoid syntax errors during assignment.
# 2. Function Implementation: Must NOT use local variables starting with 'p_' for internal logic,
#    as this namespace is reserved for the generated parameters.
#
# Example:
#   func() {
#     shift 1                        # Remove fixed arguments if any
#     local p_timeout=10 p_verbose=  # Define defaults (mutable)
#     eval "$(get_params "$@")"      # Parse arguments, override defaults and lock variables (readonly)
#     echo "Timeout: $p_timeout"
#     [[ $p_verbose ]] && echo "Verbose active"
#   }
#   func arg1 timeout=30 verbose
#
get_params() {
  local arg key buf=
  local -i n=1
  for arg; do
    key=${arg%%=*}
    buf+=" p_$key=\${$n#*=}"
    ((n++))
  done
  echo "${buf:+local -r}$buf"
}

set_markers() {
  Y=$'\u2713'
  X=$'\u274C'
  W=$'\u2717'
  # Detect if terminal supports colors
  HAS_COLORS=
  if [[ -t 1 ]] && (($(tput colors 2>/dev/null || echo 0) >= 8)); then
    Y=$'\e[1;32m'$Y$'\e[m' # green CHECK MARK
    X=$'\e[1;31m'$X$'\e[m' # red CROSS MARK
    W=$'\e[1;31m'$W$'\e[m' # red BALLOT X
    HAS_COLORS=1
  fi
  # colors
  # 0:Black(Ash), 1:Red, 2:Green, 3:Yellow, 4:Blue, 5:Magenta, 6:Cyan, 7:White
  local chars=argybmcw i k
  for ((i=0; i<8; i++)); do
    k=${chars:i:1}
    COLORS[$k]=$'\e[0;3'$i'm'    # Lowercase: Normal
    COLORS[${k^}]=$'\e[1;3'$i'm' # Uppercase: Bold/Bright
  done
  COLORS[/]=$'\e[m'
}

# prc - Print with color - A wrapper around printf
# Usage: prc [FORMAT] [ARGS...]
#
# If +x is one of +[ARGYBMCWargybmcw/], color is applied as follows:
#   Bright color: A:gray R:red G:green Y:yellow B:blue M:magenta C:cyan W:white
#   Normal color: a      r     g       y        b      m         c      w
#   Reset color: /
# COLORS array maps letters to ANSI color codes.
#
# FORMAT: printf-style format string (default: %s) plus +x syntax.
#
# In short, it works exactly as printf, with these exceptions:
# - In addition to %x format characters it recognizes +x format codes.
# - If x in +x is not a color code, it results in x (e.g. ++ == +).
# - If FORMAT is empty, format %s is assumed.
# - If there is only arg $1, it is printed literally (no orphaned format specifiers).
#
# Examples:
#   prc "+R%s+/\n" "Error: 234"    # prints "Error: 234" in Bright Red + newline
#   prc "+RError: %d+/\n" 234      # equivalent
#   prc +R%s+/ "Error: 234"        # prints "Error: 234" in Bright Red
#   prc +R%s%d+/ "Error: " 0xEA    # equivalent
#   prc "+R%s +Y%d+/" "Error:" 234 # prints a red "Error: " followed by a yellow 234
#   prc +g%s+/ Success             # prints "Success" in Normal Green
#   prc "+gSuccess+/"              # prints "+gSuccess+/" without ANSI color codes
#   prc "%dSuccess"                # prints "%dSuccess"
#   prc "%d files\n" 42            # prints "42 files" with no color + newline
#
prc() {
  local fmt=$1 l r k

  if (( $# > 1 )); then
    fmt=$fmt+ # fmt is indeed a format, append sentinel character
    while : ; do
      k=${fmt%%+*}   # k = anything before +
      r=${fmt#"$k+"} # r = anything after +
      l+=$k
      [[ $r ]] || break
      k=${COLORS[${r:0:1}]:-}
      if [[ $k ]]; then
        # char after + is a color code and $k is the corresponding ANSI code
        l+=${HAS_COLORS:+$k}
      else
        # +x where x is not a color code means x (++ is about the only real-world case)
        l+=${r:0:1}
      fi
      fmt=${r:1} # consider remaining fmt
    done
    l=${l:-%s}
    shift # adjust "$@"
  else
    # fmt is a message -> set default format
    l=%s
  fi

  printf "$l" "$@"
}

set_cfgdir() {
  CFGDIR=${WGC_CFGDIR:-/etc/wireguard}
  # Validate directory
  [[ ! -d "$CFGDIR" ]] && \
    error "Configuration directory not found: $CFGDIR
          Set WGC_CFGDIR to point to dir containing Wireguard *.conf files." fatal
  if ! ls "$CFGDIR" &>/dev/null; then
    error "Cannot access configuration directory: $CFGDIR
           Possible causes: SELinux, AppArmor, or mount restrictions.
           Debug: sudo ls -ldZ '$CFGDIR' && sudo getenforce" fatal
  fi
  return 0
}

check_dependencies() {
  local missing=()
  for cmd in tput ip wg grep resolvconf mkdir rm ps sleep find curl sed setpriv socat; do
    command -v $cmd >/dev/null || missing+=($cmd)
  done
  if (( ${#missing[@]} > 0 )); then
    error "Missing required commands: ${missing[*]}
           Install with:
           apt install wireguard-tools iproute2 grep sed coreutils \\
           procps findutils openresolv util-linux ncurses-bin" fatal blameparent
  fi
  echo "$Y All required commands are available."
}

has_openresolv() {
  [[ $(resolvconf -h 2>/dev/null) =~ -x[[:blank:]][[:blank:].A-Za-z]*[[:blank:]]exclusive ]]
}

check_openresolv() {
  if ! has_openresolv; then
    local tailmsg='Please run: apt-get install openresolv'
    [[ -d /run/systemd/resolve ]] && tailmsg="This system has systemd-resolved.
      To bypass debian package conflict with openresolv run 'wgc openresolv' instead of 'apt-get install openresolv'.
      To remove openresolv installed by wgc run 'wgc remopenresolv'."
    error "Your version of 'resolvconf' does not support exclusive mode (-x).
           $tailmsg" fatal blameparent
  fi
}

install_forced_openresolv() {
  has_openresolv && error "Openresolv is already installed ('resolvconf' supports exclusive mode -x)." fatal

  [[ -L /usr/sbin/resolvconf ]] ||
    error "Systemd-resolved symlink wrapper for 'resolvconf' NOT detected. Standard installation is possible.
           Please install 'openresolv' using: sudo apt-get install openresolv" fatal

  echo "Forcing openresolv installation..."

  dpkg-divert --list | grep "/usr/sbin/resolvconf" > /dev/null || {
    echo "Diversion of resolvconf binary..."
    dpkg-divert --divert /usr/sbin/resolvconf.systemd --rename --add /usr/sbin/resolvconf
  }

  local TEMP_DIR=$(mktemp -d)
  mkdir -p "$TEMP_DIR"
  cd "$TEMP_DIR" || return 1

  apt-get download openresolv 2>/dev/null
  local DEB_FILE=$(find . -name "openresolv*.deb" | head -n 1)
  if [[ $DEB_FILE ]]; then
    echo "Download via APT successful."
  else
    echo "APT download failed (package 'openresolv' likely missing)."
    echo "Attempting download via Debian Unstable Packages index..."
    local IDX_URL="https://ftp.debian.org/debian/dists/stable/main/binary-all/Packages.gz"
    local REL_PATH=$(curl -s "$IDX_URL" | \
          zgrep -m 1 "^Filename: .*openresolv_.*_all.deb" | cut -d ' ' -f 2)
    if [[ -z $REL_PATH ]]; then
      echo "Error: Could not find openresolv in Debian index."
      echo "Tried searching: $IDX_URL"
      echo "This may indicate the package has been removed or renamed."
      cd .. && rm -rf "$TEMP_DIR"
      return 1
    fi
    local FULL_URL="https://ftp.debian.org/debian/$REL_PATH"
    DEB_FILE=$(basename "$REL_PATH")
    echo "Detected version: $DEB_FILE"
    wget -O "$DEB_FILE" "$FULL_URL" || {
      echo "Download failed: $FULL_URL"
      cd .. && rm -rf "$TEMP_DIR"
      return 1
    }
  fi

  echo "Creating file manifest..."
  mkdir -p /etc/wwggcc

  dpkg-deb --fsys-tarfile "$DEB_FILE" | tar -tf - | grep -v '/$' | sed 's|^./|/|' > /etc/wwggcc/openresolv.files

  echo "Extracting directly to system..."
  dpkg-deb --fsys-tarfile "$DEB_FILE" | tar --keep-directory-symlink --no-overwrite-dir -xC /

  cd ..
  rm -rf "$TEMP_DIR"

  echo "Detecting DNS backend..."
  if [[ -d /run/systemd/resolve ]]; then
    echo "Systemd-resolved detected. Appending configuration."
    if ! grep -q "name_servers=\"127.0.0.53\"" /etc/resolvconf.conf; then
      {
        echo ""
        echo "# Added by wgc installer for systemd-resolved compatibility"
        echo "name_servers=\"127.0.0.53\""
        echo "resolv_conf_options=\"trust-ad\""
      } >> /etc/resolvconf.conf
    else
      echo "Configuration already present. Skipping."
    fi
  else
    echo "Systemd-resolved NOT detected. Leaving standard configuration."
  fi

  echo "Regenerating resolvconf..."
  /sbin/resolvconf -u

  if command -v mandb >/dev/null; then
    echo "Updating the manual page index caches..."
    mandb -pq
  fi

  echo "Openresolv forced successfully."
  echo "Manifest saved to /etc/wwggcc/openresolv.files"
  echo "To remove openresolv: wgc remopenresolv"
}

remove_openresolv() {
  local MANIFEST=/etc/wwggcc/openresolv.files

  echo "Removing openresolv..."

  dpkg-divert --list | grep "/usr/sbin/resolvconf" > /dev/null ||
    error "No package diversion found. Assuming standard APT management.
           To uninstall 'openresolv', please use: sudo apt remove openresolv" fatal

  echo "Removing diversion of resolvconf binary..."
  rm -f /usr/sbin/resolvconf
  dpkg-divert --rename --remove /usr/sbin/resolvconf

  if [[ -f "$MANIFEST" ]]; then
    echo "Deleting installed files..."
    cat "$MANIFEST" | tr '\n' '\0' | xargs -0 rm -f
    rm -f "$MANIFEST"
  else
    echo "Warning: Manifest $MANIFEST not found. Trying generic cleanup..."
    rm -f /usr/sbin/resolvconf
    rm -rf /usr/lib/resolvconf
    rm -f /etc/resolvconf.conf
  fi

  rmdir /usr/lib/resolvconf 2>/dev/null || true

  echo "Restoring systemd-resolved symlink /etc/resolv.conf..."
  if [[ -f /etc/resolv.conf ]] && [[ ! -L /etc/resolv.conf ]]; then
    rm -f /etc/resolv.conf
    ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf
  fi

  echo "Restoring systemd-resolved resolvconf symlink wrapper..."
  rm -f /usr/sbin/resolvconf
  ln -sf /usr/bin/resolvectl /usr/sbin/resolvconf

  if command -v mandb >/dev/null; then
    echo "Updating the manual page index caches..."
    mandb -pq
  fi

  echo "Done. System returned to APT management."
}

list_config_files() {
  local f= g=
  echo -e "Looking in $CFGDIR\n"
  prc "+W%-12s %-4s %-18s %-29s %s+/\n" Name Br. Address Endpoint AllowedIPs
  prc "+A%-12s %-4s %-18s %-29s %s+/\n" ---- --- ------- -------- ----------
  for f in "$CFGDIR"/*.conf; do
    g=${f##*/}; g=${g%.*}
    [[ $g =~ wg[0-9]+ ]] && continue # exclude wg0, wg1, wg2 ...
    parse_config_file "$g" bridges relax || continue
    (( ${#Endpoint} > 29 )) && Endpoint="${Endpoint:0:27}.."
    prc "+c%-12s +y%-4s +m%-18s +r%-29s +g%s+/\n" "$g" ${#WGC_BRIDGES[@]} "$Address" "$Endpoint" "$AllowedIPs"
  done
}

show_config_file() {
  local -r config_file="$CFGDIR/$VPN.conf"
  [[ -f $config_file ]] || error "Not a file: $config_file"
  [[ -r $config_file ]] || error "Cannot read file: $config_file"
  printf %s\\n "$(< $config_file)"
}

show_parsed_config_file() {
  parse_config_file $VPN bridges report
  show_config
}

show_config() {
  echo
  prc "+W%-20s%s+/\n" Key  Value
  prc "+A%-20s%s+/\n"     ---- -----
  local pub val
  for k in Address DNS MTU ListenPort PrivateKey PublicKey PresharedKey Endpoint AllowedIPs PersistentKeepalive; do
    val=${!k:-(missing)}
    [[ $k == PrivateKey && ${!k} ]] && val="<HIDDEN>"
    prc "+c%-20s+Y${!k:++/}%s+/" $k "$val"
    if [[ $k ==  P*Key && ${!k} ]]; then
      if pub=$(wg pubkey <<<${!k} 2>/dev/null); then
        [[ $k == PrivateKey ]] && prc "\n+A└── %-15s+/ %s" "PUBLIC" "$pub"
      else
        prc " $W +R%s+/ " invalid
      fi
    fi
    [[ $k == @(Address|PrivateKey|PublicKey|Endpoint|AllowedIPs) && ! ${!k} ]] && prc " $W +R%s+/ " required
    printf "\n"
  done
  if (( ${#WGC_BRIDGES[@]} > 0 )); then
    echo
    local bridge_data b_name b_ext b_int
    prc "+W%-20s%s+/\n" "Forwarding Bridge" "ExtPort -> IntPort"
    prc "+A%-20s%s+/\n"      -----------------   ------------------
    for bridge_data in "${WGC_BRIDGES[@]}"; do
      IFS=: read -r b_name b_ext b_int <<<"$bridge_data"
      prc "+y%-19s+/ %s +A%s+/ %s\n" "$b_name" "$b_ext" "->" "$b_int"
    done
  fi
  echo
}

is_valid_port() {
  local p=$1
  [[ $p =~ ^[0-9]+$ ]] && ((p >= 1 && p <= 65535))
}

parse_config_file() {
  local -r config_file="$CFGDIR/$1.conf"
  shift 1
  local p_relax= p_bridges= p_report=
  eval "$(get_params "$@")"

  local fatal=fatal; [[ $p_relax ]] && fatal=

  [[ -f "$config_file" ]] || { error "Config file not found: $config_file" $fatal blameparent; return 1; }
  [[ -r "$config_file" ]] || { error "Can't read file: $config_file" $fatal blameparent; return 1; }
  local line= n=0 s=0 section= key= value= ISSUES= BADSECTION=BADSECTION
  Address= PrivateKey= PublicKey= Endpoint= AllowedIPs= DNS= MTU= ListenPort= PersistentKeepalive= PresharedKey=
  WGC_BRIDGES=()
  local -A USED_BRPORTS=() USED_BRNAMES=()
  while read -r line || [[ $line ]]; do # also read last line if \n is missing
      ((++n))
      line=${line%%#*} # Remove comments
      [[ ! $line =~ [^[:space:]] ]] && continue # Skip empty lines
      if [[ $line =~ ^[[:space:]]*(\[[A-Za-z0-9_-]+\])[[:space:]]*$ ]]; then
        section=${BASH_REMATCH[1]} # Track section
        s=$n # remember section line number
        continue
      fi
      # Skip lines in bad sections (even before all sections)
      [[ $section == "$BADSECTION" ]] && continue
      # Parse key=value with flexible spacing
      if [[ $line =~ ^[[:space:]]*([A-Za-z0-9]+)[[:space:]]*=[[:space:]]*(.*[^[:space:]]) ]]; then
        key=${BASH_REMATCH[1]}   # key without spaces
        value=${BASH_REMATCH[2]} # value trimmed
      else # Not a key=value line
        ISSUES+=$'\n'"Malformed line $n: ${line:0:50}$( ((${#line} > 50)) && echo ... || true )"
        continue
      fi
      # Get values according to section/key
      process_config_line $s $n "$key" "$value" "$section"
  done < "$config_file"
  if [[ ! $p_relax ]]; then
    for n in Address PrivateKey PublicKey Endpoint AllowedIPs; do
      [[ ${!n} ]] || \
        if [[ $p_report ]]; then
          ISSUES+=$'\n'"Missing required key '$n'"
        else
          error "Missing required key '$n' in file $config_file" fatal blameparent
        fi
    done
    [[ $ISSUES ]] && warn "Issues in $config_file:$ISSUES" || true
  fi
}

process_config_line() {
  local s=$1 n=$2 key=$3 value=$4 section=$5

  case "$section" in
    "[Interface]")
      case "$key" in
        Address) extract_ipv4 "$value" Address ;;
        DNS) extract_all_ipv4 "$value" ' ' DNS ;;
        MTU) MTU=$value ;;
        PrivateKey) PrivateKey=$value ;;
        ListenPort) ListenPort=$value ;;
        *) ISSUES+=$'\n'"Unknown key '$key' in section '$section' at line $n" ;;
      esac
      ;;
    "[Peer]")
      case "$key" in
        AllowedIPs) extract_all_ipv4 "cidr$value" ',' AllowedIPs ;;
        Endpoint) Endpoint=$value ;;
        PersistentKeepalive) PersistentKeepalive=$value ;;
        PresharedKey) PresharedKey=$value ;;
        PublicKey) PublicKey=$value ;;
        *) ISSUES+=$'\n'"Unknown key '$key' in section '$section' at line $n" ;;
      esac
      ;;
    "[WGC-Bridges]")
      [[ $p_bridges ]] || return 0
      # Sintax: <bridgename> = <externalport>-<internalport>
      # Example: qBittorrent = 8765-8765
      if [[ ! $key =~ ^[a-zA-Z0-9_-]+$ ]]; then
        ISSUES+=$'\n'"Invalid bridge name '$key' at line $n (chars allowed: A-Z, a-z, 0-9, _, -)"
        return
      fi
      if [[ -v USED_BRNAMES[$key] ]]; then
        ISSUES+=$'\n'"Duplicate bridge name '$key' at lines $n and ${USED_BRNAMES[$key]}"
        return
      fi
      if [[ $value =~ ^([0-9]+)[[:space:]]*-[[:space:]]*([0-9]+)$ ]]; then
        local ext_port="${BASH_REMATCH[1]}"
        local int_port="${BASH_REMATCH[2]}"
        if ! is_valid_port $ext_port || ! is_valid_port $int_port; then
          ISSUES+=$'\n'"Invalid port at line $n (must be 1-65535): $value"
          return
        fi
        if [[ -v USED_BRPORTS[$ext_port] ]]; then
          ISSUES+=$'\n'"Duplicate external port $ext_port for bridge '$key' at line $n (already used by '${USED_BRPORTS[$ext_port]}')"
          return
        fi
        USED_BRNAMES[$key]=$n
        USED_BRPORTS[$ext_port]=$key
        WGC_BRIDGES+=("$key:$ext_port:$int_port")
      else
        ISSUES+=$'\n'"Invalid bridge format '$value' at line $n. Use: external-internal (e.g., 4321-1234)"
      fi
      ;;
    *)
      BADSECTION=$section
      ISSUES+=$'\n'"Unknown section '$section' at line $s"
      ;;
  esac
}

extract_ipv4() {
  local _in=$1
  local -n _out=$2
  local _regex='([0-9]{1,3}\.){3}[0-9]{1,3}(/[0-9]+)?'
  [[ $_in =~ $_regex ]] && _out="${BASH_REMATCH[0]}" || _out=
}

extract_all_ipv4() {
  local _in=$1
  local _sep=${2:- }
  local -n _out=$3
  local _regex='([0-9]{1,3}\.){3}[0-9]{1,3}'
  [[ "$_in" == cidr* ]] && _regex+='(/[0-9]+)?'
  HAS_DEFAULT_ROUTE=
  while [[ $_in =~ $_regex ]]; do
    [[ ${BASH_REMATCH[0]} == "0.0.0.0/0" ]] && HAS_DEFAULT_ROUTE=1
    _out+="$_sep${BASH_REMATCH[0]}"
    # Remove found match and go on
    _in=${_in#*"${BASH_REMATCH[0]}"}
  done
  _out=${_out#$_sep} # Remove initial separator if present
}

has_namespace() {
  [[ -f /run/netns/$NAMESPACE || -f /var/run/netns/$NAMESPACE ]]
}

is_connected() {
  IS_CONNECTED= HAS_NAMESPACE= IN_NAMESPACE=

  has_namespace && HAS_NAMESPACE=$NAMESPACE
  if ip -br link show $DEV &>/dev/null; then
    IS_CONNECTED=default
    return 0
  fi
  [[ $HAS_NAMESPACE ]] || return 1
  ip netns exec $NAMESPACE ip -br link show $DEV &>/dev/null || return 1
  IS_CONNECTED=$NAMESPACE; IN_NAMESPACE=$NAMESPACE
  return 0
}

show_active_vpns() {
  local x= ns= dev= net= found=
  echo
  echo "Active VPNs in default namespace:"
  for x in $(wg show interfaces); do
    [[ $x == wgc_* ]] || continue
    if read -r dev x net < <(ip -br -c address show $x 2>/dev/null); then
      found=1
      echo $dev $net
    fi
  done
  [[ $found ]] || echo "  (none)"
  found=
  echo
  echo "Active VPNs in other namespaces:"
  while read -r ns x; do
    dev=$ns
    if ip netns exec $ns wg show $dev &>/dev/null && \
    read -r dev x net < <(ip netns exec $ns ip -br -c address show $dev 2>/dev/null); then
      found=1
      echo $dev $net
    fi
  done < <(ip netns list 2>/dev/null)
  [[ $found ]] || echo "  (none)"
  echo
}

kill_processes() {
  local pids=$1
  echo -e "Terminating processes:\n$(ps -fp $pids)"
  kill $pids &>/dev/null || true
  # paint increasing bar for timeout
  local h= d= timeout=10 # seconds
  eval printf -v d "$'\u2591'%.0s" {1..$((timeout*2))} # timeout*2 LIGHT SHADEs in d
  echo -ne "\033[?25l" # hide cursor
  while [[ "$pids" && "$d" ]]; do
    sleep 0.5
    pids=$(ip netns pids $NAMESPACE 2>/dev/null)
    d=${d%$'\u2591'} # remove one LIGHT SHADE
    echo -ne "\r$h$d" # paint the bar over itself
    h+=$'\u2588' # append a FULL BLOCK
  done
  echo -ne "\r\033[K\033[?25h" # delete bar and restore cursor
  if [[ -z "$d" ]]; then # timeout
    echo "Forcibly terminating processes (SIGKILL)"
    kill -9 $pids &>/dev/null || true
    sleep 0.1
    # check again
    pids=$(ip netns pids $NAMESPACE 2>/dev/null)
    [[ $pids ]] && warn "Processes still running: $pids" || true
  fi
}

is_valid_ident() {
  local "$1" &>/dev/null
}

exec_in_namespace() {
  [[ $# -eq 0 ]] && { error "No command specified"; show_usage; exit 1; }
  is_connected || error "VPN $VPN is not connected. Start it first with: wgc nup $VPN" fatal
  [[ $IN_NAMESPACE ]] || error "VPN $VPN is not in its own namespace. Just use plain command: $*" fatal

  if [[ $(</proc/$PPID/comm) == sudo ]]; then
    # wgc auto-elevated or executed with sudo.
    # sudo inherits and sanitizes the original environment (depending on the active security policy) before executing wgc.

    command -v setpriv >/dev/null || error "Missing command 'setpriv'" fatal
    [[ ${SUDO_UID:-} ]] || error "Unable to determine invoking user (SUDO_UID missing)" fatal
    [[ ${SUDO_GID:-} ]] || error "Unable to determine invoking group (SUDO_GID missing)" fatal

    # Retrieve the Grandparent PID (field 4 of parent's stat).
    # This identifies the correct source for the unsanitized environment:
    # 1. Modern sudo (PTY mode): It targets the main sudo process (which holds the original env).
    # 2. Legacy sudo: It targets the invoking shell directly.
    # In both cases, reading this PID's environ bypasses the sanitization applied by the direct parent.
    local grandpa_pid var_eq_val var
    read -r _ _ _ grandpa_pid _ < /proc/$PPID/stat # get sudo pid
    # Build the environment for the final command
    local -a FINAL_ENV
    while IFS= read -r -d '' var_eq_val; do
      var=${var_eq_val%%=*}
      [[ $var == @(PWD|_) ]] && continue
      FINAL_ENV+=("$var_eq_val")
    done < /proc/$grandpa_pid/environ

    # Append the actual current PWD.
    # wgc inherited the correct working directory from sudo (whether preserved or changed via sudo -i),
    # so $PWD holds the authoritative value.
    FINAL_ENV+=("PWD=$PWD")

    # Final command
    local PAYLOAD=(setpriv --reuid $SUDO_UID --regid $SUDO_GID --init-groups env -i "${FINAL_ENV[@]}" "$@")
  else
    [[ ${PKEXEC_UID:-} || ${DOAS_USER:-} ]] && \
      error "Elevation detected but not supported (pkexec/doas).
             Please use 'sudo wgc ...'" fatal
    # wgc direct execution by root: no user/env switch needed
    local PAYLOAD=("$@")
  fi

  # Execution with Anti-Leak protection (NSCD)
  # If we are in a VPN namespace with custom DNS and the host's nscd socket exists,
  # we must hide it to prevent glibc from using it and ignoring our DNS configuration.
  local nscd_fix
  if nscd_fix=$(get_nscd_fix_cmd); then
    # Use an ephemeral mount namespace (unshare -m) to hide the socket.
    # 'mount -t tmpfs' is safer than bind mounting on existing directories.
    # Pass PAYLOAD as positional arguments to bash to avoid quoting issues.
    exec ip netns exec $NAMESPACE \
      unshare -m \
      /bin/bash -c "$nscd_fix"' && exec "$@"' -- "${PAYLOAD[@]}"
  else
    # No leak risk or nscd not present
    exec ip netns exec $NAMESPACE "${PAYLOAD[@]}"
  fi
}

get_nscd_fix_cmd() {
  [[ -f /etc/netns/$NAMESPACE/resolv.conf ]] || return 1

  local cmd= found=

  if [[ -S /var/run/nscd/socket ]]; then
    cmd+="mount -t tmpfs -o size=1M,mode=755 none /var/run/nscd && "
    found=1
  fi
  if [[ -S /run/nscd/socket ]]; then
    cmd+="mount -t tmpfs -o size=1M,mode=755 none /run/nscd && "
    found=1
  fi

  if command -v systemctl &>/dev/null && systemctl is-active -q nscd 2>/dev/null; then
    warn "nscd service is active: applying isolation (socket mask + nsswitch override).
          Warning: DNS leaks still possible if host nscd restarts during VPN usage."
    found=1
  fi

  [[ $found ]] || return 1

  cmd="mount --make-rprivate / 2>/dev/null && $cmd"

  local nss_content=
  if [[ -r /etc/nsswitch.conf ]]; then
    nss_content=$(sed -E 's/[[:space:]]*\b(nscd|sss)\b//g' /etc/nsswitch.conf)
  fi
  if [[ -z $nss_content ]]; then
    nss_content=$'passwd: files\ngroup: files\nhosts: files dns\nnetworks: files'
  fi
  nss_content=$'# Generated by wgc (nscd/sss removed to prevent DNS leaks)\n'$nss_content
  cmd+="printf '%s' ${nss_content@Q} > /run/nsswitch.wgc && "
  cmd+="mount --bind /run/nsswitch.wgc /etc/nsswitch.conf && "

  echo "${cmd% && }"
  return 0
}

validate_ipv4_kern() {
  local ip=$1
  ip -4 rule add to "$ip" &>/dev/null || return 1
  ip -4 rule del to "$ip" &>/dev/null || true
}

validate_ipv4() {
  # Define a single octet
  # 25[0-5]     -> 250-255
  # 2[0-4][0-9] -> 200-249
  # 1[0-9][0-9] -> 100-199
  # [1-9]?[0-9] -> 0-99
  local oct="(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])"
  local regex="^$oct\.$oct\.$oct\.$oct$"
  [[ $1 =~ $regex ]]
}

enable_completion() {

  local completion_dir=
  for completion_dir in /etc/bash_completion.d /usr/share/bash-completion/completions ""; do
    [[ -d "$completion_dir" ]] && break
  done
  [[ $completion_dir ]] || error "Cannot find bash completion directory" fatal
  local completion_file="$completion_dir/wgc"

  cat > "$completion_file" << 'EOF'
_wgc_completion() {
  local cur= prev= commands=
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"

  # Main commands
  commands="conf parse up upd nup down state active list exec req"

  # Complete the first arg with main commands
  if [[ $COMP_CWORD -eq 1 ]]; then
    COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
    return 0
  fi

  # Complete the second arg depending on command
  if [[ $COMP_CWORD -eq 2 ]]; then
    case "$prev" in
      up|upd|n|nu|nup|c|co|con|conf|p|pa|par|pars|parse)
        # VPN config file list
        local v
        local modtime=$(stat -c %y "${WGC_CFGDIR:-/etc/wireguard}" 2>/dev/null)
        if [[ ! $_wgc_last_cfgdir_modtime || $modtime != "$_wgc_last_cfgdir_modtime" ]]; then
          _wgc_last_cfgdir_modtime=$modtime
          local -a c=( /usr/bin/find "${WGC_CFGDIR:-/etc/wireguard}" -maxdepth 1 -name \*.conf -type f )
          local -a files
          files=($("${c[@]}" 2>/dev/null)) || files=($(sudo "${c[@]}" 2>/dev/null)) || return 1
          local f
          for f in "${files[@]}"; do
            f=${f##*/}; f=${f%.*}
            [[ $f =~ wg[0-9]+ ]] && continue # exclude wg0, wg1, wg2 ...
            v+="$f "
          done
          _wgc_last_cfgdir_list=$v
        else
          v=$_wgc_last_cfgdir_list
        fi
        COMPREPLY=( $(compgen -W "$v" -- "$cur") )
        ;;
      d|do|dow|down|s|st|sta|stat|state)
        # Active VPNs in default namespace
        local -a ifaces
        ifaces=($(wg show interfaces 2>/dev/null)) || ifaces=(sudo $(wg show interfaces 2>/dev/null)) || return 1
        local i v
        for i in "${ifaces[@]}"; do
          [[ $i == wgc_* ]] || continue
          v+="${i#*wgc_} "
        done
        # Active VPNs (namespaces)
        local n
        while read -r n _; do
          [[ $n == wgc_* ]] || continue
          v+="${n#*wgc_} "
        done < <(/usr/sbin/ip netns list 2>/dev/null)
        COMPREPLY=( $(compgen -W "$v" -- "$cur") )
        ;;
      e|ex|exe|exec)
        # Active VPNs (namespaces)
        local n v
        while read -r n _; do
          [[ $n == wgc_* ]] || continue
          v+="${n#*wgc_} "
        done < <(/usr/sbin/ip netns list 2>/dev/null)
        COMPREPLY=( $(compgen -W "$v" -- "$cur") )
        ;;
    esac
    return 0
  fi

  # For exec, after VPN name do complete with system commmands
  if [[ $COMP_CWORD -gt 2 ]]; then
    case "${COMP_WORDS[1]}" in
      e|ex|exe|exec)
        if declare -F _command_offset &>/dev/null; then
          # Use advanced completion if available
          _command_offset 3
        else
          # Fallback to basic completion
          if [[ $COMP_CWORD -eq 3 ]]; then
            COMPREPLY=( $(compgen -c -- "$cur") )
          else
            compopt -o default
            COMPREPLY=()
          fi
        fi
        return 0
        ;;
    esac
  fi
}

complete -F _wgc_completion wgc
EOF

  chmod 644 "$completion_file"

  # Pre-populated cache (generated at install time)
  local f
  _wgc_last_cfgdir_list=
  for f in $(find "$CFGDIR" -maxdepth 1 -name \*.conf -type f); do
    f=${f##*/}; f=${f%.*}
    [[ $f =~ wg[0-9]+ ]] && continue # exclude wg0, wg1, wg2 ...
    _wgc_last_cfgdir_list+="$f "
  done
  _wgc_last_cfgdir_modtime=$(stat -c %y "$CFGDIR" 2>/dev/null)
  printf "%s\n" \
    "_wgc_last_cfgdir_list=${_wgc_last_cfgdir_list@Q}" \
    "_wgc_last_cfgdir_modtime=${_wgc_last_cfgdir_modtime@Q}" >> "$completion_file"

  [[ $(stat -c %A "$CFGDIR") == *r?x ]] || \
    warn "Completion for non-root users will use sudo to access configuration directory
          whenever its modification time changes.
          To avoid sudo consider: chmod o+rX '$CFGDIR' # directory only!
          Otherwise add line for find command in sudoers as explained below.%%" fatal

  cat << EOF
$Y Bash completion installed to $completion_file

To activate completion in current shell:
  source $completion_file

Completion will be automatically available in new shell sessions.

To avoid sudo password prompt:
  sudo visudo -f /etc/sudoers.d/wgc-completion
  Then add:
  %sudo ALL=(ALL) NOPASSWD: /usr/bin/find $CFGDIR -maxdepth 1 -name *.conf -type f
EOF
}

stop_vpn() {
  local p_force=
  eval "$(get_params "$@")"

  local stopping=
  if is_connected; then
    stopping=1
    echo "Stopping $VPN ..."
  else
    warn "VPN $VPN is already stopped. Cleaning..."
  fi

  if [[ $HAS_NAMESPACE ]]; then
    local pids=$(get_ns_pids)
    if [[ $pids ]]; then
      if [[ $p_force ]]; then
        kill_processes "$pids"
      else
        error "Processes running in namespace $NAMESPACE:
               $(ps -fp $pids)
               Force stop (killing processes) with: wgc down $VPN force" fatal
      fi
    fi
  fi

  clean_vpn

  if is_connected; then
    warn "VPN $VPN is still active"
  else
    [[ $stopping ]] && echo "$Y VPN $VPN now stopped" || true
  fi
}

clean_vpn() {

  # Stop bridges
  if command -v systemctl >/dev/null; then

    local sockets_to_stop=$(systemctl list-units --all --type=socket --no-legend --plain "wgc.${VPN}.*" | cut -d ' ' -f 1)
    if [[ $sockets_to_stop ]]; then
      systemctl stop $sockets_to_stop 2>/dev/null || true
    fi

    local services_to_stop=$(systemctl list-units --all --type=service --no-legend --plain "wgc.${VPN}.*" | cut -d ' ' -f 1)
    if [[ $services_to_stop ]]; then
      systemctl stop $services_to_stop 2>/dev/null || true
    fi

    local all_units="$sockets_to_stop $services_to_stop"
    if [[ $all_units ]]; then
      systemctl reset-failed $all_units 2>/dev/null || true
    fi

    rm -f /run/wgc.${VPN}.*.sock 2>/dev/null || true

  fi

  is_connected || true # Set IS_CONNECTED HAS_NAMESPACE IN_NAMESPACE

  [[ $IN_NAMESPACE ]] && ip netns exec $NAMESPACE ip link del $DEV &>/dev/null || true

  if [[ $HAS_NAMESPACE ]]; then
    # Remove namespace
    # Note: Processes that were in the deleted namespace lose network connectivity
    # but continue running.
    ip netns del $NAMESPACE &>/dev/null || true
    rm -rf /etc/netns/$NAMESPACE &>/dev/null || true
  fi

  if [[ $IS_CONNECTED == default ]]; then
    [[ $(ip -br addr show $DEV 2>/dev/null) =~ ([0-9]{1,3}\.){3}[0-9]{1,3} ]] && \
      ip rule del from ${BASH_REMATCH[0]} &>/dev/null || true
    # Remove route protecting Wireguard endpoint
    local -a ep=()
    ep=($(wg show $DEV endpoints)) && {
      [[ ${ep[1]:-} ]] && {
        ep=${ep[1]%%:*}
        ip route del $ep &>/dev/null || true
      }
    } || true
    # DNS restore: remove configuration associated with $DEV
    # If openresolv is missing or fails, proceed anyway
    resolvconf -d "$DEV" &>/dev/null || true
    # Remove interface and related things
    ip link del $DEV &>/dev/null || true
  fi

}

start_transient_service() {
  local unit_name=$1
  shift # Shift off the first argument (unit name); the rest remains in "$@"

  command -v systemd-run >/dev/null || error "Systemd is required but not found (systemd-run)." fatal

  # Start the service
  # "$@" contains both the extra properties and the final command
  systemd-run --quiet --unit="$unit_name" \
    --description="WGC Service $unit_name" \
    --service-type=simple \
    --property=Restart=always \
    --property=RestartSec=1 \
    --property=StartLimitBurst=3 \
    --property=StartLimitIntervalSec=10 \
    --setenv=WGC_BRIDGE=1 \
    --property=SuccessExitStatus=143 \
    "$@" || warn "Command systemd-run failed for unit '$unit_name'."
}

configure_vpn_in_namespace() {

  # Create and configure namespace
  ip netns add $NAMESPACE || error "Failed to create namespace '$NAMESPACE'" fatal
  ip link set $DEV netns $NAMESPACE || error "Failed to move interface '$DEV' to namespace '$NAMESPACE'" fatal
  ip netns exec $NAMESPACE ip link set lo up || error "Failed to bring up loopback interface in namespace '$NAMESPACE'" fatal
  # Configure interface $DEV
  ip netns exec $NAMESPACE ip addr add "$Address" dev $DEV || error "Failed to configure address '$Address' for interface '$DEV'" fatal
  [[ $MTU ]] && \
    ip netns exec $NAMESPACE ip link set $DEV mtu $MTU || error "Failed to configure MTU '$MTU' for interface '$DEV'" fatal
  ip netns exec $NAMESPACE ip link set $DEV up || error "Failed to bring up interface '$DEV' with address '$Address'" fatal

  # Add default route
  ip netns exec $NAMESPACE ip route add default dev $DEV
  # Configure DNS
  if mkdir -p /etc/netns/$NAMESPACE; then
    local k
    for k in $DNS; do
      if validate_ipv4 "$k"; then
        echo "nameserver $k"
      else
        warn "Skipping invalid DNS server '$k'"
      fi
    done > /etc/netns/$NAMESPACE/resolv.conf
  else
    warn "Cannot create directory /etc/netns/$NAMESPACE"
  fi
  # Check if we have at least one DNS server
  if [[ ! -s /etc/netns/$NAMESPACE/resolv.conf ]]; then
    warn "No valid DNS servers configured"
  fi

  # Start socat bridges
  if (( ${#WGC_BRIDGES[@]} > 0 )); then
    local bridge_data b_name b_ext b_int b_sock b_unit_int b_unit_ext

    local PROXYD_BIN
    for PROXYD_BIN in /lib/systemd/systemd-socket-proxyd /usr/lib/systemd/systemd-socket-proxyd ""; do
      [[ -x $PROXYD_BIN ]] && break
    done
    [[ $PROXYD_BIN ]] || warn "systemd-socket-proxyd not found, falling back to socat"

    if [[ ! $PROXYD_BIN ]] && ! command -v socat >/dev/null; then

      warn "socat not found: cannot start defined bridges in [WGC-Bridges]"

    else

      echo "Starting Port Forwarding Bridges:"
      prc "+W%-20s %s+/\n" "Bridge" "ExtPort -> IntPort"
      prc "+A%-20s %s+/\n" "------" "------------------"

      local netns_path
      for netns_path in /run/netns/$NAMESPACE /var/run/netns/$NAMESPACE ""; do
        [[  -e $netns_path ]] && break
      done
      [[ -e $netns_path ]] || error "Cannot locate netns file for '$NAMESPACE'" fatal

      for bridge_data in "${WGC_BRIDGES[@]}"; do
        IFS=: read -r b_name b_ext b_int <<<"$bridge_data"
        b_sock=/run/wgc.$VPN.$b_name.sock
        b_unit_int=wgc.$VPN.$b_name.int
        b_unit_ext=wgc.$VPN.$b_name.ext

        # Is external port available for listen?
        if [[ $(ss -lntH "sport = :$b_ext") ]] ; then
          warn "Cannot start bridge '$b_name': External port $b_ext is already in use on host."
          continue
        fi

        prc "+y%-20s +G%-7s +A%-2s +c%s+/\n" "$b_name" "$b_ext" "->" "$b_int"

        if [[ $PROXYD_BIN ]]; then # use systemd-socket-proxyd
          # 1. Start Internal Connector
          start_transient_service "$b_unit_int" \
            --description="WGC Connector (proxyd) '$b_name' to port $b_int" \
            --socket-property=ListenStream="$b_sock" \
            --property=NetworkNamespacePath=$netns_path \
            $PROXYD_BIN 127.0.0.1:$b_int
          # 2. Start External Listener
          start_transient_service "$b_unit_ext" \
            --description="WGC Listener (proxyd) '$b_name' $b_ext -> $b_int" \
            --socket-property=ListenStream=$b_ext \
            --property=After=$b_unit_int.service \
            --property=BindsTo=$b_unit_int.service \
            $PROXYD_BIN "$b_sock"
        else # use socat
          # 1. Start Internal Connector
          start_transient_service "$b_unit_int" \
            --description="WGC Connector (socat) '$b_name' to port $b_int" \
            ip netns exec $NAMESPACE \
            socat UNIX-LISTEN:"$b_sock",fork,reuseaddr,unlink-early,mode=600,max-children=50 TCP:127.0.0.1:$b_int,tcp-nodelay
          # 2. Start External Listener
          start_transient_service "$b_unit_ext" \
            --description="WGC Listener (socat) '$b_name' $b_ext -> $b_int" \
            --property=After=$b_unit_int.service \
            --property=BindsTo=$b_unit_int.service \
            socat TCP-LISTEN:$b_ext,fork,reuseaddr,tcp-nodelay UNIX-CONNECT:"$b_sock"
        fi

        # 3. Health check
        local unit_to_check="$b_unit_ext.service"
        [[ $PROXYD_BIN ]] && unit_to_check="${b_unit_ext}.socket"
        local retries=20 # 2 seconds total
        while ((retries-- > 0)); do
          sleep 0.1
          systemctl is-active --quiet "$unit_to_check" && break
        done
        if ((retries < 0)); then
          local status=$(systemctl is-active "$unit_to_check" 2>/dev/null)
          warn "Bridge '$b_name' failed to start (status: ${status:-unknown}).
                Check logs: journalctl -u $unit_to_check"
        fi

      done
      echo
    fi
  fi
}

configure_vpn_plain() {
  local k= q=

  # Configure interface $DEV
  ip addr add "$Address" dev $DEV || error "Failed to configure address '$Address' for interface '$DEV'" fatal
  [[ $MTU ]] && {
    ip link set $DEV mtu $MTU || error "Failed to configure MTU '$MTU' for interface '$DEV'" fatal
  }
  ip link set $DEV up || error "Failed to bring up interface '$DEV' with address '$Address'" fatal

  if [[ $p_override_default_route ]]; then
  # Add a "split tunnel route" if wanted
    set_split_route
  else
    for k in $AllowedIPs; do
      [[ $k == "0.0.0.0/0" ]] && continue # Skip the catch-all route to avoid hijacking system-wide traffic
      ip route add "$k" dev $DEV || error "Cannot add route to $k" fatal
    done
  fi

  # Add default route valid only for source $Address (policy routing)
  for k in {1..251}; do
    [[ $(ip route show table $k 2>/dev/null) ]] || break
  done
  ((k >= 251)) && error "Cannot find an empty routing table in the range 1..250" fatal
  ip route add default dev $DEV table $k
  ip rule add from ${Address%/*} table $k

  # Configure DNS
  for k in $DNS; do
    if validate_ipv4 "$k"; then
      q+="nameserver $k"$'\n'
    else
      warn "Skipping invalid DNS server '$k'"
    fi
  done
  [[ $q ]] && echo "$q" | resolvconf -a $DEV -x || \
    warn "DNS configuration failed.
          Ensure 'openresolv' is properly installed and configured."
}

set_split_route() {
  local ep=${Endpoint%%:*} route
  local -a route_args
  validate_ipv4 "$ep" || read -r ep _ < <(getent ahostsv4 "$ep") || \
    error "Cannot resolve Endpoint name '$ep'" fatal blameparent
  route=$(ip -j route get "$ep" 2>/dev/null) || error "Cannot find route to Endpoint $ep" fatal blameparent
  [[ $route =~ \"gateway\":\"([^\"]+)\" ]] && route_args+=(via "${BASH_REMATCH[1]}")
  [[ $route =~ \"dev\":\"([^\"]+)\" ]] || error "Cannot determine output device for Endpoint $ep" fatal blameparent
  route_args+=(dev "${BASH_REMATCH[1]}")
  ip route replace "$ep" "${route_args[@]}" || error "Cannot set host route to Endpoint $ep" fatal blameparent
  ip route add 0/1 dev $DEV; ip route add 128/1 dev $DEV
}

start_vpn() {
  local p_override_default_route= p_use_namespace=
  eval "$(get_params "$@")"

  is_connected && \
    error "$VPN is already connected${IN_NAMESPACE:+ in namespace $NAMESPACE}
           To reconnect, first stop it: wgc down $VPN" fatal

  [[ $p_use_namespace ]] || check_openresolv

  # get parameters and forwarding bridges from config file named $VPN
  local HAS_DEFAULT_ROUTE=
  parse_config_file $VPN ${p_use_namespace:+bridges}

  push_cleanup clean_vpn

  # Create WireGuard interface
  ip link add dev $DEV type wireguard || error "Failed to create WireGuard interface '$DEV'" fatal

  # Configure WireGuard
  # Notice: this was tested against possible attack vectors, do not modify the general approach!
  local wgcmd='wg set $DEV'
  [[ $ListenPort ]] && wgcmd+=' listen-port "$ListenPort"'
  wgcmd+=' private-key <(printf %s "$PrivateKey")'
  wgcmd+=' peer "$PublicKey"'
  wgcmd+=' allowed-ips "$AllowedIPs"'
  wgcmd+=' endpoint "$Endpoint"'
  [[ $PresharedKey ]] && wgcmd+=' preshared-key <(printf %s "$PresharedKey")'
  [[ $PersistentKeepalive ]] && wgcmd+=' persistent-keepalive "$PersistentKeepalive"'
  eval "$wgcmd" || {
    eval $'read -r -d "" wgcmd <<EOF\n'"${wgcmd/\$PrivateKey/<HIDDEN>}"$'\nEOF' || true
    error "Failed to configure WireGuard interface '$DEV' using command:
           $wgcmd" fatal
  }

  if [[ $p_use_namespace ]]; then
    configure_vpn_in_namespace
  else
    configure_vpn_plain
  fi

  pop_cleanup clean_vpn

  show_state
}

get_ns_pids() {
  local pid pids=
  local -a e
  # filter out forwarding bridges by looking for WGC_BRIDGE in process environment
  for pid in $(ip netns pids $NAMESPACE 2>/dev/null); do
    mapfile -d '' e < /proc/$pid/environ 2>/dev/null || continue
    [[ ${e[*]} == *WGC_BRIDGE=* ]] && continue
    pids+="$pid "
  done
  echo $pids
}

show_bridges() {
  # Format: UNIT LOAD ACTIVE SUB DESCRIPTION
  local output=$(systemctl list-units --all --full --type=service,socket --no-legend --plain "wgc.${VPN}.*")

  if [[ $output ]]; then
    echo
    prc "+W  %-18s %-19s %-8s %s+/\n" Bridge "ExtPort -> IntPort" Type Status
    prc "+A  %-18s %-19s %-8s %s+/\n" ------ "------------------" ---- ------

    # Load all info in hash maps for instant lookup
    local -A u_active u_desc
    local u load active sub desc
    while read -r u load active sub desc; do
      u_active[$u]=$active
      u_desc[$u]=$desc
    done <<< "$output"

    # Iterate an print
    for u in "${!u_active[@]}"; do
      # Only one line per each external Listener
      [[ $u != *.ext.* ]] && continue

      desc="${u_desc[$u]}"; active="${u_active[$u]}"

      # Parse unit description.
      # Example: WGC Listener (proxyd) 'Privoxy' 8081 -> 8080
      #                        tool     name     p_ext   p_int
      local regex="\(([^)]+)\) '([^']+)' ([0-9]+) -> ([0-9]+)"
      if [[ $desc =~ $regex ]]; then
        tool=${BASH_REMATCH[1]}
        name=${BASH_REMATCH[2]}
        p_ext=${BASH_REMATCH[3]}
        p_int=${BASH_REMATCH[4]}
        # We are interested only in sockets (proxyd) or socat services
        if [[ $u == *.socket ]] || [[ $tool == "socat" ]]; then
          local status_str=$active
          case "$active" in
            active)               status_str="$Y $status_str" ;;
            failed)               status_str="$X $status_str" ;;
            activating|reloading) status_str=$'\u25cf'" $status_str" ;;
            *)                    status_str="- $status_str" ;;
          esac

          local int_unit="wgc.${VPN}.${name}.int.socket" # proxyd
          [[ $tool == socat ]] && int_unit="wgc.${VPN}.${name}.int.service"
          local int_status="${u_active[$int_unit]:-missing}"
          [[ $int_status != active ]] && status_str+=" / Int: $X $int_status"

          prc "+y  %-18s+/ +G%-7s +A%-2s +c%-8s+/ %-8s %s\n" "$name" "$p_ext" "->" "$p_int" "$tool" "$status_str"
        fi
      fi
    done | sort # hash map order is undefined
  else
    echo "  (none)"
  fi
}

show_state() {
  local p_bridges=
  eval "$(get_params "$@")"

  if is_connected; then
    echo "$Y $VPN VPN is CONNECTED${IN_NAMESPACE:+ in namespace $NAMESPACE}"
    NSCMD=${IN_NAMESPACE:+ip netns exec $NAMESPACE}
    echo
    $NSCMD wg show $DEV
    echo
    echo "Interface details:"
    $NSCMD ip -c addr show $DEV
    echo
    if [[ $IN_NAMESPACE ]]; then
      echo "Routes:"
      $NSCMD ip -c route show
      echo
      echo "DNS:"
      grep -E --color '([0-9]{1,3}\.){3}[0-9]{1,3}' \
        /etc/netns/$NAMESPACE/resolv.conf 2>/dev/null || echo "  (none)"
      if [[ $p_bridges ]]; then
        echo
        echo "Forwarding Bridges:"
        show_bridges
      fi
      echo
      echo "Processes running in namespace $NAMESPACE:"
      local pids=$(get_ns_pids)
      [[ $pids ]] && ps -fp $pids || echo "  (none)"
      echo
      echo "To run commands in the VPN namespace $NAMESPACE:"
      echo "  wgc exec $VPN <command>"
      echo "  Example: wgc exec $VPN curl ipinfo.io"
    else
      echo "Routes:"
      ip -c route show | grep -F --color $DEV || echo "  (none)"
      echo
      if [[ $(ip -br addr show $DEV 2>/dev/null) =~ ([0-9]{1,3}\.){3}[0-9]{1,3} ]]; then
        local addr=${BASH_REMATCH[0]}
        echo "Rules:"
        ip rule list from $addr | grep -F --color "from $addr" || echo "  (none)"
        local t=
        while read -r _ _ _ _ t; do
          echo
          echo "Routing table $t:"
          ip -c route show table $t
        done < <(ip rule list from $addr)
      else
        warn "Cannot find $DEV ip address"
      fi
      echo
      echo "DNS:"
      resolvconf -l $DEV || true
    fi
  else
    warn "VPN $VPN is DISCONNECTED"
  fi
}

validate_vpn_name() {
  [[ $VPN =~ ^[a-zA-Z0-9_-]{1,11}$ ]] || \
    error "Invalid VPN name '$VPN'. Use only alphanumeric, dash, underscore. Max lenght is 11." fatal blameparent
}

# -----------------------------------------------------------------------------

# Stack for cleanup functions
declare -a CLEANUP_STACK=()

# Add cleanup function to stack top
push_cleanup() {
  local func_name="$1"
  CLEANUP_STACK+=($func_name)
}

# Remove cleanup function from stack top
pop_cleanup() {
  local func_name=$1 # must declare function to pop, to avoid forgetting pops
  local last_idx=$((${#CLEANUP_STACK[@]} - 1))
  [[ "$func_name" ]] || error "BUG: pop_cleanup called without function name" fatal blameparent
  [[ $last_idx -lt 0 ]] && error "BUG: Cannot pop '$func_name' from empty stack!" fatal blameparent
  local last_pushed="${CLEANUP_STACK[$last_idx]}"
  # function to pop must match last pushed function
  if [[ "$func_name" != "$last_pushed" ]]; then
    error "BUG: expected pop of '$last_pushed', but got '$func_name'" fatal blameparent
  fi
  unset "CLEANUP_STACK[$last_idx]" # pop
}

# Error handler. Supports:
# - Error messages with line numbers
# - blameparent: Reports caller's line number instead
# - Flexible error reporting (soft vs fatal)
# - fatal: Triggers cleanup stack unwinding and exits
# - Graceful cleanup even when cleanup functions fail
# - Multi-line message support (using %% or actual newlines)
error() {
  local exit_code=$?  msg=$1; shift
  local p_fatal= p_blameparent=
  eval "$(get_params "$@")"

  local original_trap=$(trap -p ERR) original_opts=$-
  trap - ERR; set +e

  local line=${BASH_LINENO[0]}

  [[ $p_blameparent ]] && line=${BASH_LINENO[1]}

  case "$msg" in
    "")
      ;;
    TRAP)
      echo "${X}ERROR @$line: Command '$BASH_COMMAND' failed with exit code $exit_code" >&2
      show_traceback >&2
      ;;
    *)
      indent_multiline msg
      echo "${X}ERROR +$line: $msg" >&2
      ;;
  esac

  if [[ $p_fatal ]]; then
    # unwind of CLEANUP_STACK
    local k=
    for (( k=${#CLEANUP_STACK[@]}-1; k>=0; k-- )); do
      local clean_func=${CLEANUP_STACK[$k]}
      if declare -F "$clean_func" >/dev/null; then
        echo "  [$k] Calling: $clean_func" >&2
        $clean_func || echo "      (Warning: '$clean_func' failed, continuing...)" >&2
      else
        echo "  [$k] Error: Function '$clean_func' not defined" >&2
      fi
    done
    echo "Aborted." >&2
    exit 1
  fi

  [[ $original_trap ]] && eval "$original_trap"
  [[ $original_opts == *e* ]] && set -e
  return 0 # allow to use error() as soft error handler without adding ||true to avoid trap ERR and recursion
}

show_traceback() {
  echo "  Traceback:"
  local i= len=
  for (( i=2, len=${#FUNCNAME[@]}; i<len; i++ )); do
    echo "    [$((len-i))] ${FUNCNAME[$i]}:${BASH_LINENO[$((i-1))]}"
  done
}

warn() {
  local msg=$1
  indent_multiline msg
  echo "$W Warning: $msg" >&2
}

indent_multiline() {
  local -n _ref=$1
  # %% or newline means: newline and indent 2
  _ref=$(printf %s "${_ref}" | sed -z -E 's/[[:blank:]]*(%%|\n)[[:blank:]]*/\n  /g')
}

