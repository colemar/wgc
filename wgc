show_usage() {
  cat <<EOF
Usage: wgc [options] [ [up|upd|nup|down|status] <vpn> | active | list | exec <vpn> <command> ]

<vpn> should match a config file name \$WGC_CFGDIR/<vpn>.conf
Set and export WGC_CFGDIR to point to dir containing Wireguard *.conf files.
Default config dir is /etc/wireguard.

Commands (can be shortened):
  up     - Start a VPN
  upd    - Start a VPN and add a "split route" (0.0.0.0/1 128.0.0.0/1)
  nup    - Start a VPN in its own net namespace
  down   - Stop a VPN
  status - Show VPN status
  active - Show active VPNs
  list   - List config files
  exec   - Execute a command in a VPN namespace
           Example: wgc <vpn> exec curl ipinfo.io
  check  - Check if the required commands are available

To enable bash completion: wgc completion
Redo completion if WGC_CFGDIR is changed.
EOF
}

set_markers() {
  Y=$'\u2713'
  X=$'\u274C'
  W=$'\u2717'
  # Detect if terminal supports colors
  if [[ -t 1 ]] && (($(tput colors 2>/dev/null || echo 0) >= 8)); then
    Y=$'\e[01;32m'$Y$'\e[m' # green CHECK MARK
    X=$'\e[01;31m'$X$'\e[m' # red CROSS MARK
    W=$'\e[01;31m'$W$'\e[m' # red BALLOT X
  fi
  declare -gr W X Y
}

set_cfgdir() {
  declare -gr CFGDIR=${WGC_CFGDIR:-/etc/wireguard}
  # Validate directory
  [[ ! -d "$CFGDIR" ]] && \
    error "Configuration directory not found: $CFGDIR
          Set WGC_CFGDIR to point to dir containing Wireguard *.conf files." fatal
  [[ ! -r "$CFGDIR" ]] && \
    error "Configuration directory found, but not readable: $CFGDIR
          Check permissions (e.g., 'sudo chmod o+rX $CFGDIR')." fatal
  return 0
}

check_dependencies() {
  local missing=()
  for cmd in ip wg grep resolvconf mkdir rm ps sleep find curl sed setpriv; do
    command -v $cmd >/dev/null || missing+=($cmd)
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    error "Missing required commands: ${missing[*]}
           Install with: apt install wireguard-tools iproute2 grep sed coreutils procps findutils openresolv util-linux" fatal blameparent
  fi
  echo "$Y All required commands are available."
}

has_openresolv() {
  [[ $(resolvconf -h 2>/dev/null) =~ -x[[:blank:]][[:blank:].A-Za-z]*[[:blank:]]exclusive ]]
}

check_openresolv() {
  if ! has_openresolv; then
    local tailmsg='Please run: apt-get install openresolv'
    [[ -d /run/systemd/resolve ]] && tailmsg="This system has systemd-resolved.
      To bypass debian package conflict with openresolv run 'wgc openresolv' instead of 'apt-get install openresolv'.
      To remove openresolv installed by wgc run 'wgc remopenresolv'."
    error "Your version of 'resolvconf' does not support exclusive mode (-x).
           $tailmsg" fatal blameparent
  fi
}

install_forced_openresolv() {
  has_openresolv && error "Openresolv is already installed ('resolvconf' supports exclusive mode -x)." fatal

  [[ -L /usr/sbin/resolvconf ]] ||
    error "Systemd-resolved symlink wrapper for 'resolvconf' NOT detected. Standard installation is possible.
           Please install 'openresolv' using: sudo apt-get install openresolv" fatal

  echo "Forcing openresolv installation..."

  dpkg-divert --list | grep "/usr/sbin/resolvconf" > /dev/null || {
    echo "Diversion of resolvconf binary..."
    dpkg-divert --divert /usr/sbin/resolvconf.systemd --rename --add /usr/sbin/resolvconf
  }

  local TEMP_DIR=$(mktemp -d)
  mkdir -p "$TEMP_DIR"
  cd "$TEMP_DIR" || return 1

  if apt-get download openresolv 2>/dev/null; then
    echo "Download via APT successful."
  else
    echo "APT download failed (package likely missing)."
    local BASE_URL="https://ftp.debian.org/debian/pool/main/o/openresolv/"
    echo "Attempting direct Debian Pool download from $BASE_URL ..."

    # Find latest .deb file: openresolv_X.X.X-X_all.deb
    local DEB_NAME=$(curl -s "$BASE_URL" | \
     grep -oP 'openresolv_[0-9][0-9\.-]+_all\.deb' | \
     sort -Vu | tail -n 1)

    if [[ -z "$DEB_NAME" ]]; then
      echo "Error: Could not find openresolv package on Debian FTP."
      cd .. && rm -rf "$TEMP_DIR"
      return 1
    fi

    echo "Detected version: $DEB_NAME"
    wget -O "$DEB_NAME" "${BASE_URL}${DEB_NAME}" || { echo "Download failed"; return 1; }
  fi

  local DEB_FILE=$(find . -name "openresolv*.deb" | head -n 1)

  echo "Creating file manifest..."
  mkdir -p /etc/wwggcc

  dpkg-deb --fsys-tarfile "$DEB_FILE" | tar -tf - | grep -v '/$' | sed 's|^./|/|' > /etc/wwggcc/openresolv.files

  echo "Extracting directly to system..."
  dpkg-deb --fsys-tarfile "$DEB_FILE" | tar --keep-directory-symlink -xC /

  cd ..
  rm -rf "$TEMP_DIR"

  echo "Detecting DNS backend..."
  if [[ -d /run/systemd/resolve ]]; then
    echo "Systemd-resolved detected. Appending configuration."
    if ! grep -q "name_servers=\"127.0.0.53\"" /etc/resolvconf.conf; then
      {
        echo ""
        echo "# Added by wgc installer for systemd-resolved compatibility"
        echo "name_servers=\"127.0.0.53\""
        echo "resolv_conf_options=\"trust-ad\""
      } >> /etc/resolvconf.conf
    else
      echo "Configuration already present. Skipping."
    fi
  else
    echo "Systemd-resolved NOT detected. Leaving standard configuration."
  fi

  echo "Regenerating resolvconf..."
  /sbin/resolvconf -u

  if command -v mandb >/dev/null; then
    echo "Updating the manual page index caches..."
    mandb -pq
  fi

  echo "Openresolv forced successfully."
  echo "Manifest saved to /etc/wwggcc/openresolv.files"
}

remove_openresolv() {
  local MANIFEST=/etc/wwggcc/openresolv.files

  echo "Removing openresolv..."

  dpkg-divert --list | grep "/usr/sbin/resolvconf" > /dev/null ||
    error "No package diversion found. Assuming standard APT management.
           To uninstall 'openresolv', please use: sudo apt remove openresolv" fatal

  echo "Removing diversion of resolvconf binary..."
  rm -f /usr/sbin/resolvconf
  dpkg-divert --rename --remove /usr/sbin/resolvconf

  if [[ -f "$MANIFEST" ]]; then
    echo "Deleting installed files..."
    cat "$MANIFEST" | tr '\n' '\0' | xargs -0 rm -f
    rm -f "$MANIFEST"
  else
    echo "Warning: Manifest $MANIFEST not found. Trying generic cleanup..."
    rm -f /usr/sbin/resolvconf
    rm -rf /usr/lib/resolvconf
    rm -f /etc/resolvconf.conf
  fi

  rmdir /usr/lib/resolvconf 2>/dev/null || true

  echo "Restoring systemd-resolved symlink /etc/resolv.conf..."
  if [[ -f /etc/resolv.conf ]] && [[ ! -L /etc/resolv.conf ]]; then
    rm -f /etc/resolv.conf
    ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf
  fi

  echo "Restoring systemd-resolved resolvconf symlink wrapper..."
  rm -f /usr/sbin/resolvconf
  ln -sf /usr/bin/resolvectl /usr/sbin/resolvconf

  if command -v mandb >/dev/null; then
    echo "Updating the manual page index caches..."
    mandb -pq
  fi

  echo "Done. System returned to APT management."
}

list_config_files() {
  local f= g=
  set_cfgdir
  echo -e "Looking in $CFGDIR\n"
  printf "%-12s %-18s %-29s %s\n" "Name" "Address" "Endpoint" "AllowedIPs"
  printf "%-12s %-18s %-29s %s\n" "----" "-------" "--------" "----------"
  for f in $CFGDIR/*.conf; do
    [[ "$f" == "$CFGDIR/*.conf" ]] && return 0
    g=${f##*/}; g=${g%.*}
    [[ $g =~ wg[0-9]+ ]] && continue # exclude wg0, wg1, wg2 ...
    parse_config_file "$g" relax || continue
    (( ${#Endpoint} > 29 )) && Endpoint="${Endpoint:0:27}.."
    printf "%-12s %-18s %-29s %s\n" "$g" "$Address" "$Endpoint" "$AllowedIPs"
  done
}

parse_config_file() {
  local CONFIG_FILE="$CFGDIR/$1.conf" relax=${2:-} fatal=fatal
  [[ $relax ]] && fatal=
  [[ -f "$CONFIG_FILE" ]] || { error "Config file not found: $CONFIG_FILE" $fatal blameparent; return 1; }
  [[ -r "$CONFIG_FILE" ]] || { error "Can't read file: $CONFIG_FILE" $fatal blameparent; return 1; }
  local line= n=0 s= section= key= value=
  read Address PrivateKey PublicKey Endpoint AllowedIPs \
    DNS MTU ListenPort PersistentKeepalive PresharedKey \
    WARNINGS BADSECTION <<<""
  while read -r line || [[ -n "$line" ]]; do # also read last line if \n is missing
      ((++n))
      line="${line%%#*}" # Remove comments
      if [[ "$line" =~ ^[[:space:]]*(\[[A-Za-z0-9]+\])[[:space:]]*$ ]]; then
        section="${BASH_REMATCH[1]}" # Track section
        s=$n # remember section line number
        continue
      fi
      # Skip lines in bad sections (even before all sections)
      [[ "$section" == "$BADSECTION" ]] && continue
      # Parse key=value with flexible spacing, preserving = in value
      if [[ "$line" =~ ^[[:space:]]*([A-Za-z0-9]+)[[:space:]]*=[[:space:]]*(.*[^[:space:]]) ]]; then
        key="${BASH_REMATCH[1]}"   # key without spaces
        value="${BASH_REMATCH[2]}" # value trimmed, with = preserved
      else # Not a key=value line
        if [[ "$line" =~ [^[:space:]] ]]; then # also not empty
          WARNINGS+=$'\n'"Malformed line $n: '${line:0:50}...'"
        fi
        continue
      fi
      # Get values according to section/key
      process_config_line $s $n "$key" "$value" "$section"
  done < "$CONFIG_FILE"
  if [[ ! $relax ]]; then
    [[ "$WARNINGS" ]] && warn "Skipping invalid entries in $CONFIG_FILE:$WARNINGS"
    local k=
    for k in Address PrivateKey PublicKey Endpoint AllowedIPs; do
      [[ ${!k} ]] || error "Missing required key '$k' in file $CONFIG_FILE" fatal blameparent
    done
  fi
}

process_config_line() {
  local s="$1" n="$2" key="$3" value="$4" section="$5"

  case "$section" in
    "[Interface]")
      case "$key" in
        Address) extract_ipv4 "$value" Address ;;
        DNS) extract_all_ipv4 "$value" ' ' DNS ;;
        MTU) MTU=$value ;;
        PrivateKey) PrivateKey=$value ;;
        ListenPort) ListenPort=$value ;;
        *) WARNINGS+=$'\n'"Unknown key '$key' in section '$section' at line $n" ;;
      esac
      ;;
    "[Peer]")
      case "$key" in
        AllowedIPs) extract_all_ipv4 "cidr$value" ',' AllowedIPs ;;
        Endpoint) Endpoint=$value ;;
        PersistentKeepalive) PersistentKeepalive=$value ;;
        PresharedKey) PresharedKey=$value ;;
        PublicKey) PublicKey=$value ;;
        *) WARNINGS+=$'\n'"Unknown key '$key' in section '$section' at line $n" ;;
      esac
      ;;
    *)
      BADSECTION=$section
      WARNINGS+=$'\n'"Unknown section '$section' at line $s"
      ;;
  esac
}

extract_ipv4() {
  local _in=$1
  local -n _out=$2
  local _regex='([0-9]{1,3}\.){3}[0-9]{1,3}(/[0-9]+)?'
  [[ $_in =~ $_regex ]] && _out="${BASH_REMATCH[0]}" || _out=
}

extract_all_ipv4() {
  local _in=$1
  local _sep=${2:- }
  local -n _out=$3
  local _regex='([0-9]{1,3}\.){3}[0-9]{1,3}'
  [[ "$_in" == cidr* ]] && _regex+='(/[0-9]+)?'
  while [[ $_in =~ $_regex ]]; do
    _out+="$_sep${BASH_REMATCH[0]}"
    # Remove found match and go on
    _in=${_in#*"${BASH_REMATCH[0]}"}
  done
  _out=${_out#$_sep} # Remove initial separator if present
}

show_config() {
  for k in Address PrivateKey PublicKey PresharedKey Endpoint AllowedIPs PersistentKeepalive; do
    echo "$k=${!k}"
  done
  echo
}

is_connected() {
  if [[ $(ip -br addr show $DEV 2>/dev/null) =~ ([0-9]{1,3}\.){3}[0-9]{1,3} ]]; then
    DEV_ADDR=${BASH_REMATCH[0]}
    IN_NAMESPACE=
    return 0
  fi
  if [[ $(ip netns exec $NAMESPACE ip -br addr show $DEV 2>/dev/null) =~ ([0-9]{1,3}\.){3}[0-9]{1,3} ]]; then
    DEV_ADDR=${BASH_REMATCH[0]}
    IN_NAMESPACE=$NAMESPACE
    return 0
  fi
  return 1
}

show_status() {
  validate_vpn_name
  if is_connected; then
    echo "$Y $DEV VPN is CONNECTED${IN_NAMESPACE:+ in namespace $NAMESPACE}"
    NSCMD=${IN_NAMESPACE:+ip netns exec $NAMESPACE}
    echo
    $NSCMD wg show $DEV
    echo
    echo "Interface details:"
    $NSCMD ip -c addr show $DEV
    echo
    if [[ $IN_NAMESPACE ]]; then
      echo "Routes:"
      $NSCMD ip -c route show
      echo
      echo "DNS:"
      grep -E --color '([0-9]{1,3}\.){3}[0-9]{1,3}' \
        /etc/netns/$NAMESPACE/resolv.conf 2>/dev/null || echo "  (none)"
      echo
      echo "Processes running in namespace $NAMESPACE:"
      local pids=$(ip netns pids $NAMESPACE 2>/dev/null)
      [[ $pids ]] && ps -fp $pids || echo "  (none)"
    else
      echo "Routes:"
      ip -c route show | grep -F --color $DEV || echo "  (none)"
      echo
      echo "Rules:"
      ip rule list from $DEV_ADDR | grep -F --color "from $DEV_ADDR" || echo "  (none)"
      local x= t=
      while read -r x x x x t; do
        echo
        echo "Routing table $t:"
        ip -c route show table $t
      done < <(ip rule list from $DEV_ADDR)
      echo
      echo "DNS:"
      resolvconf -l $DEV || true
    fi
  else
    warn "VPN $DEV is DISCONNECTED"
  fi
}

show_active_vpns() {
  local x= ns= dev= net= found=false
  set_cfgdir
  echo
  echo "Active VPNs in default namespace:"
  for x in $(wg show interfaces); do
    [[ $x =~ wg[0-9]+ ]] && continue
    [[ -f $CFGDIR/$x.conf ]] || continue
    if read -r dev x net < <(ip -br -c address show $x 2>/dev/null); then
      found=true
      echo $dev $net
    fi
  done
  $found || echo "  (none)"
  found=false
  echo
  echo "Active VPNs in other namespaces:"
  while read -r ns x; do
    dev=$ns
    if ip netns exec $ns wg show $dev &>/dev/null && \
    read -r dev x net < <(ip netns exec $ns ip -br -c address show $dev 2>/dev/null); then
      found=true
      echo $dev $net
    fi
  done < <(ip netns list 2>/dev/null)
  $found || echo "  (none)"
  echo
}

kill_processes() {
  local pids=$1
  echo -e "Terminating processes:\n$(ps -fp $pids)"
  kill $pids &>/dev/null || true
  # paint increasing bar for timeout
  local h= d= timeout=10 # seconds
  eval printf -v d "$'\u2591'%.0s" {1..$((timeout*2))} # timeout*2 LIGHT SHADEs in d
  echo -ne "\033[?25l" # hide cursor
  while [[ "$pids" && "$d" ]]; do
    sleep 0.5
    pids=$(ip netns pids $NAMESPACE 2>/dev/null)
    d=${d%$'\u2591'} # remove one LIGHT SHADE
    echo -ne "\r$h$d" # paint the bar over itself
    h+=$'\u2588' # append a FULL BLOCK
  done
  echo -ne "\r\033[K\033[?25h" # delete bar and restore cursor
  if [[ -z "$d" ]]; then # timeout
    echo "Forcibly terminating processes (SIGKILL)"
    kill -9 $pids &>/dev/null || true
    sleep 0.1
    # check again
    pids=$(ip netns pids $NAMESPACE 2>/dev/null)
    [[ "$pids" ]] && warn "Processes still running: $pids"
  fi
}

stop_vpn() {
  validate_vpn_name
  local force=${1:-}
  is_connected || { warn "$DEV is already disconnected"; return 0; }
  if [[ $IN_NAMESPACE ]]; then
    local pids=$(ip netns pids $NAMESPACE 2>/dev/null)
    if [[ "$pids" ]]; then
      if [[ "$force" == force ]]; then
        kill_processes "$pids"
      else
        error "Processes running in namespace $NAMESPACE:
               $(ps -fp $pids)
               Force stop (killing processes) with: wgc down $DEV force" fatal
      fi
    fi
    # ip netns del removes all interfaces within the namespace automatically
    # anyways, better be explicit
    rm -rf /etc/netns/$NAMESPACE &>/dev/null || true
    ip netns exec $NAMESPACE ip link del $DEV &>/dev/null || true
    ip netns del $NAMESPACE &>/dev/null || true
  else
    # Remove policy routing rule.
    [[ $(ip -br addr show $DEV 2>/dev/null) =~ ([0-9]{1,3}\.){3}[0-9]{1,3} ]] && \
      ip rule del from ${BASH_REMATCH[0]} &>/dev/null || true
    # Remove route protecting Wireguard endpoint
    local ep=
    ep=($(wg show $DEV endpoints)) && {
      ep=${ep[1]%%:*}
      [[ $ep ]] && ip route del $ep &>/dev/null || true
    } || true
    # DNS restore: remove configuration associated with $DEV
    # If openresolv is missing or fails, proceed anyway
    resolvconf -d "$DEV" &>/dev/null || true
    # Remove interface and related things
    ip link del $DEV &>/dev/null || true
  fi
  echo "$Y VPN $DEV is now disconnected"
}

is_valid_ident() {
  local "$1" &>/dev/null
}

exec_in_namespace() {
  validate_vpn_name
  [[ $# -eq 0 ]] && { error "No command specified"; show_usage; exit 1; }
  is_connected || error "VPN $DEV is not connected. Start it first with: wgc nup $DEV" fatal
  [[ $IN_NAMESPACE ]] || error "VPN $DEV is not in its own namespace. Just use plain command: $@" fatal

  if [[ $(</proc/$PPID/comm) == sudo ]]; then
    # wgc auto-elevated or executed with sudo.
    # sudo inherits and sanitizes the original environment (depending on the active security policy) before executing wgc.
    local grandpa_pid var_eq_val var

    command -v setpriv >/dev/null || error "Missing command 'setpriv'" fatal
    [[ $SUDO_UID ]] || error "Unable to determine invoking user (SUDO_UID missing)" fatal

    # Retrieve the Grandparent PID (field 4 of parent's stat).
    # This identifies the correct source for the unsanitized environment:
    # 1. Modern sudo (PTY mode): It targets the main sudo process (which holds the original env).
    # 2. Legacy sudo: It targets the invoking shell directly.
    # In both cases, reading this PID's environ bypasses the sanitization applied by the direct parent.
    read -r _ _ _ grandpa_pid _ < /proc/$PPID/stat # get sudo pid
    # Build the environment for the final command
    local -a FINAL_ENV
    while IFS= read -r -d '' var_eq_val; do
      var=${var_eq_val%%=*}
      [[ $var == @(PWD|_) ]] && continue
      FINAL_ENV+=("$var_eq_val")
    done < /proc/$grandpa_pid/environ

    # Append the actual current PWD.
    # wgc inherited the correct working directory from sudo (whether preserved or changed via sudo -i),
    # so $PWD holds the authoritative value.
    FINAL_ENV+=("PWD=$PWD")

    # Final command
    exec ip netns exec $NAMESPACE \
         setpriv --reuid $SUDO_UID --regid $SUDO_GID --init-groups \
         env -i "${FINAL_ENV[@]}" "$@"
  else
    # wgc executed by root
    exec ip netns exec $NAMESPACE "$@"
  fi
}

validate_ipv4_kern() {
  local ip=$1
  ip -4 rule add to "$ip" &>/dev/null || return 1
  ip -4 rule del to "$ip" &>/dev/null || true
}

validate_ipv4() {
  # Define a single octet
  # 25[0-5]     -> 250-255
  # 2[0-4][0-9] -> 200-249
  # 1[0-9][0-9] -> 100-199
  # [1-9]?[0-9] -> 0-99
  local oct="(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])"
  local regex="^$oct\.$oct\.$oct\.$oct$"
  [[ $1 =~ $regex ]]
}

enable_completion() {

  local completion_dir=
  for completion_dir in /etc/bash_completion.d /usr/share/bash-completion/completions ""; do
    [[ -d "$completion_dir" ]] && break
  done
  [[ $completion_dir ]] || error "Cannot find bash completion directory" fatal
  local completion_file="$completion_dir/wgc"

  cat > "$completion_file" << 'EOF'
_wgc_completion() {
  local cur= prev= commands=
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"

  # Main commands
  commands="up upd nup down status active list exec"

  # Complete the first arg with main commands
  if [[ $COMP_CWORD -eq 1 ]]; then
    COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
    return 0
  fi

  # Complete the second arg depending on command
  if [[ $COMP_CWORD -eq 2 ]]; then
    local vpns= ns= x= dev=
    case "$prev" in
      up|upd|n|nu|nup)
        # VPN config file list
        local f=
        for f in $(sudo find ${WGC_CFGDIR:-/etc/wireguard} -maxdepth 1 -name "*.conf" -type f 2>/dev/null); do
          f=${f##*/}; f=${f%.*}
          [[ $f =~ wg[0-9]+ ]] && continue # exclude wg0, wg1, wg2 ...
          vpns+="$f "
        done
        COMPREPLY=( $(compgen -W "$vpns" -- "$cur") )
        ;;
      d|do|dow|down|s|st|sta|stat|statu|status)
        # Active VPNs in default namespace
        for x in $(wg show interfaces); do
          [[ $x =~ wg[0-9]+ ]] && continue
          read -r dev x net < <(ip -br address show $x 2>/dev/null) && vpns+="$dev "
        done
        # Active VPNs (namespaces)
        while read -r ns x; do
          sudo ip netns exec "$ns" wg show "$ns" &>/dev/null && vpns+="$ns "
        done < <(sudo ip netns list 2>/dev/null)
        COMPREPLY=( $(compgen -W "$vpns" -- "$cur") )
        ;;
      e|ex|exe|exec)
        # Active VPNs (namespaces)
        while read -r ns x; do
          sudo ip netns exec "$ns" wg show "$ns" &>/dev/null && vpns+="$ns "
        done < <(sudo ip netns list 2>/dev/null)
        COMPREPLY=( $(compgen -W "$vpns" -- "$cur") )
        ;;
    esac
    return 0
  fi

  # For exec, after VPN name do complete with system commmands
	if [[ $COMP_CWORD -gt 2 ]]; then
		case "${COMP_WORDS[1]}" in
			e|ex|exe|exec)
				if declare -F _command_offset &>/dev/null; then
					# Use advanced completion if available
					_command_offset 3
				else
					# Fallback to basic completion
					if [[ $COMP_CWORD -eq 3 ]]; then
						COMPREPLY=( $(compgen -c -- "$cur") )
					else
						compopt -o default
						COMPREPLY=()
					fi
				fi
				return 0
				;;
		esac
	fi
}

complete -F _wgc_completion wgc
EOF

  chmod 644 "$completion_file"

  cat << EOF
$Y Bash completion installed to $completion_file

To activate completion in current shell:
  source $completion_file

Completion will be automatically available in new shell sessions.

To avoid sudo password prompt:
  sudo visudo -f /etc/sudoers.d/wgc-completion
  Then add:
  %sudo ALL=(ALL) NOPASSWD: /usr/bin/find $CFGDIR -maxdepth 1 -name *.conf -type f
  %sudo ALL=(ALL) NOPASSWD: /usr/sbin/ip netns list
  %sudo ALL=(ALL) NOPASSWD: /usr/sbin/ip netns exec * wg show *
EOF
}

clean_vpn() {
  if $USE_NAMESPACE; then
    # Delete interface
    $NSCMD ip link del $DEV &>/dev/null || true
    # Remove namespace
    # Note: Processes that were in the deleted namespace lose network connectivity
    # but continue running.
    ip netns del $NAMESPACE &>/dev/null || true
    rm -rf /etc/netns/$NAMESPACE &>/dev/null || true
  else
    [[ $(ip -br addr show $DEV 2>/dev/null) =~ ([0-9]{1,3}\.){3}[0-9]{1,3} ]] && \
      ip rule del from ${BASH_REMATCH[0]} &>/dev/null || true
    ip link del $DEV &>/dev/null || true
  fi
}

start_vpn() {

  local arg= split_tunnel_route=false use_namespace=false k= q= t=

  for arg in "${@}"; do
    case $arg in
      split_tunnel_route) split_tunnel_route=true ;;
      use_namespace) use_namespace=true ;;
    esac
  done

  validate_vpn_name

  is_connected && \
    error "$DEV is already connected in namespace ${IN_NAMESPACE:-default}
           To reconnect, first stop it: wgc down $DEV" fatal

  set_cfgdir

  # get parameters from config file named $DEV
  parse_config_file $DEV

  if $use_namespace; then
    NSCMD="ip netns exec $NAMESPACE"
  else
    NSCMD=
    check_openresolv
  fi

  push_cleanup clean_vpn # Clean slate - removes namespace, interface, DNS config

  # Create WireGuard interface
  ip link add dev $DEV type wireguard || error "Failed to create WireGuard interface '$DEV'" fatal

  # Configure WireGuard
  # Notice: this was tested against possible attack vectors, do not modify the general approach!
  local wgcmd='wg set $DEV'
  [[ $ListenPort ]] && wgcmd+=' listen-port "$ListenPort"'
  wgcmd+=' private-key <(echo "$PrivateKey")'
  wgcmd+=' peer "$PublicKey"'
  wgcmd+=' allowed-ips "$AllowedIPs"'
  wgcmd+=' endpoint "$Endpoint"'
  [[ $PresharedKey ]] && wgcmd+=' preshared-key <(echo "$PresharedKey")'
  [[ $PersistentKeepalive ]] && wgcmd+=' persistent-keepalive "$PersistentKeepalive"'
  eval $wgcmd || {
    error "Failed to configure WireGuard interface '$DEV' using command:"
    wgcmd=${wgcmd/\$PrivateKey/<HIDDEN>}
    eval $'cat <<EOF\n'$wgcmd$'\nEOF'
    error " " fatal
  }

  $use_namespace && {
    # Create and configure namespace
    ip netns add $NAMESPACE || error "Failed to create namespace '$NAMESPACE'" fatal
    ip link set $DEV netns $NAMESPACE || error "Failed to move interface '$DEV' to namespace '$NAMESPACE'" fatal
    $NSCMD ip link set lo up || error "Failed to bring up loopback interface in namespace '$NAMESPACE'" fatal
  }

  $NSCMD ip addr add "$Address" dev $DEV || error "Failed to configure address '$Address' for interface '$DEV'" fatal
  [[ $MTU ]] && {
    $NSCMD ip link set $DEV mtu $MTU || error "Failed to configure MTU '$MTU' for interface '$DEV'" fatal
  }
  $NSCMD ip link set $DEV up || error "Failed to bring up interface '$DEV' with address '$Address'" fatal

  # (let trap catch some fatal errors and report failed command)

  if $use_namespace; then
    # Add default route
    $NSCMD ip route add default dev $DEV
    # Configure DNS
    if mkdir -p /etc/netns/$NAMESPACE; then
      for k in $DNS; do
        if validate_ipv4 "$k"; then
          echo "nameserver $k"
        else
          warn "Skipping invalid DNS server '$k'"
        fi
      done > /etc/netns/$NAMESPACE/resolv.conf
    else
      error "Cannot create directory /etc/netns/$NAMESPACE"
    fi
    # Check if we have at least one DNS server
    if [[ ! -s /etc/netns/$NAMESPACE/resolv.conf ]]; then
      warn "No valid DNS servers configured"
    fi
  else
    # Add a "split tunnel route" if wanted
    $split_tunnel_route && q=($(ip route get ${Endpoint%%:*} 2>/dev/null)) && {
      # Add specific route to protect WireGuard UDP Stateless Tunnel to Endpoint
      ip route replace ${q[@]:0:3}
      ip route add 0/1 dev $DEV
      ip route add 128/1 dev $DEV
    }
    # Add default route valid only for source $Address (policy routing)
    for k in {1..251}; do
      [[ $(ip -4 route show table $k 2>/dev/null) ]] || break
    done
    ((k >= 251)) && error "Cannot find an empty routing table in the range 1..250" fatal
    ip -4 route add default dev $DEV table $k
    ip -4 rule add from ${Address%/*} table $k
    # Configure DNS
    q=
    for k in $DNS; do
      if validate_ipv4 "$k"; then
        q+="nameserver $k"$'\n'
      else
        warn "Skipping invalid DNS server '$k'"
      fi
    done
    [[ $q ]] && echo "$q" | resolvconf -a $DEV -x || \
      warn "DNS configuration failed.
            Ensure 'openresolv' is properly installed and configured."
  fi

  pop_cleanup clean_vpn

  echo "$Y VPN connected successfully"
  echo
  $NSCMD wg show $DEV
  echo
  $use_namespace && {
    echo "Network namespace: $NAMESPACE"
    echo
  }
  echo "Interface details:"
  $NSCMD ip -c addr show $DEV
  echo
  if $use_namespace; then
    echo "Routes:"
    $NSCMD ip -c route show
    echo
    echo "DNS:"
    grep -E --color '([0-9]{1,3}\.){3}[0-9]{1,3}' \
      /etc/netns/$NAMESPACE/resolv.conf 2>/dev/null || echo "  (none)"
    echo
    echo "To run commands in the VPN namespace:"
    echo "  wgc exec $NAMESPACE <command>"
    echo "  Example: wgc exec $NAMESPACE curl ipinfo.io"
  else
    echo "Routes:"
    ip route show | grep -F --color $DEV || echo "  (none)"
    echo
    echo "Rules:"
    ip rule list from ${Address%/*} | grep -F --color "from ${Address%/*}" || echo "  (none)"
    while read -r q q q q t; do
      echo
      echo "Routing table $t:"
      ip -c route show table $t
    done < <(ip rule list from ${Address%/*})
    echo
    echo "DNS:"
    resolvconf -l $DEV || true
  fi
}

validate_vpn_name() {
  [[ $DEV =~ ^[a-zA-Z0-9_-]+$ ]] || \
    error "Invalid VPN name '$DEV'. Use only alphanumeric, dash, underscore" fatal blameparent
}

# -----------------------------------------------------------------------------

# Stack for cleanup functions
declare -a CLEANUP_STACK=()

# Add cleanup function to stack top
push_cleanup() {
  local func_name="$1"
  CLEANUP_STACK+=($func_name)
}

# Remove cleanup function from stack top
pop_cleanup() {
  local func_name=$1 # must declare function to pop, to avoid forgetting pops
  local last_idx=$((${#CLEANUP_STACK[@]} - 1))
  [[ "$func_name" ]] || error "BUG: pop_cleanup called without function name" fatal blameparent
  [[ $last_idx -lt 0 ]] && error "BUG: Cannot pop '$func_name' from empty stack!" fatal blameparent
  local last_pushed="${CLEANUP_STACK[$last_idx]}"
  # function to pop must match last pushed function
  if [[ "$func_name" != "$last_pushed" ]]; then
    error "BUG: expected pop of '$last_pushed', but got '$func_name'" fatal blameparent
  fi
  unset "CLEANUP_STACK[$last_idx]" # pop
}

# Error handler. Supports:
# - Error messages with line numbers
# - blameparent: Reports caller's line number instead
# - Flexible error reporting (soft vs fatal)
# - fatal: Triggers cleanup stack unwinding and exits
# - Graceful cleanup even when cleanup functions fail
# - Multi-line message support (using %% or actual newlines)
error() {
  local exit_code=$?

  local original_trap=$(trap -p ERR)
  local original_opts=$-
  trap - ERR; set +e

  local msg=$1

  local arg= fatal=false blameparent=false line=${BASH_LINENO[0]}
  for arg in "${@:2}"; do
    case $arg in
      fatal) fatal=true ;;
      blameparent ) blameparent=true ;;
      *) echo "WARNING: Unknown error flag '$arg' at line $line" >&2 ;; # Debug safe
    esac
  done

  $blameparent && line=${BASH_LINENO[1]}

  case "$msg" in
    "")
      ;;
    TRAP)
      echo "${X}ERROR @$line: Command '$BASH_COMMAND' failed with exit code $exit_code" >&2
      show_traceback >&2
      fatal=true
      ;;
    *)
      indent_multiline msg
      echo "${X}ERROR +$line: $msg" >&2
      ;;
  esac

  if $fatal; then
    # unwind of CLEANUP_STACK
    local k=
    for (( k=${#CLEANUP_STACK[@]}-1; k>=0; k-- )); do
      local clean_func=${CLEANUP_STACK[$k]}
      if declare -F "$clean_func" >/dev/null; then
        echo "  [$k] Calling: $clean_func" >&2
        $clean_func || echo "      (Warning: '$clean_func' failed, continuing...)" >&2
      else
        echo "  [$k] Error: Function '$clean_func' not defined" >&2
      fi
    done
    echo "Aborted." >&2
    exit 1
  fi

  [[ $original_trap ]] && eval "$original_trap"
  [[ $original_opts == *e* ]] && set -e
  return 0 # allow to use error() as soft error handler without adding ||true to avoid trap ERR and recursion
}

show_traceback() {
  echo "  Traceback:"
  local i= len=
  for (( i=2, len=${#FUNCNAME[@]}; i<len; i++ )); do
    echo "    [$((len-i))] ${FUNCNAME[$i]}:${BASH_LINENO[$((i-1))]}"
  done
}

warn() {
  local msg=$1
  indent_multiline msg
  echo "$W Warning: $msg" >&2
}

indent_multiline() {
  local -n _ref=$1
  # %% or newline means: newline and indent 2
  #_ref=$(sed -z -E 's/[[:blank:]]*(%%|\n)[[:blank:]]*/\n  /g' <<< "${_ref}")
  _ref=$(printf %s "${_ref}" | sed -z -E 's/[[:blank:]]*(%%|\n)[[:blank:]]*/\n  /g')
}

# -----------------------------------------------------------------------------
[[ $1 == trace ]] && { set -x; shift; }

CMD=${1:-}
DEV=${2:-}

[[ $UID == 0 ]] || exec sudo WGC_CFGDIR="$WGC_CFGDIR" "$0" "$@"

set -e
set -u          # Treat unset variables as an error.
set -o pipefail # Return value of a pipeline is the status of the last command to exit with a non-zero status.
set -o errtrace # Trap ERR is inherited by functions.
shopt -s extglob # Enable extended glob patterns: x(y)
unset IFS

NAMESPACE=$DEV
declare -r CMD DEV NAMESPACE

set_markers
trap 'error TRAP fatal' ERR

case "$CMD" in
  up)
    start_vpn
    ;;
  upd)
    start_vpn split_tunnel_route
    ;;
  n|nu|nup)
    start_vpn use_namespace
    ;;
  d|do|dow|down)
    stop_vpn ${3:-} # can be "force"
    ;;
  s|st|sta|stat|statu|status)
    show_status
    ;;
  a|ac|act|acti|activ|active)
    show_active_vpns
    ;;
  l|li|lis|list)
    list_config_files
    ;;
  e|ex|exe|exec)
    shift 2
    exec_in_namespace "$@"
    ;;
  check)
    check_dependencies
    ;;
  completion)
    enable_completion
    ;;
  openresolv)
    install_forced_openresolv
    ;;
  remopenresolv)
    remove_openresolv
    ;;
  *)
    show_usage
    ;;
esac
